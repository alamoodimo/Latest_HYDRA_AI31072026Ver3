  "JwtSettings": {
    "SecretKey": "Replace_with_your_own_secret",
    "Issuer": "HydraAI",
    "Audience": "HydraAI",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7,
    "RememberMeExpiryDays": 30,
    "ValidateLifetime": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ClockSkewMinutes": 2,
    "RequireHttps": false
  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "UseSsl": true,
    "UseStartTls": true,
    "FromEmail": "noreply@hydra-ai.com",
    "FromName": "Hydra AI",
    "ReplyToEmail": "support@hydra-ai.com",
    "ApplicationUrl": "https://localhost:7001",
    "IsEnabled": true,
    "VerificationCodeExpiryMinutes": 15,
    "PasswordResetTokenExpiryHours": 24,
    "MaxEmailsPerHour": 100,
    "LogEmailContent": false,
    "TestMode": false,
    "TestModeRecipient": "",
    "SupportEmail": "support@hydra-ai.com",
    "LogoUrl": "",
    "PrimaryColor": "#0ea5e9",
    "SecondaryColor": "#38bdf8"
  },

  "AuthSettings": {
    "MaxLoginAttempts": 5,
    "LockoutDurationHours": 24,
    "PasswordMinLength": 6,
    "RequireLetterAndNumber": true,
    "SessionDurationHours": 24,
    "Enable2FA": false
  },

  "SchemaAnalysis": {
    "Sequential": {
      "Enabled": true,
      "TimeoutMinutes": 30,
      "AutoProceed": true
    },

    "DomainGrouping": {
      "MaxTablesPerDomain": 20,
      "MaxDomainsTotal": 50
    },

    "Batching": {
      "MaxTablesPerBatch": 5,
      "IncludeSharedTablesInBatch": true
    },

    "Descriptions": {
      "MaxTableDescriptionLength": 150,
      "MaxColumnDescriptionLength": 100,
      "MaxDomainDescriptionLength": 100,
      "MaxRelationshipReasonLength": 100
    },

    "SampleData": {
      "Enabled": true,
      "RowsPerTable": 2,
      "OnlyForRequestedColumns": true,
      "AnonymizeSensitiveData": true,
      "MaxDistinctValuesForValueSet": 20,
      "CandidateColumnPatterns": [ "Status", "Type", "Category", "Code", "Kind", "Class", "Flag" ],
      "IgnoreEmptyTable": true
    },

    "ReviewSettings": {
      "AutoAcceptIfNoIssues": true,
      "ShowConfidenceScores": false
    },

    "ErrorRecovery": {
      "SaveIntermediateResults": true,
      "AllowPartialCompletion": true,
      "MaxRetries": 2
    }
  },


  "DashboardBuilder": {
    "Provider": "claude",
    "Model": "claude-sonnet-4-20250514",
    "MaxTokens": 4000,
    "Temperature": 0.5,
    "TimeoutSeconds": 60
