      "id": "executive-standard",
      "name": "Executive Dashboard",
      "description": "Strategic overview for C-level executives with high-level KPIs, trends, and summary insights",
      "category": "Executive",
      "thumbnailUrl": "/images/templates/executive-standard.png",
      "totalHeight": 15,
      "aiGuidance": {
        "targetAudience": "C-level executives, board members, senior leadership who need strategic overview without operational details",
        "focusAreas": [
          "Overall business performance and totals",
          "Growth rates and percentages",
          "Trend analysis (monthly/quarterly)",
          "Top performers and rankings",
          "Summary distributions",
          "Key performance indicators"
        ],
        "timeGranularity": [
          "monthly",
          "quarterly",
          "yearly"
        ],
        "avoidPatterns": [
