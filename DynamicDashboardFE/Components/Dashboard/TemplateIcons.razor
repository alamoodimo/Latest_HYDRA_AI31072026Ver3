@* ============================================================================
   TEMPLATE ICONS COMPONENT
   Provides beautiful SVG icons for each dashboard template type
   ============================================================================ *@

@code {
    /// <summary>
    /// Returns SVG icon markup for a given template category/id
    /// </summary>
    public static MarkupString GetTemplateIcon(string templateId, string category)
    {
        var iconSvg = (templateId?.ToLower(), category?.ToLower()) switch
        {
            ("executive-standard", _) or (_, "executive") => ExecutiveIcon,
            ("operational-dashboard", _) or (_, "operations") => OperationalIcon,
            ("financial-dashboard", _) or (_, "finance") => FinancialIcon,
            ("analytics-dashboard", _) or (_, "analytics") => AnalyticsIcon,
            ("performance-dashboard", _) or (_, "performance") => PerformanceIcon,
            ("sales-dashboard", _) or (_, "sales") => SalesIcon,
            ("simple-overview", _) or (_, "basic") => SimpleOverviewIcon,
            ("detailed-analysis", _) => DetailedAnalysisIcon,
            _ => DefaultIcon
        };

        return new MarkupString(iconSvg);
    }

