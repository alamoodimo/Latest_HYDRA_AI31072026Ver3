    private void InferColumnTypes()
    {
        _numericColumns.Clear();
        _categoryColumns.Clear();
        _dateColumns.Clear();

        if (!_currentData.Any())
            return;

        var sample = _currentData.First();

        foreach (var key in sample.Keys)
        {
            var allValues = _currentData.Select(d => d[key]);

            // Check if values are numeric
            if (allValues.All(v => v == null || double.TryParse(v.ToString(), out _)))
            {
                _numericColumns.Add(key);
                continue;
            }

            // Check if values are dates
            if (allValues.All(v => v == null || DateTime.TryParse(v.ToString(), out _)))
            {
                _dateColumns.Add(key);
                continue;
            }

            // Check if it's categorical
            if (allValues.Where(v => v != null).Select(v => v.ToString()).Distinct().Count() <= 20)
            {
                _categoryColumns.Add(key);
                continue;
            }
        }
    }

