@page "/story-canvas"
@using System.Text.Json

@inject HttpClient Http;
@inject IJSRuntime JSRuntime;
@inject IToastService ToastService;
@implements IDisposable;

<div class="story-container">
    <header class="story-header">
        <h1><i class="fas fa-chart-line"></i> Data Storytelling Canvas</h1>
        <div class="story-controls">
            <button class="btn btn-primary green" @onclick="StartPresentation">
                <i class="fas fa-play"></i> Start Presentation
            </button>
            <button class="btn btn-primary green" @onclick="GenerateAIInsights">
                <i class="fas fa-lightbulb"></i> Generate AI Insights
            </button>
            <button class="btn btn-outline-secondary" @onclick="SaveStory">
                <i class="fas fa-save"></i> Save Story
            </button>
        </div>
    </header>

    <main>
        <div class="palette">
            <h2><i class="fas fa-palette"></i> Visualization Palette</h2>
            @foreach (var vizType in AvailableVisualizations)
            {
                <div class="viz-item @(DraggedVizType == vizType.Type ? "dragging" : "")"
                     draggable="true"
                     @ondragstart="@(e => HandleDragStart(e, vizType.Type))"
                     @key="vizType.Type"
                     data-viz-type="@vizType.Type">
                    <h3><i class="@vizType.Icon"></i> @vizType.Name</h3>
                    <div class="viz-preview">
                        @((MarkupString)vizType.PreviewSvg)
                    </div>
                </div>
            }
        </div>

        <div class="canvas">
            <div class="canvas-header">
                <h2><i class="fas fa-paint-brush"></i> Canvas</h2>
                <div class="canvas-actions">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowTitleDialog = true">
                        <i class="fas fa-heading"></i> Edit Story Title
                    </button>
                </div>
            </div>
            <div class="scene-tabs">
                @foreach (var scene in Scenes)
                {
                    <div class="scene-tab @(CurrentScene == scene.Id ? "active" : "")"
                    @onclick="() => SwitchScene(scene.Id)">
                        <i class="@scene.Icon"></i> @scene.Name
                    </div>
                }
                <div class="scene-tab add-scene" @onclick="AddNewScene">
                    <i class="fas fa-plus"></i> Add Scene
                </div>
            </div>
            <div class="canvas-content">
                @for (int i = 0; i < 4; i++)
                {
                    int position = i;
                    <div class="dropzone @(HighlightedDropzone == position ? "highlight" : "")"
                    data-position="@position"
                    @ondragover:preventDefault
                    @ondragover="() => HandleDragOver(position)"
                    @ondragleave="() => HandleDragLeave(position)"
                    @ondrop:preventDefault
                    @ondrop="() => HandleDrop(position)">

                        @if (GetVisualizationAtPosition(position) == null)
                        {
                            <div class="viz-placeholder">
                                <i class="fas fa-plus-circle"></i>
                                Drag a visualization here
                            </div>
                        }
                        else
                        {
                            var viz = GetVisualizationAtPosition(position);
                            <div class="canvas-viz" id="@viz.Id">
                                <div class="viz-header">
                                    <h3>@viz.Title</h3>
                                    <div class="viz-actions">
                                        <button @onclick="() => EditVisualization(viz.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button @onclick="() => RemoveVisualization(viz.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="viz-content" id="@($"viz-content-{viz.Id}")"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="insights">
            <h2><i class="fas fa-lightbulb"></i> AI Insights</h2>
            @foreach (var insight in Insights)
            {
                <div class="insight-card @(insight.IsSuggestion ? "suggestion" : "")"
                @onclick="() => ApplyInsight(insight)">
                    <h3><i class="@insight.Icon"></i> @insight.Type</h3>
                    <p>@insight.Description</p>
                </div>
            }
        </div>
    </main>
</div>

<!-- Presentation Mode -->
<div class="presentation-mode @(IsPresentationMode ? "active" : "")">
    <button class="presentation-close" @onclick="EndPresentation">
        <i class="fas fa-times"></i>
    </button>
    <div class="presentation-content">
        @foreach (var scene in PresentationSlides)
        {
            <div class="presentation-slide @(CurrentSlide == scene.SlideIndex ? "active" : scene.SlideIndex < CurrentSlide ? "prev" : "")"
            data-slide="@scene.Id">
                <h2>@scene.Title</h2>
                <p>@scene.Description</p>
                <div class="presentation-viz" id="@($"presentation-viz-{scene.SlideIndex}")"></div>
            </div>
        }
    </div>
    <div class="presentation-controls">
        <button id="prev-slide" @onclick="PrevSlide">
            <i class="fas fa-chevron-left"></i>
        </button>
        <button id="next-slide" @onclick="NextSlide">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
    <div class="presentation-progress">
        <div class="presentation-progress-bar" style="width: @ProgressPercentage%"></div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" style="display: @(IsLoading ? "flex" : "none")">
    <div class="loading-spinner"></div>
    <div class="loading-message">@LoadingMessage</div>
</div>

<!-- AI Thinking Indicator -->
<div class="ai-thinking @(IsAIThinking ? "show" : "")">
    <div class="ai-thinking-icon">
        <i class="fas fa-robot"></i>
    </div>
    <div class="ai-thinking-content">
        <p>AI analyzing your data...</p>
        <div class="ai-thinking-dots">
            <div class="ai-thinking-dot"></div>
            <div class="ai-thinking-dot"></div>
            <div class="ai-thinking-dot"></div>
        </div>
    </div>
</div>

<!-- Title Dialog -->
@if (ShowTitleDialog)
{
    <div class="modal-backdrop" @onclick="() => ShowTitleDialog = false"></div>
    <div class="title-dialog">
        <div class="dialog-header">
            <h3>Story Title</h3>
            <button @onclick="() => ShowTitleDialog = false">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="dialog-body">
            <div class="form-group">
                <label for="story-title">Enter a title for your data story:</label>
                <input type="text" class="form-control" id="story-title"
                @bind="StoryTitle" placeholder="e.g., Q2 Sales Analysis" />
            </div>
        </div>
        <div class="dialog-footer">
            <button class="btn btn-secondary" @onclick="() => ShowTitleDialog = false">
                Cancel
            </button>
            <button class="btn btn-primary green" @onclick="SaveTitle">
                Save
            </button>
        </div>
    </div>
}

<!-- Edit Visualization Dialog -->
@if (ShowVizEditDialog && SelectedVisualization != null)
{
    <div class="modal-backdrop" @onclick="() => ShowVizEditDialog = false"></div>
    <div class="viz-edit-dialog">
        <div class="dialog-header">
            <h3>Edit Visualization</h3>
            <button @onclick="() => ShowVizEditDialog = false">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="dialog-body">
            <div class="form-group">
                <label for="viz-title">Title:</label>
                <input type="text" class="form-control" id="viz-title"
                @bind="SelectedVisualization.Title" />
            </div>

            <div class="form-group">
                <label>Chart Type:</label>
                <div class="chart-type-selector">
                    @foreach (var vizType in AvailableVisualizations)
                    {
                        <div class="chart-type-option @(SelectedVisualization.Type == vizType.Type ? "selected" : "")"
                        @onclick="() => SelectedVisualization.Type = vizType.Type">
                            <i class="@vizType.Icon"></i>
                            <span>@vizType.Name</span>
                        </div>
                    }
                </div>
            </div>

            <div class="form-group">
                <label>Data Options:</label>
                <div class="data-options">
                    <!-- Data options will vary based on visualization type -->
                    @if (SelectedVisualization.Type == "bar" || SelectedVisualization.Type == "line")
                    {
                        <div class="form-group">
                            <label>X-Axis:</label>
                            <select class="form-control" @bind="SelectedVisualization.XAxis">
                                @foreach (var column in AvailableDataColumns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Y-Axis:</label>
                            <select class="form-control" @bind="SelectedVisualization.YAxis">
                                @foreach (var column in AvailableDataColumns.Where(c => NumericColumns.Contains(c)))
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                    }
                    @if (SelectedVisualization.Type == "pie")
                    {
                        <div class="form-group">
                            <label>Category:</label>
                            <select class="form-control" @bind="SelectedVisualization.Category">
                                @foreach (var column in AvailableDataColumns)
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Value:</label>
                            <select class="form-control" @bind="SelectedVisualization.Value">
                                @foreach (var column in AvailableDataColumns.Where(c => NumericColumns.Contains(c)))
                                {
                                    <option value="@column">@column</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="dialog-footer">
            <button class="btn btn-secondary" @onclick="() => ShowVizEditDialog = false">
                Cancel
            </button>
            <button class="btn btn-primary green" @onclick="SaveVisualizationChanges">
                Save Changes
            </button>
        </div>
    </div>
}

