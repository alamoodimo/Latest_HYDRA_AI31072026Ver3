    [JSInvokable]
    public void HandleKeyDown(string key)
    {
        if (IsPresentationMode)
        {
            if (key == "ArrowRight" || key == " ")
            {
                _ = NextSlide();
            }
            else if (key == "ArrowLeft")
            {
                _ = PrevSlide();
            }
            else if (key == "Escape")
            {
                EndPresentation();
            }

            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        try
        {
            // Stop and dispose timer
            if (_insightAnimationTimer != null)
            {
                _insightAnimationTimer.Stop();
                _insightAnimationTimer.Elapsed -= async (s, e) => await AnimateRandomInsight();
                _insightAnimationTimer.Dispose();
            }

            // Clean up charts if possible
            if (_jsInitialized)
            {
                Task.Run(async () =>
                {
                    try
                    {
                        foreach (var viz in _visualizations)
                        {
                            await JSRuntime.InvokeVoidAsync("storyCanvas.cleanupChart", viz.Id);
                        }
                    }
                    catch
                    {
                        // Ignore errors during cleanup
                    }
                }).Wait(500); // Give it a short time to complete
            }

            // Dispose .NET object reference
            _objRef?.Dispose();
        }
        catch
        {
            // Suppress exceptions in Dispose
        }
    }

