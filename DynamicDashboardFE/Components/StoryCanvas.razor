    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Initialize object reference
            _objRef = DotNetObjectReference.Create(this);

            // Initialize with default scenes
            _scenes.Add(new StoryScene { Id = "intro", Name = "Introduction", Icon = "fas fa-door-open" });
            _scenes.Add(new StoryScene { Id = "analysis", Name = "Analysis", Icon = "fas fa-chart-column" });
            _scenes.Add(new StoryScene { Id = "insights", Name = "Insights", Icon = "fas fa-lightbulb" });
            _scenes.Add(new StoryScene { Id = "conclusion", Name = "Conclusion", Icon = "fas fa-flag-checkered" });

            // Initialize sample insights
            InitializeSampleInsights();

            // Initialize presentation slides
            InitializePresentationSlides();

            // Set up animation timer
            _insightAnimationTimer = new System.Timers.Timer(8000);
            _insightAnimationTimer.Elapsed += async (s, e) => await AnimateRandomInsight();
            _insightAnimationTimer.AutoReset = true;
            _insightAnimationTimer.Start();

            // Load sample data
            await LoadSampleData();
        }
        catch (Exception ex)
        { 
            IsLoading = false;
            LoadingMessage = "Error initializing: " + ex.Message;
            ToastService.ShowError("Error initializing the visualization component.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Check if JS is available
                var jsAvailable = await JSRuntime.InvokeAsync<bool>("eval", "typeof window.storyCanvas !== 'undefined'");

                if (!jsAvailable)
                {
                    IsLoading = false;
                    LoadingMessage = "JavaScript library not loaded. Please refresh the page.";
                    ToastService.ShowError("Failed to load visualization libraries.");
                    return;
                }

                // Initialize the JavaScript interop
                await JSRuntime.InvokeVoidAsync("storyCanvas.initialize", _objRef);
                _jsInitialized = true;

                // Set animation preferences based on user settings or device capability
                await JSRuntime.InvokeVoidAsync("storyCanvas.setAnimationsEnabled", EnableAnimations);

                // Add a small delay to simulate loading
                await Task.Delay(1500);

                // Hide the loading overlay with animation
                await JSRuntime.InvokeVoidAsync("storyCanvas.hideLoadingOverlay");
                IsLoading = false;

                // Animate the initial elements
                await JSRuntime.InvokeVoidAsync("storyCanvas.animateInitialElements");
            }
            catch (Exception ex)
            {
                _jsInitialized = false;
                IsLoading = false;
                LoadingMessage = "Error initializing: " + ex.Message;
                ToastService.ShowError("Failed to initialize visualization component.");
                Console.Error.WriteLine($"StoryCanvas initialization error: {ex.Message}");
            }
        }

        // Only try to render visualizations if JS is initialized
        if (_jsInitialized && Visualizations.Any())
        {
            try
            {
                foreach (var viz in Visualizations.Where(v => v.SceneId == CurrentScene))
                {
                    await RenderVisualization(viz);
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"Error rendering visualizations: {ex.Message}");
            }
        }
    }

