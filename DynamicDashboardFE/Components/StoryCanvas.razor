    // Drag and drop handlers
    private void HandleDragStart(DragEventArgs e, string vizType)
    {
        Console.WriteLine($"Drag started: {vizType}");
        DraggedVizType = vizType;
        StateHasChanged();
    }

    private void HandleDragOver(int position)
    {
        if (HighlightedDropzone != position)
        {
            HighlightedDropzone = position;
            StateHasChanged();
        }
    }

    private void HandleDragLeave(int position)
    {
        if (HighlightedDropzone == position)
        {
            HighlightedDropzone = -1;
            StateHasChanged();
        }
    }

    private async Task HandleDrop(int position)
    {
        Console.WriteLine($"Drop: {DraggedVizType} at position {position}");

        if (string.IsNullOrEmpty(DraggedVizType))
        {
            Console.WriteLine("No visualization type dragged - returning");
            return;
        }

        try
        {
            // Create visualization
            var viz = new Visualization
                {
                    Id = $"viz-{++_visualizationCounter}",
                    Type = DraggedVizType,
                    SceneId = CurrentScene,
                    Position = position,
                    Title = GetDefaultTitle(DraggedVizType)
                };

            // Set default axes based on data
            if (_numericColumns.Any() && AvailableDataColumns.Any())
            {
                if (DraggedVizType == "bar" || DraggedVizType == "line")
                {
                    viz.XAxis = _categoryColumns.FirstOrDefault() ?? AvailableDataColumns.First();
                    viz.YAxis = _numericColumns.FirstOrDefault() ?? AvailableDataColumns.First();
                }
                else if (DraggedVizType == "pie")
                {
                    viz.Category = _categoryColumns.FirstOrDefault() ?? AvailableDataColumns.First();
                    viz.Value = _numericColumns.FirstOrDefault() ?? AvailableDataColumns.First();
                }
                // Add default axis settings for other chart types
            }

            // Remove existing visualization at this position in this scene
            var existingViz = _visualizations.FirstOrDefault(v => v.SceneId == CurrentScene && v.Position == position);
            if (existingViz != null)
            {
                _visualizations.Remove(existingViz);
                await JSRuntime.InvokeVoidAsync("storyCanvas.cleanupChart", existingViz.Id);
            }

            // Add the new visualization
            _visualizations.Add(viz);
            Console.WriteLine($"Added visualization: {viz.Id}, Type: {viz.Type}, Position: {viz.Position}");

            // Reset drag state
            DraggedVizType = string.Empty;
            HighlightedDropzone = -1;

            // Refresh UI first
            StateHasChanged();

            // Render the visualization after the UI updates
            await Task.Delay(100); // Slightly longer delay to ensure DOM is updated

            Console.WriteLine($"Rendering visualization {viz.Id} of type {viz.Type}");
            var dataJson = JsonSerializer.Serialize(_currentData);
            var configJson = JsonSerializer.Serialize(viz);

            await JSRuntime.InvokeVoidAsync("storyCanvas.renderVisualization", viz.Id, viz.Type, dataJson, configJson);

            // Animate the new visualization
            await JSRuntime.InvokeVoidAsync("storyCanvas.animateNewVisualization", viz.Id);

            Console.WriteLine("Visualization rendering complete");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in HandleDrop: {ex.Message}");
            // Display error to user
            ToastService.ShowError($"Error adding visualization: {ex.Message}");
        }
    }



    private string GetDefaultTitle(string vizType)
    {
        return vizType switch
        {
            "bar" => "Bar Chart",
            "line" => "Line Chart",
            "pie" => "Pie Chart",
            "scatter" => "Scatter Plot",
            "map" => "Map Visualization",
            "text" => "Text Block",
            "heatmap" => "Heat Map",
            "gauge" => "Gauge Chart",
            _ => "Visualization"
        };
    }

    private async Task RenderVisualization(Visualization viz)
    {
        if (!_jsInitialized)
            return;

        try
        {
            // Serialize data and visualization config
            var dataJson = JsonSerializer.Serialize(_currentData);
            var vizConfig = JsonSerializer.Serialize(viz);

            // Render visualization on the client
            await JSRuntime.InvokeVoidAsync("storyCanvas.renderVisualization", viz.Id, viz.Type, dataJson, vizConfig);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error rendering visualization {viz.Id}: {ex.Message}");
            // Don't show toast for every visualization to avoid UI clutter
        }
    }

    // Scene management
    private void SwitchScene(string sceneId)
    {
        CurrentScene = sceneId;

        // Re-render current scene's visualizations
        _ = Task.Run(async () =>
        {
            await Task.Delay(10); // Small delay to allow UI to update
            await InvokeAsync(StateHasChanged);

            // Re-render visualizations
            foreach (var viz in Visualizations.Where(v => v.SceneId == CurrentScene))
            {
                await RenderVisualization(viz);
            }
        });
    }

