    private async Task NextSlide()
    {
        if (CurrentSlide >= PresentationSlides.Count - 1)
            return;

        await JSRuntime.InvokeVoidAsync("storyCanvas.transitionToNextSlide");
        CurrentSlide++;

        // Render current slide
        var slideData = _currentData;
        var slideDataJson = JsonSerializer.Serialize(slideData);

        await JSRuntime.InvokeVoidAsync("storyCanvas.renderPresentationSlide", CurrentSlide, slideDataJson);
    }

    private async Task PrevSlide()
    {
        if (CurrentSlide <= 0)
            return;

        await JSRuntime.InvokeVoidAsync("storyCanvas.transitionToPrevSlide");
        CurrentSlide--;

        // Render current slide
        var slideData = _currentData;
        var slideDataJson = JsonSerializer.Serialize(slideData);

        await JSRuntime.InvokeVoidAsync("storyCanvas.renderPresentationSlide", CurrentSlide, slideDataJson);
    }

