																	</thead>
																	<tbody>
																		@foreach (var item in conflict.Items)
																		{
																			<tr>
																				<td>@item.Name</td>
																				@if (conflict.Type == "Column")
																				{
																					<td>@item.TableName</td>
																				}
																				<td>@item.SuggestedResolution</td>
																				<td>
																					<button class="btn btn-sm btn-primary"
																							@onclick="() => ApplyConflictResolution(conflict.Type, item)">
																						<i class="fas fa-check me-1"></i> Apply
																					</button>
																				</td>
																			</tr>
																		}
																	</tbody>
																</table>
															</div>
														</div>
													</div>
												}
											}
										</div>
									}
								</div>
							}
						</div>
					</div>
				}
				else if (activeTab == "termMappings")
				{
					<div class="card shadow-sm">
						<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
							<h5 class="mb-0">
								<i class="fas fa-language me-2"></i>
								Business Term Mappings
							</h5>
							<div class="d-flex">
								<button class="btn btn-success me-2" @onclick="SaveAllTermSuggestions">
									<i class="fas fa-check-double me-2"></i>
									<span>Accept All Suggestions</span>
								</button>
								<button class="btn btn-primary green me-2" @onclick="SuggestTermMappings" disabled="@isSuggestingTerms">
									@if (isSuggestingTerms)
									{
										<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
										<span>Generating Suggestions...</span>
									}
									else
									{
										<i class="fas fa-magic me-2"></i>
										<span>Suggest Terms</span>
									}
								</button>
								<button class="btn btn-outline-primary" @onclick="CreateNewTermMapping">
									<i class="fas fa-plus me-2"></i>
									Add Manually
								</button>
							</div>
						</div>
						<div class="card-body">
							<!-- Term mapping filtering options -->
							<div class="row mb-3">
								<div class="col-md-8">
									<div class="input-group">
										<span class="input-group-text bg-light border-light">
											<i class="fas fa-search text-muted"></i>
										</span>
										<input type="text" class="form-control border-light" placeholder="Search terms..."
											   @bind="termSearchTerm" @bind:event="oninput" />
										@if (!string.IsNullOrEmpty(termSearchTerm))
										{
											<button class="btn btn-outline-secondary border-light" @onclick="() => termSearchTerm = string.Empty">
												<i class="fas fa-times"></i>
											</button>
										}
									</div>
								</div>
								<div class="col-md-4">
									<select class="form-select" @bind="termTypeFilter">
										<option value="all">All Term Types</option>
										<option value="DirectColumn">Direct Columns</option>
										<option value="CalculatedField">Calculated Fields</option>
										<option value="Aggregate">Aggregates</option>
										<option value="FilterCondition">Filter Conditions</option>
									</select>
								</div>
							</div>

							<!-- Term mapping table -->
							<div class="table-responsive">
								<table class="table table-striped table-hover">
									<thead class="table-light">
										<tr>
											<th>Business Term</th>
											<th>Type</th>
											<th>Description</th>
											<th>Mapped To</th>
											<th>Synonyms</th>
											<th>Actions</th>
										</tr>
									</thead>
									<tbody>
										@if (FilteredTermMappings.Any())
										{
											@foreach (var term in FilteredTermMappings)
											{
												<tr class="@(!term.IsActive ? "table-secondary" : "")">
													<td>
														@if (term.IsLLMSuggested)
														{
															<i class="fas fa-magic text-primary me-2" title="AI-suggested term"></i>

																<span class="badge bg-warning text-dark">Suggested</span>
														}
														@term.BusinessTerm
													</td>
													<td>
														<span class="badge @GetTermTypeBadgeClass(term.Type)">
															@GetTermTypeDisplay(term.Type)
														</span>
													</td>
													<td>@term.Description</td>
													<td>
														@if (term.Type == TermMappingType.DirectColumn)
														{
															var table = schemaObj.Tables.FirstOrDefault(t => t.ID == term.TableId);
															var column = table?.Columns?.FirstOrDefault(c => c.ID == term.ColumnId);

															if (table != null && column != null)
															{
																<span>@table.DBName.@column.DBName</span>
															}
														}
														else if (term.Type == TermMappingType.CalculatedField && !string.IsNullOrEmpty(term.Formula))
														{
															<button class="btn btn-sm btn-outline-info" @onclick="() => ShowFormulaViewer(term)">
																<i class="fas fa-eye me-1"></i> View Formula
															</button>
														}
														else if (term.Dependencies?.Any() == true)
														{
															@foreach (var dep in term.Dependencies)
															{
																<div class="small">@dep.TableName.@dep.ColumnName</div>
															}
														}
													</td>
													<td>
														@if (term.Synonyms?.Any() == true)
														{
															<div class="d-flex flex-wrap">
																@foreach (var synonym in term.Synonyms)
																{
																	<span class="badge bg-light text-dark m-1">@synonym</span>
																}
															</div>
														}
													</td>
													<td>
														<div class="btn-group btn-group-sm">
																<button type="button" class="btn btn-outline-primary"
																		@onclick="() => EditTermMapping(term)"
																		title="Edit">
																	<i class="fas fa-edit"></i>
																</button>
																<button type="button" class="btn btn-outline-@(term.IsActive ? "danger" : "success")"
																		@onclick="() => ToggleTermMappingActive(term)"
																		title="@(term.IsActive ? "Deactivate" : "Activate")">
																	<i class="fas fa-@(term.IsActive ? "eye-slash" : "eye")"></i>
																</button>
																<button type="button" class="btn btn-outline-danger"
																		@onclick="() => DeleteTermMapping(term.ID)"
																		title="Delete">
																	<i class="fas fa-trash"></i>
																</button>
														</div>
													</td>
												</tr>
											}
										}
										else
										{
											<tr>
												<td colspan="6" class="text-center py-3">
													<i class="fas fa-info-circle me-2"></i>
													No term mappings available. Click "Suggest Terms" to generate AI suggestions.
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
</div>

<!-- Column Synonyms Modal -->
<div class="modal fade @(isColumnSynonymsModalOpen ? "show" : "")" tabindex="-1"
	 style="display: @(isColumnSynonymsModalOpen ? "block" : "none")">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Column Synonyms</h5>
				<button type="button" class="btn-close" @onclick="CloseColumnSynonymsModal"></button>
			</div>
			<div class="modal-body">
				@if (editingColumnSynonyms != null)
				{
					<div class="mb-3">
						<label class="form-label">Column: @editingColumnSynonyms.DBName</label>
						<div class="input-group">
							<input type="text" class="form-control" @bind="columnSynonymsInput"
								   placeholder="Enter synonym" />
							<button class="btn btn-outline-primary" type="button" @onclick="AddColumnSynonym">
								Add
							</button>
						</div>
					</div>

					@if (editingColumnSynonyms.Synonyms?.Any() == true)
					{
						<div class="mt-3">
							<label class="form-label">Current Synonyms:</label>
							<div>
								@foreach (var synonym in editingColumnSynonyms.Synonyms)
								{
									<span class="badge bg-light text-dark me-1 mb-1 p-2">
										@synonym
										<button type="button" class="btn-close btn-close-sm ms-1"
												@onclick="() => RemoveColumnSynonym(synonym)"></button>
									</span>
								}
							</div>
						</div>
					}
					else
					{
						<div class="alert alert-info">
							<i class="fas fa-info-circle me-2"></i>
							No synonyms added yet. Synonyms help improve natural language query understanding.
						</div>
					}
				}
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" @onclick="CloseColumnSynonymsModal">Close</button>
				<button type="button" class="btn btn-outline-success" @onclick="SaveColumnSynonyms">Save Synonyms</button>
			</div>
		</div>
	</div>
</div>
<div class="modal-backdrop fade @(isColumnSynonymsModalOpen ? "show" : "")"
	 style="display: @(isColumnSynonymsModalOpen ? "block" : "none")"></div>

<!-- Column Suggestion Modal -->
<div class="modal fade @(isColumnSuggestionModalOpen ? "show" : "")" tabindex="-1"
	 style="display: @(isColumnSuggestionModalOpen ? "block" : "none")">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Column Suggestion</h5>
				<button type="button" class="btn-close" @onclick="CloseColumnSuggestionModal"></button>
			</div>
			<div class="modal-body">
				@if (selectedColumnAnalysis != null && selectedColumn != null)
				{
					<div class="mb-3">
						<label class="form-label">Database Column</label>
						<input type="text" class="form-control" value="@selectedColumn.DBName" disabled />
					</div>
					<div class="mb-3">
						<label class="form-label">Suggested Name</label>
						<input type="text" class="form-control" value="@selectedColumnAnalysis.SuggestedName" disabled />
					</div>
					<div class="mb-3">
						<label class="form-label">Suggested Description</label>
						<textarea class="form-control" rows="3" disabled>@selectedColumnAnalysis.SuggestedDescription</textarea>
					</div>
					<div class="form-check mb-3">
						<input class="form-check-input" type="checkbox" value="" disabled checked="@selectedColumnAnalysis.IsLookupColumn" />
						<label class="form-check-label">
							Suggested as Lookup Column
						</label>
					</div>
				}
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" @onclick="CloseColumnSuggestionModal">Close</button>
				<button type="button" class="btn btn-primary green" @onclick="ApplyColumnSuggestion">Apply Suggestion</button>
			</div>
		</div>
	</div>
</div>
<div class="modal-backdrop fade @(isColumnSuggestionModalOpen ? "show" : "")"
	 style="display: @(isColumnSuggestionModalOpen ? "block" : "none")"></div>

<!-- Add to the end of DynamicDashboardFE/Pages/Admin/DBMetaDataV2.razor -->
<!-- Term Mapping Editor Modal -->
<div class="modal fade @(isTermMappingModalOpen ? "show" : "")" tabindex="-1"
	 style="display: @(isTermMappingModalOpen ? "block" : "none")">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					@(editingTermMapping?.ID == null ? "Add New Term Mapping" : "Edit Term Mapping")
				</h5>
				<button type="button" class="btn-close" @onclick="() => isTermMappingModalOpen = false"></button>
			</div>
			<div class="modal-body">
				@if (editingTermMapping != null)
				{
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">Business Term</label>
							<input type="text" class="form-control" @bind="editingTermMapping.BusinessTerm"
								   placeholder="Enter business term" />
						</div>
						<div class="col-md-6">
							<label class="form-label">Type</label>
							<select class="form-select" @bind="editingTermMapping.Type">
								<option value="@TermMappingType.DirectColumn">Direct Column</option>
								<option value="@TermMappingType.CalculatedField">Calculated Field</option>
								<option value="@TermMappingType.Aggregate">Aggregate</option>
								<option value="@TermMappingType.FilterCondition">Filter Condition</option>
							</select>
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">Description</label>
						<textarea class="form-control" rows="2" @bind="editingTermMapping.Description"
								  placeholder="Enter description"></textarea>
					</div>

					@if (editingTermMapping.Type == TermMappingType.DirectColumn)
					{
						<div class="row mb-3">
							<div class="col-md-6">
								<label class="form-label">Table</label>
								<select class="form-select" @bind="editingTermMapping.TableId" @bind:after="UpdateColumnOptions">
									<option value="">-- Select Table --</option>
									@foreach (var table in schemaObj.Tables.Where(t => t.IsActive))
									{
										<option value="@table.ID">@(!string.IsNullOrEmpty(table.FriendlyName) ? table.FriendlyName : table.DBName)</option>
									}
								</select>
							</div>
							<div class="col-md-6">
								<label class="form-label">Column</label>
								<select class="form-select" @bind="editingTermMapping.ColumnId">
									<option value="">-- Select Column --</option>
									@if (!string.IsNullOrEmpty(editingTermMapping.TableId))
									{
										var table = schemaObj.Tables.FirstOrDefault(t => t.ID == editingTermMapping.TableId);
										if (table?.Columns != null)
										{
											@foreach (var column in table.Columns.Where(c => c.IsActive))
											{
												<option value="@column.ID">@(!string.IsNullOrEmpty(column.FriendlyName) ? column.FriendlyName : column.DBName)</option>
											}
										}
									}
								</select>
							</div>
						</div>
					}
					else if (editingTermMapping.Type == TermMappingType.CalculatedField)
					{
						<div class="mb-3">
							<label class="form-label">Formula</label>
							<textarea class="form-control" rows="3" @bind="editingTermMapping.Formula"
									  placeholder="Enter SQL formula"></textarea>
							<div class="form-text">
								Use column references like [Table].[Column] in your formula.
							</div>
						</div>

						<div class="mb-3">
							<label class="form-label">Dependencies</label>
							<button class="btn btn-sm btn-outline-primary" @onclick="AddDependency">
								<i class="fas fa-plus me-1"></i> Add Dependency
							</button>

							@if (editingTermMapping.Dependencies?.Any() == true)
							{
								<div class="table-responsive mt-2">
									<table class="table table-sm">
										<thead>
											<tr>
												<th>Table</th>
												<th>Column</th>
												<th></th>
											</tr>
										</thead>
										<tbody>
											@foreach (var dep in editingTermMapping.Dependencies)
											{
												<tr>
													<td>@dep.TableName</td>
													<td>@dep.ColumnName</td>
													<td>
														<button class="btn btn-sm btn-outline-danger"
																@onclick="() => RemoveDependency(dep)">
															<i class="fas fa-times"></i>
														</button>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					}
					else if (editingTermMapping.Type == TermMappingType.FilterCondition)
					{
						<div class="mb-3">
							<label class="form-label">Filter Condition</label>
							<textarea class="form-control" rows="3" @bind="editingTermMapping.FilterCondition"
									  placeholder="Enter SQL filter condition"></textarea>
							<div class="form-text">
								Use column references like [Table].[Column] in your condition.
							</div>
						</div>

						<!-- Dependencies UI similar to CalculatedField -->
					}
					else if (editingTermMapping.Type == TermMappingType.Aggregate)
					{
						<!-- Aggregate-specific UI -->
					}

					<div class="mb-3">
						<label class="form-label">Synonyms (comma-separated)</label>
						<input type="text" class="form-control" @bind="synonymInput"
							   placeholder="Enter synonyms separated by commas" />
						<button class="btn btn-sm btn-outline-primary mt-2" @onclick="AddSynonyms">
							<i class="fas fa-plus me-1"></i> Add Synonyms
						</button>

						@if (editingTermMapping.Synonyms?.Any() == true)
						{
							<div class="mt-2">
								@foreach (var synonym in editingTermMapping.Synonyms)
								{
									<span class="badge bg-light text-dark me-1 mb-1 p-2">
										@synonym
										<button type="button" class="btn-close btn-close-sm ms-1"
												@onclick="() => RemoveSynonym(synonym)"></button>
									</span>
								}
							</div>
						}
					</div>
				}
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" @onclick="() => isTermMappingModalOpen = false">
					Cancel
				</button>
				<button type="button" class="btn btn-outline-success" @onclick="SaveTermMapping">
					Save
				</button>
			</div>
		</div>
	</div>
</div>
<div class="modal-backdrop fade @(isTermMappingModalOpen ? "show" : "")"
	 style="display: @(isTermMappingModalOpen ? "block" : "none")"></div>

<!-- Formula Viewer/Editor Modal -->
<div class="modal fade @(isFormulaModalOpen ? "show" : "")" tabindex="-1"
	 style="display: @(isFormulaModalOpen ? "block" : "none")">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					@(isEditingFormula ? "Edit Formula" : "Formula Viewer")
				</h5>
				<button type="button" class="btn-close" @onclick="CloseFormulaModal"></button>
			</div>
			<div class="modal-body">
				@if (currentFormulaTerm != null)
				{
					<div class="mb-3">
						<label class="form-label">Business Term</label>
						<div class="form-control bg-light">@currentFormulaTerm.BusinessTerm</div>
					</div>

					@if (isEditingFormula)
					{
						<div class="mb-3">
							<label class="form-label">Formula</label>
							<div class="position-relative">
								<textarea class="form-control font-monospace" rows="5"
										  @bind="formulaText"
										  @bind:event="oninput"
										  style="resize: vertical;"
										  @onkeyup="() => ValidateFormula(formulaText)"></textarea>
								@if (isValidatingFormula)
								{
									<div class="position-absolute top-0 end-0 m-2">
										<div class="spinner-border spinner-border-sm text-primary" role="status">
											<span class="visually-hidden">Validating...</span>
										</div>
									</div>
								}
							</div>

							@if (formulaValidationResult != null)
							{
								@if (formulaValidationResult.IsValid)
								{
									<div class="alert alert-success mt-2">
										<i class="fas fa-check-circle me-2"></i>
										Formula is valid
									</div>
								}
								else
								{
									<div class="alert alert-danger mt-2">
										<i class="fas fa-exclamation-circle me-2"></i>
										@formulaValidationResult.ErrorMessage
									</div>
								}
							}
						</div>

						<div class="mb-3">
    <label class="form-label">Formula Help</label>
    <div class="card">
        <div class="card-body">
            <ul class="nav nav-tabs" id="formulaHelpTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="functions-tab" data-bs-toggle="tab" 
                            data-bs-target="#functions" type="button" role="tab">
                        Functions
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="operators-tab" data-bs-toggle="tab" 
                            data-bs-target="#operators" type="button" role="tab">
                        Operators
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="common-mistakes-tab" data-bs-toggle="tab" 
                            data-bs-target="#common-mistakes" type="button" role="tab">
                        Common Mistakes
                    </button>
                </li>
            </ul>
            
            <div class="tab-content pt-3" id="formulaHelpTabContent">
                <div class="tab-pane fade show active" id="functions" role="tabpanel">
                    <h6>Available Functions:</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li><code>SUM(column)</code> - Sum values</li>
                                <li><code>AVG(column)</code> - Average values</li>
                                <li><code>COUNT(column)</code> - Count values</li>
                                <li><code>MIN(column)</code> - Minimum value</li>
                                <li><code>MAX(column)</code> - Maximum value</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-unstyled">
                                <li><code>ROUND(number, decimals)</code> - Round number</li>
                                <li><code>CAST(value AS type)</code> - Convert types</li>
                                <li><code>CASE WHEN...THEN...END</code> - Conditional logic</li>
                                <li><code>CONCAT(str1, str2)</code> - Combine strings</li>
                                <li><code>DATEADD(unit, value, date)</code> - Date arithmetic</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="tab-pane fade" id="operators" role="tabpanel">
                    <h6>Math Operators:</h6>
                    <ul class="list-unstyled">
                        <li><code>+</code> - Addition (e.g., <code>[Price] + [Tax]</code>)</li>
                        <li><code>-</code> - Subtraction (e.g., <code>[Revenue] - [Cost]</code>)</li>
                        <li><code>*</code> - Multiplication (e.g., <code>[Quantity] * [Price]</code>)</li>
                        <li><code>/</code> - Division (e.g., <code>[Total] / [Count]</code>)</li>
                        <li><code>%</code> - Modulo (e.g., <code>[Value] % 2</code>)</li>
                    </ul>
                    
@*                     <h6 class="mt-3">Comparison Operators:</h6>
                    <ul class="list-unstyled">
                        <li> <code> = </code> - Equal to</li>
                        <li><code> > </code> - Greater than</li>
                        <li><code>  </code> - Less than</li>
                        <li><code>>=</code> - Greater than or equal to</li>
                        <li><code><=</code> - Less than or equal to</li>
                        <li><code><></code> - Not equal to</li>
                    </ul> *@
                </div>
                
                <div class="tab-pane fade" id="common-mistakes" role="tabpanel">
                    <h6>Common Mistakes to Avoid:</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Incorrect</th>
                                <th>Correct</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>Table.Column</code></td>
                                <td><code>[Table].[Column]</code></td>
                                <td>Column references should use square brackets</td>
                            </tr>
                            <tr>
                                <td><code>Cost--Revenue</code></td>
                                <td><code>Cost-Revenue</code></td>
                                <td>Double dash (--) is a SQL comment operator</td>
                            </tr>
                            <tr>
                                <td><code>Price++Tax</code></td>
                                <td><code>Price+Tax</code></td>
                                <td>Double plus (++) is not a valid SQL operator</td>
                            </tr>
                            <tr>
                                <td><code>column = NULL</code></td>
                                <td><code>column IS NULL</code></td>
                                <td>Use IS NULL instead of = NULL</td>
                            </tr>
                            <tr>
                                <td><code>'text'text'</code></td>
                                <td><code>'text''text'</code></td>
                                <td>Double quote inside string needs escaping</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
					}
					else
					{
						<div class="mb-3">
							<label class="form-label">Formula</label>
							<pre class="bg-light p-3 rounded font-monospace border">@currentFormulaTerm.Formula</pre>
						</div>
					}

					<div class="mb-3">
						<label class="form-label">Dependencies</label>
						@if (currentFormulaTerm.Dependencies?.Any() == true)
						{
							<div class="table-responsive">
								<table class="table table-sm table-bordered">
									<thead class="table-light">
										<tr>
											<th>Table</th>
											<th>Column</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var dep in currentFormulaTerm.Dependencies)
										{
											<tr>
												<td>@dep.TableName</td>
												<td>@dep.ColumnName</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
						else
						{
							<div class="alert alert-info">
								No dependencies defined for this formula.
							</div>
						}
					</div>
				}
			</div>
			<div class="modal-footer">
				@if (isEditingFormula)
				{
					<button type="button" class="btn btn-secondary" @onclick="CancelFormulaEdit">Cancel</button>
					<button type="button" class="btn btn-success"
							@onclick="SaveFormulaChanges"
							disabled="@(formulaValidationResult != null && !formulaValidationResult.IsValid)">
						Save Changes
					</button>
				}
				else
				{
					<button type="button" class="btn btn-secondary" @onclick="CloseFormulaModal">Close</button>
					<button type="button" class="btn btn-primary green" @onclick="EnableFormulaEditing">
						<i class="fas fa-edit me-2"></i>Edit Formula
					</button>
				}
			</div>
		</div>
	</div>
</div>
<div class="modal-backdrop fade @(isFormulaModalOpen ? "show" : "")"
	 style="display: @(isFormulaModalOpen ? "block" : "none")"></div>