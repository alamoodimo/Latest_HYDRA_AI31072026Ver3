@page "/admin/DBMetaDataV2/{DatabaseId:int}"
@using DynamicDashboardCommon.Models
@using Microsoft.AspNetCore.Components
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IToastService toastService

@* ============================================ *@
@* FULL PAGE LOADING OVERLAY FOR LLM ANALYSIS  *@
@* ============================================ *@
@if (isAnalyzing)
{
	<div class="llm-loading-overlay">
		<div class="llm-loading-content">
			<div class="llm-loading-icon">
				<div class="brain-animation">
					<i class="fas fa-brain fa-4x text-primary pulse-glow"></i>
				</div>
				<div class="orbit-container">
					<div class="orbit-dot dot1"></div>
					<div class="orbit-dot dot2"></div>
					<div class="orbit-dot dot3"></div>
				</div>
			</div>

			<h3 class="mt-4 mb-2">AI Analyzing Database Schema</h3>
			<p class="text-muted mb-4">@analysisLoadingMessage</p>

			@* Replace the progress section with this simpler version *@
			<div class="progress-container">
				<div class="progress" style="width: 350px; height: 8px;">
					<div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
						 role="progressbar"
						 style="width: 100%">
					</div>
				</div>
				
			</div>

			<div class="analysis-steps mt-4">
				<div class="step @(analysisStep >= 1 ? "completed" : "")">
					<i class="fas @(analysisStep >= 1 ? "fa-check-circle text-success" : "fa-circle text-muted")"></i>
					<span>Reading schema structure</span>
				</div>
				<div class="step @(analysisStep >= 2 ? "completed" : "")">
					<i class="fas @(analysisStep >= 2 ? "fa-check-circle text-success" : (analysisStep == 1 ? "fa-spinner fa-spin text-primary" : "fa-circle text-muted"))"></i>
					<span>Analyzing tables & columns</span>
				</div>
				<div class="step @(analysisStep >= 3 ? "completed" : "")">
					<i class="fas @(analysisStep >= 3 ? "fa-check-circle text-success" : (analysisStep == 2 ? "fa-spinner fa-spin text-primary" : "fa-circle text-muted"))"></i>
					<span>Detecting relationships</span>
				</div>
@* 				<div class="step @(analysisStep >= 4 ? "completed" : "")">
					<i class="fas @(analysisStep >= 4 ? "fa-check-circle text-success" : (analysisStep == 3 ? "fa-spinner fa-spin text-primary" : "fa-circle text-muted"))"></i>
					<span>Generating suggestions</span>
				</div> *@
			</div>

@* 			<div class="mt-4">
				<small class="text-warning">
					<i class="fas fa-info-circle me-1"></i>
					This may take 1-3 minutes depending on schema complexity
				</small>
			</div> *@

			<button class="btn btn-outline-secondary mt-3" @onclick="CancelAnalysis">
				<i class="fas fa-times me-2"></i>Cancel
			</button>
		</div>
	</div>
}

@* ============================================ *@
@* CSS STYLES FOR LOADING OVERLAY              *@
@* ============================================ *@
<style>
	/* Full page overlay */
	.llm-loading-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(8px);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 9999;
		animation: fadeIn 0.3s ease-out;
	}

	@@keyframes fadeIn {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	.llm-loading-content {
		background: linear-gradient(145deg, #ffffff, #f8f9fa);
		padding: 3rem 4rem;
		border-radius: 20px;
		text-align: center;
		box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4);
		max-width: 500px;
		position: relative;
		overflow: hidden;
	}

		.llm-loading-content::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 4px;
			background: linear-gradient(90deg, #667eea 0%, #764ba2 50%, #667eea 100%);
			background-size: 200% 100%;
			animation: shimmer 2s infinite;
		}

	@@keyframes shimmer {
		0% {
			background-position: -200% 0;
		}

		100% {
			background-position: 200% 0;
		}
	}

	/* Brain animation */
	.llm-loading-icon {
		position: relative;
		width: 120px;
		height: 120px;
		margin: 0 auto;
	}

	.brain-animation {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		z-index: 2;
	}

	.pulse-glow {
		animation: pulseGlow 2s ease-in-out infinite;
	}

	@@keyframes pulseGlow {
		0%, 100% {
			text-shadow: 0 0 20px rgba(102, 126, 234, 0.5);
			transform: scale(1);
		}

		50% {
			text-shadow: 0 0 40px rgba(102, 126, 234, 0.8), 0 0 60px rgba(118, 75, 162, 0.4);
			transform: scale(1.1);
		}
	}

	/* Orbiting dots */
	.orbit-container {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		animation: rotate 4s linear infinite;
	}

	@@keyframes rotate {
		from {
			transform: rotate(0deg);
		}

		to {
			transform: rotate(360deg);
		}
	}

	.orbit-dot {
		position: absolute;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: linear-gradient(135deg, #667eea, #764ba2);
		box-shadow: 0 0 10px rgba(102, 126, 234, 0.6);
	}

	.dot1 {
		top: 0;
		left: 50%;
		transform: translateX(-50%);
	}

	.dot2 {
		bottom: 10px;
		left: 10px;
		animation-delay: -1.3s;
	}

	.dot3 {
		bottom: 10px;
		right: 10px;
		animation-delay: -2.6s;
	}

	/* Progress container */
	.progress-container {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	/* Analysis steps */
	.analysis-steps {
		text-align: left;
		padding: 1rem 1.5rem;
		background: #f8f9fa;
		border-radius: 10px;
	}

		.analysis-steps .step {
			display: flex;
			align-items: center;
			padding: 0.5rem 0;
			color: #6c757d;
			transition: all 0.3s ease;
		}

			.analysis-steps .step.completed {
				color: #212529;
			}

			.analysis-steps .step i {
				margin-right: 12px;
				width: 20px;
				text-align: center;
			}

	/* DB Health Badge */
	.health-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 1rem;
		border-radius: 50px;
		font-weight: 600;
		font-size: 1rem;
	}

		.health-badge i {
			margin-right: 8px;
		}

	.health-excellent {
		background: linear-gradient(135deg, #28a745, #20c997);
		color: white;
	}

	.health-good {
		background: linear-gradient(135deg, #17a2b8, #6610f2);
		color: white;
	}

	.health-fair {
		background: linear-gradient(135deg, #007bff, #6f42c1);
		color: white;
	}

	.health-needs-work {
		background: linear-gradient(135deg, #ffc107, #fd7e14);
		color: #212529;
	}

	.health-poor {
		background: linear-gradient(135deg, #dc3545, #e83e8c);
		color: white;
	}

	/* ============================================ */
	/* PAGE HEADER (dbm-*)                          */
	/* Scoped class names avoid clashes with the    */
	/* global theme's .btn styles.                  */
	/* ============================================ */
	.dbm-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		padding: 1.25rem 1.5rem;
		background: linear-gradient(135deg, #ffffff 0%, #f5f7ff 100%);
		border: 1px solid rgba(102, 126, 234, 0.15);
		border-radius: 18px;
		box-shadow: 0 8px 30px rgba(31, 41, 90, 0.06);
		position: relative;
		animation: dbmSlideDown 0.45s ease-out;
	}

		/* Animated accent line (no overflow:hidden, so the dropdown menu is not clipped) */
		.dbm-header::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			border-radius: 18px 18px 0 0;
			background: linear-gradient(90deg, #667eea 0%, #764ba2 50%, #667eea 100%);
			background-size: 200% 100%;
			animation: shimmer 3s linear infinite;
		}

	.dbm-header-info {
		display: flex;
		align-items: center;
		gap: 1rem;
		min-width: 0;
		flex: 1 1 360px;
	}

	.dbm-header-icon {
		width: 52px;
		height: 52px;
		flex-shrink: 0;
		border-radius: 14px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
		color: #fff;
		background: linear-gradient(135deg, #667eea, #764ba2);
		box-shadow: 0 8px 20px rgba(102, 126, 234, 0.35);
		animation: dbmFloat 4s ease-in-out infinite;
	}

	.dbm-header-text {
		min-width: 0;
	}

	.dbm-title-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
	}

	.dbm-title {
		font-weight: 700;
		font-size: 1.5rem;
		color: #1f2a44;
		white-space: nowrap;
	}

	.dbm-db-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		max-width: 320px;
		padding: 0.3rem 0.85rem;
		border-radius: 999px;
		background: rgba(102, 126, 234, 0.12);
		color: #4c51bf;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.dbm-db-chip-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.dbm-db-chip-dot {
		font-size: 0.5rem;
		color: #48bb78;
		animation: dbmPulse 2s ease-in-out infinite;
	}

	.dbm-subtitle {
		margin-top: 0.3rem;
		max-width: 640px;
		color: #6b7280;
		font-size: 0.9rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.dbm-header-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		flex: 1 1 auto;
	}

	.dbm-actions-group {
		display: inline-flex;
		gap: 0.5rem;
	}

	/* Buttons */
	.dbm-header .dbm-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 42px;
		padding: 0 1rem;
		border-radius: 12px;
		border: 1px solid transparent;
		font-weight: 600;
		font-size: 0.9rem;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
	}

		.dbm-header .dbm-btn:disabled {
			opacity: 0.6;
			cursor: not-allowed;
			transform: none;
			box-shadow: none;
		}

	.dbm-header .dbm-btn-text {
		display: inline-block;
		max-width: 180px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.dbm-header .dbm-btn-primary {
		position: relative;
		overflow: hidden;
		color: #fff;
		background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
		box-shadow: 0 6px 18px rgba(102, 126, 234, 0.35);
	}

		.dbm-header .dbm-btn-primary::after {
			content: '';
			position: absolute;
			top: 0;
			left: -120%;
			width: 60%;
			height: 100%;
			background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.35), transparent);
			transition: left 0.6s ease;
		}

		.dbm-header .dbm-btn-primary:not(:disabled):hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 24px rgba(102, 126, 234, 0.45);
		}

			.dbm-header .dbm-btn-primary:not(:disabled):hover::after {
				left: 130%;
			}

	.dbm-header .dbm-btn-ghost {
		color: #4c51bf;
		background: #fff;
		border-color: rgba(102, 126, 234, 0.35);
	}

		.dbm-header .dbm-btn-ghost:not(:disabled):hover {
			background: rgba(102, 126, 234, 0.08);
			transform: translateY(-1px);
		}

	/* Phase stepper */
	.dbm-stepper {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.3rem;
		background: #fff;
		border: 1px solid #e5e7eb;
		border-radius: 14px;
	}

	.dbm-header .dbm-step {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		height: 40px;
		padding: 0 0.8rem 0 0.4rem;
		border: none;
		border-radius: 10px;
		background: transparent;
		color: #374151;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
	}

		.dbm-header .dbm-step:not(:disabled):hover {
			background: rgba(102, 126, 234, 0.08);
			transform: translateY(-1px);
		}

		.dbm-header .dbm-step:disabled {
			cursor: not-allowed;
		}

		.dbm-header .dbm-step.is-locked {
			opacity: 0.55;
		}

	.dbm-step-badge {
		width: 28px;
		height: 28px;
		flex-shrink: 0;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.8rem;
		background: #e5e7eb;
		color: #6b7280;
		transition: all 0.3s ease;
	}

	.dbm-step.is-current .dbm-step-badge {
		color: #fff;
		background: linear-gradient(135deg, #667eea, #764ba2);
		animation: dbmPulseRing 2s ease-out infinite;
	}

	.dbm-step.is-done .dbm-step-badge {
		color: #fff;
		background: linear-gradient(135deg, #48bb78, #38a169);
	}

	.dbm-step-label {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.15;
	}

	.dbm-step-title {
		font-weight: 600;
		font-size: 0.85rem;
	}

	.dbm-step-meta {
		font-size: 0.72rem;
		color: #6b7280;
	}

	.dbm-step-connector {
		width: 18px;
		height: 2px;
		border-radius: 2px;
		background: #e5e7eb;
		transition: background 0.3s ease;
	}

		.dbm-step-connector.is-done {
			background: linear-gradient(90deg, #48bb78, #667eea);
		}

	/* Animations */
	@@keyframes dbmSlideDown {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}

		to {
			opacity: 1;
			transform: none;
		}
	}

	@@keyframes dbmFloat {
		0%, 100% {
			transform: translateY(0);
		}

		50% {
			transform: translateY(-3px);
		}
	}

	@@keyframes dbmPulse {
		0%, 100% {
			opacity: 1;
		}

		50% {
			opacity: 0.35;
		}
	}

	@@keyframes dbmPulseRing {
		0% {
			box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.45);
		}

		70% {
			box-shadow: 0 0 0 8px rgba(102, 126, 234, 0);
		}

		100% {
			box-shadow: 0 0 0 0 rgba(102, 126, 234, 0);
		}
	}

	/* Small screens: stepper scrolls instead of squeezing */
	@@media (max-width: 767.98px) {
		.dbm-title {
			font-size: 1.25rem;
		}

		.dbm-stepper {
			max-width: 100%;
			overflow-x: auto;
		}

		.dbm-header .dbm-step-meta {
			display: none;
		}
	}

	/* Respect users who prefer less motion */
	@@media (prefers-reduced-motion: reduce) {
		.dbm-header,
		.dbm-header * {
			animation: none !important;
			transition: none !important;
		}
	}
</style>

<div class="container-fluid py-0">
	<!-- Enhanced Header with Database Selection -->

@* 	Old Header efore claude 23 9 2026
	<div class="row mb-4 align-items-center">
		<div class="col-md-6">
			<div class="d-flex align-items-center">
				<h3 class="mb-0 me-3">
					<i class="fas fa-database me-2 text-primary"></i>
					Database Structure
				</h3>
				@if (!string.IsNullOrEmpty(selectedDatabase?.FriendlyName))
				{
					<h2 class="mb-0 fw-bold text-primary">@selectedDatabase.FriendlyName</h2>
				}
			</div>
			@if (!string.IsNullOrEmpty(selectedDatabase?.Description))
			{
				<p class="text-muted mb-0 mt-1">@selectedDatabase.Description</p>
			}
		</div>
		<div class="col-md-6">
			<div class="d-flex justify-content-end">
				<div class="dropdown me-2">
					<button class="btn btn-outline-primary dropdown-toggle" type="button" id="databaseDropdown" data-bs-toggle="dropdown" aria-expanded="false">
						<i class="fas fa-database me-2"></i>
						@(selectedDatabase?.Name ?? "Select Database")
					</button>
					<ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="databaseDropdown" style="max-height: 300px; overflow-y: auto;">
						@if (databases?.Any() == true)
						{
							@foreach (var db in databases)
							{
								<li>
									<a class="dropdown-item @(selectedDatabase?.DatabaseID == db.DatabaseID ? "active" : "")"
									   href="/admin/database-metadata/@db.DatabaseID">
										<div class="d-flex align-items-center">
											<span class="me-2">@db.Name</span>
											@if (!string.IsNullOrEmpty(db.FriendlyName) && db.FriendlyName != db.Name)
											{
												<span class="text-muted small">(@db.FriendlyName)</span>
											}
										</div>
									</a>
								</li>
							}
						}
						else
						{
							<li><span class="dropdown-item disabled">No databases available</span></li>
						}
					</ul>
				</div>

				<!-- PHASE BUTTONS -->
				<div class="btn-group me-3">
					<button class="btn btn-@(tablePhaseCompleted ? "success" : "primary")"
        @onclick='() => RunTableAnalysis()'
        disabled="@(isAnalyzingTables)">
						<i class="fas fa-table me-2"></i>
						@if (tablePhaseCompleted)
						{
							<span>✓ Tables Complete</span>
						}
						else if (analysisStatus != null)
						{
							<span>1. Tables (@analysisStatus.TablesAnalyzed/@analysisStatus.TotalTables)</span>
						}
						else
						{
							<span>1. Analyze Tables</span>
						}
						@if (isAnalyzingTables)
						{
							<span class="spinner-border spinner-border-sm ms-2"></span>
						}
					</button>

<button class="btn btn-@(columnPhaseCompleted ? "success" : "outline-primary")"
        @onclick="() => RunColumnAnalysis()"
        disabled="@(!tablePhaseCompleted || isAnalyzingColumns)">
						<i class="fas fa-columns me-2"></i>
						@if (columnPhaseCompleted)
						{
							<span>✓ Columns Complete</span>
						}
						else if (analysisStatus != null)
						{
							<span>2. Columns (@analysisStatus.ColumnsAnalyzed/@analysisStatus.TotalColumns)</span>
						}
						else
						{
							<span>2. Analyze Columns</span>
						}
						@if (isAnalyzingColumns)
						{
							<span class="spinner-border spinner-border-sm ms-2"></span>
						}
					</button>

					<button class="btn btn-@(relationshipPhaseCompleted ? "success" : "outline-primary")"
							@onclick="RunRelationshipAnalysis"
							disabled="@(!columnPhaseCompleted || isAnalyzingRelationships)">
						<i class="fas fa-link me-2"></i>
						@if (relationshipPhaseCompleted)
						{
							<span>✓ Relationships (@analysisStatus?.RelationshipsFound ?? 0)</span>
						}
						else
						{
							<span>3. Find Relationships</span>
						}
						@if (isAnalyzingRelationships)
						{
							<span class="spinner-border spinner-border-sm ms-2"></span>
						}
					</button>
				</div>

				<!-- MAIN BUTTON GROUP -->
				<div class="btn-group">
					<button class="btn btn-primary green" @onclick="RunSchemaAnalysis" disabled="@(isLoading || isAnalyzing)">
						@if (isAnalyzing)
						{
							<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
							<span>Analyzing...</span>
						}
						else
						{
							<i class="fas fa-magic me-2"></i>
							<span>Analyze Schema</span>
						}
					</button>
					<button class="btn btn-outline-primary" @onclick="RefreshSchema" disabled="@(isLoading)">
						<i class="fas fa-sync-alt me-2"></i>
						<span>Refresh</span>
					</button>
				</div>
			</div>
		</div>
	</div> *@
	<!-- ============================================ -->
	<!-- PAGE HEADER: info (left) + actions (right).   -->
	<!-- Wraps to a second line instead of overlapping. -->
	<!-- ============================================ -->
	<div class="dbm-header mb-4">
		<div class="dbm-header-info">
			<div class="dbm-header-icon">
				<i class="fas fa-database"></i>
			</div>
			<div class="dbm-header-text">
				<div class="dbm-title-row">
					<h3 class="dbm-title mb-0">Database Structure</h3>
					@if (!string.IsNullOrEmpty(selectedDatabase?.FriendlyName))
					{
						<span class="dbm-db-chip" title="@selectedDatabase.FriendlyName">
							<i class="fas fa-circle dbm-db-chip-dot"></i>
							<span class="dbm-db-chip-text">@selectedDatabase.FriendlyName</span>
						</span>
					}
				</div>
				@if (!string.IsNullOrEmpty(selectedDatabase?.Description))
				{
					<p class="dbm-subtitle mb-0" title="@selectedDatabase.Description">@selectedDatabase.Description</p>
				}
			</div>
		</div>

		<div class="dbm-header-actions">
			<!-- Database switcher -->
			<div class="dropdown">
				<button class="dbm-btn dbm-btn-ghost dropdown-toggle" type="button" id="databaseDropdown"
						data-bs-toggle="dropdown" aria-expanded="false">
					<i class="fas fa-database"></i>
					<span class="dbm-btn-text">@(selectedDatabase?.Name ?? "Select Database")</span>
				</button>
				<ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="databaseDropdown" style="max-height: 300px; overflow-y: auto;">
					@if (databases?.Any() == true)
					{
						@foreach (var db in databases)
						{
							<li>
								<a class="dropdown-item @(selectedDatabase?.DatabaseID == db.DatabaseID ? "active" : "")"
								   href="/admin/database-metadata/@db.DatabaseID">
									<div class="d-flex align-items-center">
										<span class="me-2">@db.Name</span>
										@if (!string.IsNullOrEmpty(db.FriendlyName) && db.FriendlyName != db.Name)
										{
											<span class="text-muted small">(@db.FriendlyName)</span>
										}
									</div>
								</a>
							</li>
						}
					}
					else
					{
						<li><span class="dropdown-item disabled">No databases available</span></li>
					}
				</ul>
			</div>

			<!-- Phased analysis stepper: 1 Tables -> 2 Columns -> 3 Relationships -->
			<div class="dbm-stepper" role="group" aria-label="Phased analysis">
				<button class="dbm-step @(tablePhaseCompleted ? "is-done" : "is-current")"
						@onclick='() => RunTableAnalysis()'
						disabled="@(isAnalyzingTables)"
						title="Analyze table names and descriptions">
					<span class="dbm-step-badge">
						@if (isAnalyzingTables)
						{
							<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
						}
						else if (tablePhaseCompleted)
						{
							<i class="fas fa-check"></i>
						}
						else
						{
							<span>1</span>
						}
					</span>
					<span class="dbm-step-label">
						<span class="dbm-step-title">Tables</span>
						<span class="dbm-step-meta">@(analysisStatus != null ? $"{analysisStatus.TablesAnalyzed}/{analysisStatus.TotalTables}" : "Analyze")</span>
					</span>
				</button>

				<span class="dbm-step-connector @(tablePhaseCompleted ? "is-done" : "")"></span>

				<button class="dbm-step @(columnPhaseCompleted ? "is-done" : (tablePhaseCompleted ? "is-current" : "is-locked"))"
						@onclick='() => RunColumnAnalysis()'
						disabled="@(!tablePhaseCompleted || isAnalyzingColumns)"
						title="Analyze column names, descriptions and lookups">
					<span class="dbm-step-badge">
						@if (isAnalyzingColumns)
						{
							<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
						}
						else if (columnPhaseCompleted)
						{
							<i class="fas fa-check"></i>
						}
						else
						{
							<span>2</span>
						}
					</span>
					<span class="dbm-step-label">
						<span class="dbm-step-title">Columns</span>
						<span class="dbm-step-meta">@(analysisStatus != null ? $"{analysisStatus.ColumnsAnalyzed}/{analysisStatus.TotalColumns}" : "Analyze")</span>
					</span>
				</button>

				<span class="dbm-step-connector @(columnPhaseCompleted ? "is-done" : "")"></span>

				<button class="dbm-step @(relationshipPhaseCompleted ? "is-done" : (columnPhaseCompleted ? "is-current" : "is-locked"))"
						@onclick="RunRelationshipAnalysis"
						disabled="@(!columnPhaseCompleted || isAnalyzingRelationships)"
						title="Detect relationships between tables">
					<span class="dbm-step-badge">
						@if (isAnalyzingRelationships)
						{
							<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
						}
						else if (relationshipPhaseCompleted)
						{
							<i class="fas fa-check"></i>
						}
						else
						{
							<span>3</span>
						}
					</span>
					<span class="dbm-step-label">
						<span class="dbm-step-title">Relationships</span>
						<span class="dbm-step-meta">@(relationshipPhaseCompleted ? $"{analysisStatus?.RelationshipsFound ?? 0} found" : "Find")</span>
					</span>
				</button>
			</div>

			<!-- Primary actions -->
			<div class="dbm-actions-group">
				<button class="dbm-btn dbm-btn-primary" @onclick="RunSchemaAnalysis" disabled="@(isLoading || isAnalyzing)">
					@if (isAnalyzing)
					{
						<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
						<span>Analyzing...</span>
					}
					else
					{
						<i class="fas fa-magic"></i>
						<span>Analyze Schema</span>
					}
				</button>
				<button class="dbm-btn dbm-btn-ghost" @onclick="RefreshSchema" disabled="@(isLoading)" title="Reload schema from the database">
					<i class="fas fa-sync-alt @(isLoading ? "fa-spin" : "")"></i>
					<span class="dbm-btn-text">Refresh</span>
				</button>
			</div>
		</div>
	</div>

	@if (isLoading)
	{
		<div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
			<div class="spinner-border text-primary" role="status">
				<span class="visually-hidden">Loading...</span>
			</div>
			<div class="ms-3 h5 mb-0">@loadingMessage</div>
		</div>
	}
	else
	{
		<div class="row">
			<!-- Left sidebar for navigation -->
			<div class="col-md-3">
				<div class="card shadow-sm mb-4">
					<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
						<h5 class="mb-0">Navigation</h5>
					</div>
					<div class="card-body p-0">
						<!-- View options -->
						<div class="list-group list-group-flush">
							<button class="list-group-item list-group-item-action d-flex align-items-center @(activeTab == "tables" ? "active" : "")"
									@onclick='() => SetActiveTab("tables")'>
								<i class="fas fa-table me-3"></i>
								<span>Tables & Columns</span>
							</button>
							<button class="list-group-item list-group-item-action d-flex align-items-center @(activeTab == "relationships" ? "active" : "")"
									@onclick='() => SetActiveTab("relationships")'>
								<i class="fas fa-link me-3"></i>
								<span>Relationships</span>
							</button>
							<button class="list-group-item list-group-item-action d-flex align-items-center @(activeTab == "analysis" ? "active" : "")"
									@onclick='() => SetActiveTab("analysis")'>
								<i class="fas fa-chart-bar me-3"></i>
								<span>Analysis Results</span>
								@if (analysisResult?.Success == true)
								{
									<span class="badge bg-success ms-auto">Available</span>
								}
							</button>
							<button class="list-group-item list-group-item-action d-flex align-items-center @(activeTab == "termMappings" ? "active" : "")"
									@onclick='() => SetActiveTab("termMappings")'>
								<i class="fas fa-link me-3"></i>
								<span>Terms & Formulas</span>
							</button>

						</div>
					</div>
				</div>

				<!-- Table list -->
				<div class="card shadow-sm">
					<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
						<h5 class="mb-0">Database Tables</h5>
						<span class="badge bg-primary">@(schemaObj?.Tables?.Count ?? 0)</span>
					</div>
					<div class="card-body p-0">
						<div class="input-group p-2">
							<span class="input-group-text bg-light border-light">
								<i class="fas fa-search text-muted"></i>
							</span>
							<input type="text" class="form-control border-light" placeholder="Search tables..."
								   @bind="tableSearchTerm" @bind:event="oninput" />
							@if (!string.IsNullOrEmpty(tableSearchTerm))
							{
								<button class="btn btn-outline-secondary border-light" @onclick="() => tableSearchTerm = string.Empty">
									<i class="fas fa-times"></i>
								</button>
							}
						</div>

@* 						<div class="list-group list-group-flush" style="overflow-y: auto;"> *@
						<div class="list-group list-group-flush" style="overflow-y: auto; max-height: 55vh;">
							@if (schemaObj?.Tables?.Any() == true)
							{
								@foreach (var table in FilteredTables)
								{
									<button class="list-group-item list-group-item-action @(selectedTable?.ID == table.ID ? "active" : "")"
											@onclick="() => SelectTable(table)">
										<div class="d-flex justify-content-between align-items-center">
											<div class="d-flex align-items-center">
												<i class="fas fa-table me-2 @(table.IsActive ? "text-primary" : "text-muted")"></i>
												<span class="@(!table.IsActive ? "text-muted text-decoration-line-through" : "")">
													@(!string.IsNullOrEmpty(table.FriendlyName) ? table.FriendlyName : table.DBName)
												</span>
											</div>
											<span class="badge rounded-pill bg-light text-dark">
												@(table.Columns?.Count ?? 0)
											</span>
										</div>
									</button>
								}
							}
							else
							{
								<div class="list-group-item text-center text-muted">
									<i class="fas fa-info-circle me-2"></i>
									No tables available
								</div>
							}
						</div>
					</div>
				</div>
			</div>

			<!-- Main content area -->
			<div class="col-md-9">
				@if (activeTab == "tables")
				{
					<!-- Table Details Tab -->
					if (selectedTable != null)
					{
						<div class="card shadow-sm mb-4">
							<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
								<h5 class="mb-0">
									<i class="fas fa-table me-2"></i>
									Table: @selectedTable.DBName
								</h5>
								<div>
									<div class="form-check form-switch d-flex align-items-center">
										<input class="form-check-input me-2" type="checkbox" id="tableActiveSwitch"
											   checked="@selectedTable.IsActive"
											   @onchange="async (e) => await UpdateTableActiveStatus(e.Value)">
										<label class="form-check-label" for="tableActiveSwitch">
											@(selectedTable.IsActive ? "Active" : "Inactive")
										</label>
									</div>
								</div>
							</div>
							<div class="card-body">
								<form>
									<div class="row mb-3">
										<div class="col-md-6">
											<label class="form-label">Database Table Name</label>
											<input type="text" class="form-control" value="@selectedTable.DBName" disabled />
										</div>
										<div class="col-md-6">
											<label class="form-label">Friendly Name</label>
											<input type="text" class="form-control" @bind="selectedTable.FriendlyName"
												   placeholder="Enter user-friendly name" />
										</div>
									</div>
									<div class="mb-3">
										<label class="form-label">Description</label>
										<textarea class="form-control" rows="3" @bind="selectedTable.Description"
												  placeholder="Enter description"></textarea>
									</div>
									<div class="mb-3">
										<label class="form-label">Synonyms (comma-separated)</label>
										<div class="input-group">
											<input type="text" class="form-control" @bind="tableSynonymsInput"
												   placeholder="Enter synonyms separated by commas" />
											<button class="btn btn-outline-primary" type="button" @onclick="UpdateTableSynonyms">
												Update Synonyms
											</button>
										</div>
										@if (selectedTable.Synonyms?.Any() == true)
										{
											<div class="mt-2">
												@foreach (var synonym in selectedTable.Synonyms)
												{
													<span class="badge bg-light text-dark me-1 mb-1 p-2">
														@synonym
														<button type="button" class="btn-close btn-close-sm ms-1"
																@onclick="() => RemoveTableSynonym(synonym)"></button>
													</span>
												}
											</div>
										}
									</div>

									@if (tableAnalysis != null)
									{
										<div class="alert alert-info">
											<div class="d-flex align-items-center">
												<i class="fas fa-lightbulb fs-4 me-3"></i>
												<div class="flex-grow-1">
													<strong>AI Suggestion:</strong>
													<div class="mt-1">
														<div><strong>Name:</strong> @tableAnalysis.SuggestedName</div>
														<div><strong>Description:</strong> @tableAnalysis.SuggestedDescription</div>
													</div>
@* 													<button class="btn btn-sm btn-outline-primary mt-2" @onclick="() => ApplyTableSuggestion()">
														<i class="fas fa-magic me-1"></i> Apply Suggestion
													</button> *@
												</div>
											</div>
										</div>
									}

									<div class="d-flex justify-content-end">
										<button type="button" class="btn btn-success" @onclick="SaveTableChanges">
											<i class="fas fa-save me-2"></i> Save Changes
										</button>
									</div>
								</form>
							</div>
						</div>

						<!-- Columns Table -->
						<div class="card shadow-sm">
							<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
								<h5 class="mb-0">
									<i class="fas fa-columns me-2"></i>
									Columns
								</h5>
								<span class="badge bg-primary">@(selectedTable.Columns?.Count ?? 0)</span>
							</div>
							<div class="card-body">
								<!-- Column Search and Filter Controls -->
								<div class="row mb-3">
									<div class="col-md-8">
										<div class="input-group">
											<span class="input-group-text bg-light border-light">
												<i class="fas fa-search text-muted"></i>
											</span>
											<input type="text" class="form-control border-light" placeholder="Search columns..."
												   @bind="columnSearchTerm" @bind:event="oninput" />
											@if (!string.IsNullOrEmpty(columnSearchTerm))
											{
												<button class="btn btn-outline-secondary border-light" @onclick="() => columnSearchTerm = string.Empty">
													<i class="fas fa-times"></i>
												</button>
											}
										</div>
									</div>
									<div class="col-md-4">
										<select class="form-select" @bind="columnFilter">
											<option value="all">All Columns</option>
											<option value="primary">Primary Keys</option>
											<option value="lookup">Lookup Columns</option>
											<option value="active">Active Only</option>
											<option value="inactive">Inactive Only</option>
										</select>
									</div>
								</div>

								<!-- Columns Table -->
								<div class="table-responsive">
									<table class="table table-hover table-striped">
										<thead class="table-light">
											<tr>
												<th style="width: 20%">DB Column Name</th>
												<th style="width: 15%">Data Type</th>
												<th style="width: 20%">Friendly Name</th>
												<th style="width: 25%">Description</th>
												<th style="width: 10%">Attributes</th>
												<th style="width: 10%">Actions</th>
											</tr>
										</thead>
										<tbody>
											@if (selectedTable.Columns?.Any() == true)
											{
												@foreach (var column in FilteredColumns)
{
    var col = column;

													<tr class="@(!column.IsActive ? "table-secondary" : "")">
														<td>
															<div class="d-flex align-items-center">
																<i class="fas fa-column me-2 @(column.IsActive ? "text-primary" : "text-muted")"></i>
																<span class="@(!column.IsActive ? "text-muted text-decoration-line-through" : "")">
																	@column.DBName
																</span>
															</div>
														</td>
														<td>
															<span class="badge bg-light text-dark">
																@column.DataType
															</span>
															@if (!column.IsNullable)
															{
																<span class="badge bg-danger ms-1">Required</span>
															}
														</td>
														<td>
															<input type="text" class="form-control form-control-sm"
																   @bind="column.FriendlyName" placeholder="Friendly name" />
														</td>
														<td>
															<input type="text" class="form-control form-control-sm"
																   @bind="column.Description" placeholder="Description" />
														</td>
														<td class="text-center">
															<div class="form-check form-switch d-flex justify-content-center mb-1">
															<input class="form-check-input" type="checkbox" id="column-lookup-@column.ID"
														@bind="column.IsLookup">
															</div>
															<label class="form-check-label small" for="column-lookup-@column.ID">
																Lookup
															</label>
														</td>
														<td>
															<div class="btn-group btn-group-sm">
																<button type="button" class="btn btn-outline-primary"
																		@onclick="() => AddEditColumnSynonyms(column)"
																		title="Edit Synonyms">
																	<i class="fas fa-tags"></i>
																</button>
																<button type="button" class="btn btn-outline-@(column.IsActive ? "danger" : "success")"
																		@onclick="() => ToggleColumnActive(column)"
																		title="@(column.IsActive ? "Deactivate" : "Activate")">
																	<i class="fas fa-@(column.IsActive ? "eye-slash" : "eye")"></i>
																</button>
																@{
																	var columnAnalysis = GetColumnAnalysis(column);
																}
																@if (columnAnalysis != null)
																{
																	<button type="button" class="btn btn-outline-info"
																			@onclick="() => ShowColumnSuggestion(column, columnAnalysis)"
																			title="View AI Suggestions">
																		<i class="fas fa-lightbulb"></i>
																	</button>
																}
															</div>
														</td>
													</tr>
												}
											}
											else
											{
												<tr>
													<td colspan="6" class="text-center py-3">
														<i class="fas fa-info-circle me-2"></i>
														No columns available for this table
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
								<div class="d-flex justify-content-end mt-3">
									<button type="button" class="btn btn-primary green" @onclick="SaveColumnChanges">
										<i class="fas fa-save me-2"></i> Save Column Changes
									</button>
								</div>
							</div>
						</div>
					}
					else
					{
						<!-- No table selected message -->
						<div class="card shadow-sm">
							<div class="card-body text-center py-5">
								<i class="fas fa-table fa-3x text-muted mb-3"></i>
								<h5>No Table Selected</h5>
								<p class="text-muted">Please select a table from the list to view and edit its details.</p>
							</div>
						</div>
					}
				}
				else if (activeTab == "relationships")
				{
					<!-- Relationships Tab -->
					<div class="card shadow-sm">
						<div class="card-header bg-light d-flex justify-content-between align-items-center py-3">
							<h5 class="mb-0">
								<i class="fas fa-link me-2"></i>
								Database Relationships
							</h5>
							<button class="btn btn-primary green btn-sm" @onclick="CreateNewRelationship">
								<i class="fas fa-plus me-2"></i>New Relationship
							</button>
						</div>
						<div class="card-body">
							@if (isLoading && relationships == null)
							{
								<div class="d-flex justify-content-center my-4">
									<div class="spinner-border text-primary" role="status">
										<span class="visually-hidden">Loading relationships...</span>
									</div>
									<div class="ms-3">Loading database relationships...</div>
								</div>
							}
							else if (editingRelationship == null)
							{
								<!-- Relationship filter and search -->
								<div class="row mb-3">
									<div class="col-md-8">
										<div class="input-group">
											<span class="input-group-text bg-light border-light">
												<i class="fas fa-search text-muted"></i>
											</span>
											<input type="text" class="form-control border-light" placeholder="Search relationships..."
												   @bind="relationshipSearchTerm" @bind:event="oninput" />
											@if (!string.IsNullOrEmpty(relationshipSearchTerm))
											{
												<button class="btn btn-outline-secondary border-light" @onclick="() => relationshipSearchTerm = string.Empty">
													<i class="fas fa-times"></i>
												</button>
											}
										</div>
									</div>
									<div class="col-md-4">
										<select class="form-select" @bind="relationshipFilter">
											<option value="all">All Relationships</option>
											<option value="onetomany">One-to-Many</option>
											<option value="manytoone">Many-to-One</option>
											<option value="onetoone">One-to-One</option>
											<option value="manytomany">Many-to-Many</option>
											<option value="active">Active Only</option>
											<option value="inactive">Inactive Only</option>
										</select>
									</div>
								</div>

								<!-- Relationships Table -->
								<div class="table-responsive">
									<table class="table table-striped table-hover">
										<thead class="table-light">
											<tr>
												<th>Source Table</th>
												<th>Source Column</th>
												<th>Relationship</th>
												<th>Target Table</th>
												<th>Target Column</th>
												<th>Status</th>
												<th>Actions</th>
											</tr>
										</thead>
										<tbody>
											@if (relationships?.Any() == true)
											{
												@foreach (var relationship in FilteredRelationships)
												{
													<tr class="@(!relationship.IsActive ? "table-secondary" : "")">
														<td>@GetTableName(relationship.Source?.TableID)</td>
														<td>@GetColumnName(relationship.Source?.TableID, relationship.Source?.ColumnID)</td>
														<td>
															<span class="badge bg-info">@relationship.Type</span>
														</td>
														<td>@GetTableName(relationship.Target?.TableID)</td>
														<td>@GetColumnName(relationship.Target?.TableID, relationship.Target?.ColumnID)</td>
														<td>
															@if (relationship.IsActive)
															{
																<span class="badge bg-success">Active</span>
															}
															else
															{
