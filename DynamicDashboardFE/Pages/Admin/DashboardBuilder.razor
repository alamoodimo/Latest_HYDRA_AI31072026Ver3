    private async Task SaveDashboard()
    {
        if (!CanSave())
        {
            ToastService.ShowError("Please enter a title and select a database");
            return;
        }

        try
        {
            PrepareDashboardForSave();
            dashboard.LastUpdated = DateTime.UtcNow;

            HttpResponseMessage response;
            if (dashboard.DashboardID > 0)
            {
                response = await Http.PutAsJsonAsync($"api/dashboard/{dashboard.DashboardID}", dashboard);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/dashboard", dashboard);
            }

            if (response.IsSuccessStatusCode)
            {
                hasUnsavedChanges = false;

                if (dashboard.DashboardID == 0)
                {
                    var createdDashboard = await response.Content.ReadFromJsonAsync<DashboardModel>();
                    if (createdDashboard != null)
                    {
                        dashboard = createdDashboard;
                        NavigationManager.NavigateTo($"/dashboard/builder/{dashboard.DashboardID}", false);
                    }
                }

                ToastService.ShowSuccess("Dashboard saved successfully!");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"Save failed: {error}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
    }

    private void PrepareDashboardForSave()
    {
        // Ensure required string fields are not null
        dashboard.LayoutConfig ??= "{}";
        dashboard.FiltersConfig ??= "{}";
        dashboard.Title ??= "Untitled Dashboard";
        dashboard.Description ??= "";

        // Set CategoryName properly
        if (dashboard.CategoryID > 0 && availableCategories.Any())
        {
            var category = availableCategories.FirstOrDefault(c => c.CategoryID == dashboard.CategoryID);
            dashboard.CategoryName = category?.Name ?? "General";
        }
        else
        {
            dashboard.CategoryName = "General";
        }

        // Set created by if not set
        if (dashboard.CreatedBy == 0)
        {
            dashboard.CreatedBy = 1; // Default user ID
        }

        // Set timestamps
        if (dashboard.CreatedAt == default)
        {
            dashboard.CreatedAt = DateTime.UtcNow;
        }
        dashboard.LastUpdated = DateTime.UtcNow;

        // Set validation status if not set
        if (dashboard.ValidationStatus == DashboardValidationStatus.PendingValidation)
        {
            dashboard.ValidationStatus = DashboardValidationStatus.Validated;
        }

        // // Set sharing status if not set
        // if (dashboard.SharingStatus == DashboardSharingStatus.NotSet)
        // {
        //     dashboard.SharingStatus = DashboardSharingStatus.Private;
        // }

        // Prepare components
        if (dashboard.Components != null)
        {
            foreach (var component in dashboard.Components)
            {
                PrepareComponentForSave(component);
            }
        }
    }

    private void PrepareComponentForSave(DashboardComponent component)
    {
        // Set required string fields
        component.Title ??= string.Empty;
        component.Description ??= "";
        component.QueryText ??= "";
        component.QueryIntent ??= "";
        component.FilterExpression ??= "";
        component.VisualizationConfig ??= "{}";

        // Set ChartType based on DataViewingTypeID
        if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
        {
            component.ChartType ??= "bar"; // Default chart type
        }
        else
        {
            component.ChartType = ""; // Empty for non-chart components
        }

        // Set DataViewingTypeName based on DataViewingTypeID
        component.DataViewingTypeName = component.DataViewingTypeID switch
        {
            1 => "Table",
            2 => "Label",
            3 => "KPI",
            4 => "Chart",
            _ => "Unknown"
        };

        // Set timestamps
        if (component.CreatedAt == default)
        {
            component.CreatedAt = DateTime.UtcNow;
        }
        component.LastUpdated = DateTime.UtcNow;

        // Ensure GridX and GridY are valid (non-negative)
        component.GridX = Math.Max(0, component.GridX);
        component.GridY = Math.Max(0, component.GridY);

        // Ensure GridWidth and GridHeight are at least 1
        component.GridWidth = Math.Max(1, component.GridWidth);
        component.GridHeight = Math.Max(1, component.GridHeight);

        // Ensure GridWidth doesn't exceed 12
        component.GridWidth = Math.Min(12, component.GridWidth);

        // Ensure IsVisible is set
        component.IsVisible = true;
    }

