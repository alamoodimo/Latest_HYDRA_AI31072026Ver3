        await Task.Delay(300);

        if (!string.IsNullOrEmpty(newComponent.QueryText))
        {
            isComponentLoading[newComponent.ComponentID] = false;
            await LoadComponentDataAsync(newComponent);
            await Task.Delay(300); // Wait for data to load

