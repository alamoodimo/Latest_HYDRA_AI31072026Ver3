    private string GetChartType(string visualizationConfig)
    {
        if (string.IsNullOrEmpty(visualizationConfig))
            return "Bar";

        try
        {
            var config = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(visualizationConfig);
            if (config != null && config.ContainsKey("chartType"))
            {
                var chartType = config["chartType"].GetString();
                return chartType switch
                {
                    "bar" => "Bar",
                    "line" => "Line",
                    "pie" => "Pie",
                    "donut" => "Donut",
                    "area" => "Area",
                    _ => "Bar"
                };
            }
        }
        catch { }

        return "Bar";
    }

