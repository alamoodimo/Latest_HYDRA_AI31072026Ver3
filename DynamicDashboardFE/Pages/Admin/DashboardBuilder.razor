    /// <summary>
    /// Footer under a table card: explains when not all rows are shown, either because the card
    /// shows at most MaxTableRowsDisplayed rows or because the server stopped at Query:MaxResultRows.
    /// </summary>
    private string GetTableFooterText(int componentId)
    {
        var rowCount = GetComponentData(componentId).Count;
        var shown = Math.Min(rowCount, maxTableRowsDisplayed);

        if (serverRowLimits.TryGetValue(componentId, out var rowLimit))
        {
            return $"Showing {shown:N0} of the first {rowLimit:N0} rows (server row limit reached)";
        }

        return rowCount > maxTableRowsDisplayed
            ? $"Showing the first {shown:N0} of {rowCount:N0} rows"
            : string.Empty;
    }

