    private bool isRenderingCharts = false; // Add this state variable

    private async Task LoadAllComponentsData()
    {
        if (dashboard?.Components == null || !dashboard.Components.Any())
        {
            ToastService.ShowWarning("No components to load");
            return;
        }

        if (dashboard.DatabaseID <= 0)
        {
            ToastService.ShowError("Please select a database first");
            return;
        }

        isLoadingAllData = true;


        try
        {
            foreach (var component in dashboard.Components)
            {
                if (!isComponentLoading.ContainsKey(component.ComponentID))
                    isComponentLoading[component.ComponentID] = false;
            }

            var tasks = dashboard.Components
                .Where(c => !string.IsNullOrEmpty(c.QueryText) && c.DataViewingTypeID != (int)DataViewingTypeEnum.Label)
                .Select(c => LoadComponentDataAsync(c))
                .ToList();

            if (!tasks.Any())
            {
                ToastService.ShowWarning("No components have SQL queries");
                return;
            }

            await Task.WhenAll(tasks);



            // Only render charts if we're not already rendering
            if (!isRenderingCharts)
            {
                isRenderingCharts = true;
                await Task.Delay(200);
                await RenderAllCharts();
                isRenderingCharts = false;
            }
            StateHasChanged();
            ToastService.ShowSuccess($"Loaded data for {tasks.Count} component(s)");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");

        }
        finally
        {
            isLoadingAllData = false;
            isRenderingCharts = false;

        }
    }

    private async Task LoadComponentDataAsync(DashboardComponent component)
    {
        if (string.IsNullOrEmpty(component.QueryText)) return;

        isComponentLoading[component.ComponentID] = true;
        StateHasChanged();

        try
        {
            var request = new SqlExecutionRequest
            {
                OriginalQuestion = "",
                DatabaseId = dashboard.DatabaseID,
                Sql = component.QueryText
            };

            var response = await Http.PostAsJsonAsync("api/query/execute", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<QueryExecutionResult>();
                componentData[component.ComponentID] = result?.Success == true && result.Results != null
                    ? result.Results
                    : new List<Dictionary<string, object>>();
            }
            else
            {
                componentData[component.ComponentID] = new List<Dictionary<string, object>>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data for {component.ComponentID}: {ex.Message}");
            componentData[component.ComponentID] = new List<Dictionary<string, object>>();
        }
        finally
        {
            isComponentLoading[component.ComponentID] = false;
            StateHasChanged();
        }
    }

