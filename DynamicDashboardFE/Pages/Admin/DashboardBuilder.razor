    private (int GridX, int GridY) FindNextEmptyPosition(int width, int height)
    {
        const int maxColumns = 12;

        if (dashboard?.Components == null || !dashboard.Components.Any())
            return (0, 0);

        int maxY = dashboard.Components.Max(c => c.GridY + c.GridHeight) + height + 10;
        bool[,] occupied = new bool[maxColumns, maxY];

        foreach (var comp in dashboard.Components)
        {
            for (int x = comp.GridX; x < Math.Min(comp.GridX + comp.GridWidth, maxColumns); x++)
            {
                for (int y = comp.GridY; y < Math.Min(comp.GridY + comp.GridHeight, maxY); y++)
                {
                    occupied[x, y] = true;
                }
            }
        }

        for (int y = 0; y < maxY; y++)
        {
            for (int x = 0; x <= maxColumns - width; x++)
            {
                bool canFit = true;
                for (int cx = x; cx < x + width && canFit; cx++)
                {
                    for (int cy = y; cy < y + height && cy < maxY && canFit; cy++)
                    {
                        if (occupied[cx, cy]) canFit = false;
                    }
                }
                if (canFit) return (x, y);
            }
        }

        return (0, dashboard.Components.Max(c => c.GridY + c.GridHeight));
    }

    private string GenerateTitleFromQuestion(string question)
    {
        var words = question.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(6)
            .Select(w => char.ToUpper(w[0]) + (w.Length > 1 ? w.Substring(1).ToLower() : ""));
        var title = string.Join(" ", words).TrimEnd('.', '?', '!');
        return title.Length > 50 ? title.Substring(0, 47) + "..." : title;
    }

