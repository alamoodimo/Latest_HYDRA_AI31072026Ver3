<script suppress-error="BL9992">
     window.registerKeyboardHandler = function(dotNetHelper) {
        document.addEventListener('keydown', function(e) {
            // Skip if typing in input or textarea
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
                return;
            }

            // Arrow keys - Move/Resize
            if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
                e.preventDefault();
                dotNetHelper.invokeMethodAsync('OnArrowKey', e.key, e.shiftKey, e.ctrlKey);
                return;
            }

            // Tab - Cycle components
            if (e.key === 'Tab') {
                e.preventDefault();
                dotNetHelper.invokeMethodAsync('OnTabKey', e.shiftKey);
                return;
            }

            // Escape - Deselect
            if (e.key === 'Escape') {
                dotNetHelper.invokeMethodAsync('OnEscapeKey');
                return;
            }

            // Delete - Remove component
            if (e.key === 'Delete' || (e.key === 'Backspace' && !e.target.isContentEditable)) {
                e.preventDefault();
                dotNetHelper.invokeMethodAsync('OnDeleteKey');
                return;
            }

            // Ctrl+D - Duplicate
            if ((e.ctrlKey || e.metaKey) && e.key === 'd') {
                e.preventDefault();
                dotNetHelper.invokeMethodAsync('OnDuplicateKey');
                return;
            }

            // Ctrl+S - Save
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                dotNetHelper.invokeMethodAsync('OnSaveKey');
                return;
            }
        });

        console.log('⌨️ Keyboard handler registered');
    };

    // ============================================
    // ELEMENT BOUNDS HELPER
    // ============================================
    window.getElementBounds = function(element) {
        if (!element) return null;
        const rect = element.getBoundingClientRect();
        return {
            left: rect.left,
            top: rect.top,
            width: rect.width,
            height: rect.height,
            scrollLeft: element.scrollLeft || 0,
            scrollTop: element.scrollTop || 0
        };
    };


