    /// <summary>
    /// Clears all per-component state of the current dashboard (data, errors, loading flags,
    /// selection, table paging and drawn charts). Needed before showing another dashboard,
    /// because component IDs repeat between dashboards (generated ones are always 1..N).
    /// </summary>
    private async Task ResetComponentStateAsync()
    {
        componentData.Clear();
        componentErrors.Clear();
        serverRowLimits.Clear();
        isComponentLoading.Clear();
        isRegenerating.Clear();
        aiWork.Clear();
        aiFixMessages.Clear();
        StopAiWorkTickerIfIdle();
        tableCurrentPage.Clear();
        tablePageSizeDict.Clear();
        tableSearchQueryDict.Clear();
        pendingChartRenders.Clear();
        pendingChartDestroys.Clear();

        selectedComponentId = 0;
        isEditingSql = false;
        isKeyboardMoveMode = false;
        lastKeyboardAction = "";
        canvasKey++;

        try
        {
            await JSRuntime.InvokeVoidAsync("DashboardCharts.destroyAll");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Previous charts could not be released: {ex.Message}");
        }
    }

    /// <summary>
    /// After the first save the API returns the dashboard with database-assigned component IDs.
    /// Moves each component's loaded data or error to its new ID (matched by position, size and
    /// SQL), so nothing has to be queried again; components that cannot be matched are reloaded.
    /// </summary>
    private async Task RemapComponentStateAfterSaveAsync(List<DashboardComponent> previousComponents, DashboardModel savedDashboard)
    {
        var previousData = new Dictionary<int, List<Dictionary<string, object>>>(componentData);
        var previousErrors = new Dictionary<int, string>(componentErrors);
        var previousRowLimits = new Dictionary<int, int>(serverRowLimits);

        await ResetComponentStateAsync();
        dashboard = savedDashboard;

        var componentsToReload = new List<DashboardComponent>();

        foreach (var saved in dashboard.Components ?? new List<DashboardComponent>())
        {
            var previous = previousComponents.FirstOrDefault(p =>
                p.GridX == saved.GridX && p.GridY == saved.GridY &&
                p.GridWidth == saved.GridWidth && p.GridHeight == saved.GridHeight &&
                string.Equals(p.QueryText ?? "", saved.QueryText ?? "", StringComparison.Ordinal));

            if (previous != null && previousData.TryGetValue(previous.ComponentID, out var rows))
            {
                componentData[saved.ComponentID] = rows;
                if (previousRowLimits.TryGetValue(previous.ComponentID, out var rowLimit))
                {
                    serverRowLimits[saved.ComponentID] = rowLimit;
                }
            }
            else if (previous != null && previousErrors.TryGetValue(previous.ComponentID, out var error))
            {
                componentErrors[saved.ComponentID] = error;
            }
            else if (!string.IsNullOrWhiteSpace(saved.QueryText))
            {
                componentsToReload.Add(saved);
            }
        }

        QueueAllChartRenders();
        StateHasChanged();

        foreach (var component in componentsToReload)
        {
            await LoadComponentDataAsync(component);
        }
    }

