            scrollLeft: element.scrollLeft || 0,
            scrollTop: element.scrollTop || 0
        };
    };

    window.renderDynamicChart = function(componentId, chartType, data, title) {
        const container = document.querySelector(`#chart-${componentId}`);
        if (!container || !data || data.length === 0) {
            console.log(`Chart ${componentId}: No container or data`);
            return;
        }

        const columns = Object.keys(data[0]);
        const xColumn = columns[0];
        const yColumn = columns[1];
        const categories = data.map(row => row[xColumn]);
        const values = data.map(row => parseFloat(row[yColumn]) || 0);

        let options;
        const colors = ['#667EEA', '#48BB78', '#F6AD55', '#9F7AEA', '#FC8181', '#14B8A6', '#8B5CF6'];

        switch(chartType.toLowerCase()) {
            case 'pie':
            case 'donut':
                options = {
                    series: values,
                    chart: { id: `chart-${componentId}`, type: chartType, height: '100%' },
                    labels: categories,
                    colors: colors,
                    legend: { show: true, position: 'bottom', fontSize: '14px' },
                    dataLabels: { enabled: true, formatter: val => val.toFixed(1) + "%" },
                    plotOptions: { pie: { donut: { size: chartType === 'donut' ? '65%' : '0%' } } }
                };
                break;
            case 'line':
            case 'area':
                options = {
                    series: [{ name: yColumn, data: values }],
                    chart: { id: `chart-${componentId}`, type: chartType, height: '100%', toolbar: { show: true } },
                    stroke: { curve: 'smooth', width: 3 },
                    xaxis: { categories: categories },
                    yaxis: { min: 0 },
                    colors: ['#667EEA'],
                    fill: { type: chartType === 'area' ? 'gradient' : 'solid', gradient: { opacityFrom: 0.5, opacityTo: 0.1 } },
                    legend: { show: true, position: 'top' }
                };
                break;
            default:
                options = {
                    series: [{ name: yColumn, data: values }],
                    chart: { id: `chart-${componentId}`, type: 'bar', height: '100%', toolbar: { show: true } },
                    plotOptions: { bar: { borderRadius: 6, columnWidth: '60%' } },
                    dataLabels: { enabled: true, offsetY: -20, style: { fontSize: '12px', colors: ['#304758'] } },
                    xaxis: { categories: categories },
                    yaxis: { min: 0 },
                    colors: ['#667EEA'],
                    legend: { show: false }
                };
        }

        const existingChart = ApexCharts.getChartByID(`chart-${componentId}`);
        if (existingChart) existingChart.destroy();

        const chart = new ApexCharts(container, options);
        chart.render();
    };
</script>