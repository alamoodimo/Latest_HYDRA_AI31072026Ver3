    /// (drag-over fires many times per second).
    /// </summary>
    protected override bool ShouldRender()
    {
        if (skipNextRender)
        {
            skipNextRender = false;
            return false;
        }
        return true;
    }

    /// <summary>
    /// Releases JavaScript resources when leaving the page: keyboard shortcuts, an active
    /// mouse resize, and every chart drawn by this page.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("unregisterKeyboardHandler");
            await JSRuntime.InvokeVoidAsync("removeResizeListeners");
            await JSRuntime.InvokeVoidAsync("DashboardCharts.destroyAll");
        }
        catch (JSDisconnectedException)
        {
            // The page is unloading; nothing left to clean up.
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Builder cleanup: {ex.Message}");
        }

        dotNetRef?.Dispose();
        aiWorkTicker?.Dispose();
        aiWorkTicker = null;
    }

