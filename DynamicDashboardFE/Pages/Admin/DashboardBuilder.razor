    // Add to your state variables
    private Dictionary<int, List<int>> componentOccupancyMap = new Dictionary<int, List<int>>();
    private bool showGridLines = true;
    private int gridSnapSize = 1;

    // Enhanced: Calculate Grid Position with Snap-to-Grid
    private async Task<(int X, int Y)> CalculateGridPosition(MouseEventArgs e, bool snapToGrid = true)
    {
        try
        {
            var bounds = await JSRuntime.InvokeAsync<CanvasBounds>("getElementBounds", canvasRef);

            if (bounds == null)
            {
                Console.WriteLine("⚠️ Could not get canvas bounds");
                return (0, 0);
            }

            // Calculate relative position within canvas
            double relativeX = e.ClientX - bounds.Left;
            double relativeY = e.ClientY - bounds.Top;

            // Account for scroll position
            relativeX += bounds.ScrollLeft;
            relativeY += bounds.ScrollTop;

            // Calculate column width (12 column grid)
            double colWidth = bounds.Width / 12.0;
            double rowHeight = 100.0;

            // Calculate grid position
            int gridX = (int)Math.Floor(relativeX / colWidth);
            int gridY = (int)Math.Floor(relativeY / rowHeight);

            // Snap to grid if enabled
            if (snapToGrid && gridSnapSize > 1)
            {
                gridX = (int)(Math.Round((double)gridX / gridSnapSize) * gridSnapSize);
                gridY = (int)(Math.Round((double)gridY / gridSnapSize) * gridSnapSize);
            }

            // Clamp to valid range
            gridX = Math.Max(0, Math.Min(gridX, 12 - dropIndicatorWidth));
            gridY = Math.Max(0, gridY);

            return (gridX, gridY);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error calculating position: {ex.Message}");
            return (0, 0);
        }
    }

    // NEW: Check if position is available for component placement
    private bool CanPlaceComponentAtPosition(int gridX, int gridY, int width, int height, int? excludeComponentId = null)
    {
        if (dashboard.Components == null || !dashboard.Components.Any())
            return true;

        // Build occupancy map if not already built
        UpdateOccupancyMap();

        for (int x = gridX; x < gridX + width && x < 12; x++)
        {
            for (int y = gridY; y < gridY + height; y++)
            {
                if (componentOccupancyMap.ContainsKey(y))
                {
                    if (componentOccupancyMap[y].Contains(x))
                    {
                        // Check if this cell is occupied by the excluded component
                        if (!IsCellOccupiedByComponent(x, y, excludeComponentId))
                        {
                            return false;
                        }
                    }
                }
            }
        }

        return true;
    }

    // NEW: Check if cell is occupied by specific component
    private bool IsCellOccupiedByComponent(int x, int y, int? componentId)
    {
        if (!componentId.HasValue || dashboard.Components == null)
            return false;

        var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == componentId.Value);
        if (component == null)
            return false;

        return x >= component.GridX && x < component.GridX + component.GridWidth &&
               y >= component.GridY && y < component.GridY + component.GridHeight;
    }

    // NEW: Update occupancy map
    private void UpdateOccupancyMap()
    {
        componentOccupancyMap.Clear();

        if (dashboard.Components == null)
            return;

        foreach (var component in dashboard.Components)
        {
            for (int y = component.GridY; y < component.GridY + component.GridHeight; y++)
            {
                if (!componentOccupancyMap.ContainsKey(y))
                    componentOccupancyMap[y] = new List<int>();

                for (int x = component.GridX; x < component.GridX + component.GridWidth && x < 12; x++)
                {
                    if (!componentOccupancyMap[y].Contains(x))
                        componentOccupancyMap[y].Add(x);
                }
            }
        }
    }

    private bool isResizing = false;
