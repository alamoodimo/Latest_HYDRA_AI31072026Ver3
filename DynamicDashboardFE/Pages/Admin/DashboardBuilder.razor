    /// <summary>
    /// Runs the SQL of every component that has a query (at most MaxParallelDataLoads at a time).
    /// Each component then shows its result, "No rows returned", or the real error.
    /// </summary>
    private async Task LoadAllComponentsData()
    {
        if (dashboard?.Components == null || !dashboard.Components.Any())
        {
            ToastService.ShowWarning("No components to load");
            return;
        }

        if (dashboard.DatabaseID <= 0)
        {
            ToastService.ShowError("Please select a database first");
            return;
        }

        var componentsWithSql = dashboard.Components
            .Where(c => !string.IsNullOrWhiteSpace(c.QueryText) && c.DataViewingTypeID != (int)DataViewingTypeEnum.Label)
            .ToList();

        if (!componentsWithSql.Any())
        {
            ToastService.ShowWarning("No components have SQL queries");
            return;
        }

        isLoadingAllData = true;
        StateHasChanged();

        try
        {
            using var throttler = new SemaphoreSlim(maxParallelDataLoads);

            var loadTasks = componentsWithSql.Select(async component =>
            {
                await throttler.WaitAsync();
                try
                {
                    await LoadComponentDataAsync(component);
                }
                finally
                {
                    throttler.Release();
                }
            }).ToList();

            await Task.WhenAll(loadTasks);

            var failedCount = componentsWithSql.Count(c => componentErrors.ContainsKey(c.ComponentID));
            if (failedCount == 0)
            {
                ToastService.ShowSuccess($"Loaded data for {componentsWithSql.Count} component(s)");
            }
            else
            {
                ToastService.ShowWarning($"Loaded {componentsWithSql.Count - failedCount} of {componentsWithSql.Count} component(s). " +
                                         $"{failedCount} failed - each failed card shows the reason and a \"Fix with AI\" option.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isLoadingAllData = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Runs one component's SQL. On success the rows are stored (and a chart is queued for drawing);
    /// on failure the real error message is stored in componentErrors and shown on the card.
    /// </summary>
    private async Task LoadComponentDataAsync(DashboardComponent component)
    {
        if (component == null) return;

        var componentId = component.ComponentID;

        if (string.IsNullOrWhiteSpace(component.QueryText))
        {
            componentData.Remove(componentId);
            componentErrors.Remove(componentId);
            return;
        }

        if (dashboard.DatabaseID <= 0)
        {
            componentErrors[componentId] = "Choose a database for this dashboard first (Dashboard Settings).";
            StateHasChanged();
            return;
        }

        isComponentLoading[componentId] = true;
        componentErrors.Remove(componentId);
        StateHasChanged();

        try
        {
            var request = new SqlExecutionRequest
            {
                OriginalQuestion = "",
                DatabaseId = dashboard.DatabaseID,
                Sql = component.QueryText
            };

            using var response = await Http.PostAsJsonAsync("api/query/execute", request);
            var result = await QueryResultHelper.ReadQueryExecutionResponseAsync(response);

            if (result.Success)
            {
                componentData[componentId] = result.Results ?? new List<Dictionary<string, object>>();

                if (componentData[componentId].Count > 0)
                {
                    aiFixMessages.Remove(componentId);
                }

                if (result.IsTruncated && result.RowLimit.HasValue)
                {
                    serverRowLimits[componentId] = result.RowLimit.Value;
                }
                else
                {
                    serverRowLimits.Remove(componentId);
                }
            }
            else
            {
                componentData.Remove(componentId);
                serverRowLimits.Remove(componentId);
                componentErrors[componentId] = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            componentData.Remove(componentId);
            serverRowLimits.Remove(componentId);
            componentErrors[componentId] = $"Could not load data: {ex.Message}";
        }
        finally
        {
            isComponentLoading[componentId] = false;

            if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
            {
                QueueChartRender(componentId);
            }

            StateHasChanged();
        }
    }

    /// <summary>Loads data for every component with SQL when the dashboard has a database.</summary>
    private async Task AutoLoadDashboardDataAsync()
    {
        if (dashboard?.DatabaseID > 0 &&
            dashboard.Components?.Any(c => !string.IsNullOrWhiteSpace(c.QueryText)) == true)
        {
