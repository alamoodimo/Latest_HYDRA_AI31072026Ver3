    private async Task RenderChart(DashboardComponent component)
    {
        try
        {
            if (!componentData.ContainsKey(component.ComponentID)) return;

            var data = componentData[component.ComponentID];
            if (data == null || !data.Any()) return;

            var chartType = component.ChartType?.ToLower() ?? "bar";

            await JSRuntime.InvokeVoidAsync("renderDynamicChart",
                component.ComponentID,
                chartType,
                data,
                component.Title);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering chart {component.ComponentID}: {ex.Message}");
        }
    }

