    /// <summary>
    /// Handles arrow key press for moving/resizing components
    /// </summary>
    [JSInvokable]
    public async Task OnArrowKey(string direction, bool shiftKey, bool ctrlKey)
    {
        if (selectedComponentId == 0 || selectedComponent == null)
        {
            return;
        }

        if (isPreviewMode)
        {
            return;
        }

        int step = ctrlKey ? 3 : 1; // Fast move with Ctrl

        if (shiftKey)
        {
            // RESIZE MODE
            await ResizeComponentWithKeyboard(direction, step);
        }
        else
        {
            // MOVE MODE
            await MoveComponentWithKeyboard(direction, step);
        }
    }

    /// <summary>
    /// Moves the selected component in the specified direction
    /// </summary>
    private async Task MoveComponentWithKeyboard(string direction, int step)
    {
        if (selectedComponent == null) return;

        int newX = selectedComponent.GridX;
        int newY = selectedComponent.GridY;

        switch (direction.ToLower())
        {
            case "arrowleft":
            case "left":
                newX = Math.Max(0, selectedComponent.GridX - step);
                break;
            case "arrowright":
            case "right":
                newX = Math.Min(12 - selectedComponent.GridWidth, selectedComponent.GridX + step);
                break;
            case "arrowup":
            case "up":
                newY = Math.Max(0, selectedComponent.GridY - step);
                break;
            case "arrowdown":
            case "down":
                newY = selectedComponent.GridY + step;
                break;
        }

        // Check if position actually changed
        if (newX != selectedComponent.GridX || newY != selectedComponent.GridY)
        {
            selectedComponent.GridX = newX;
            selectedComponent.GridY = newY;
            selectedComponent.LastUpdated = DateTime.UtcNow;

            hasUnsavedChanges = true;
            isKeyboardMoveMode = true;
            lastKeyboardAction = $"Moved to ({newX}, {newY})";

            // Force re-render
            canvasKey++;
            StateHasChanged();

            // Re-render chart if needed
            if (selectedComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Chart &&
                componentData.ContainsKey(selectedComponent.ComponentID))
            {
                //await Task.Delay(100);
                //await RenderChart(selectedComponent);
            }

            Console.WriteLine($"⌨️ Moved '{selectedComponent.Title}' to ({newX}, {newY})");
        }
    }

    /// <summary>
    /// Resizes the selected component in the specified direction
    /// </summary>
    private async Task ResizeComponentWithKeyboard(string direction, int step)
    {
        if (selectedComponent == null) return;

        int newWidth = selectedComponent.GridWidth;
        int newHeight = selectedComponent.GridHeight;

        switch (direction.ToLower())
        {
            case "arrowleft":
            case "left":
                newWidth = Math.Max(1, selectedComponent.GridWidth - step);
                break;
            case "arrowright":
            case "right":
                // Ensure doesn't exceed grid boundary
                newWidth = Math.Min(12 - selectedComponent.GridX, selectedComponent.GridWidth + step);
                break;
            case "arrowup":
            case "up":
                newHeight = Math.Max(1, selectedComponent.GridHeight - step);
                break;
            case "arrowdown":
            case "down":
                newHeight = selectedComponent.GridHeight + step;
                break;
        }

        // Check if size actually changed
        if (newWidth != selectedComponent.GridWidth || newHeight != selectedComponent.GridHeight)
        {
            selectedComponent.GridWidth = newWidth;
            selectedComponent.GridHeight = newHeight;
            selectedComponent.LastUpdated = DateTime.UtcNow;

            hasUnsavedChanges = true;
            isKeyboardMoveMode = true;
            lastKeyboardAction = $"Resized to {newWidth}×{newHeight}";

            // Force re-render
            canvasKey++;
            StateHasChanged();

            // Re-render chart if needed
            if (selectedComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Chart &&
                componentData.ContainsKey(selectedComponent.ComponentID))
            {
                //await Task.Delay(150);
                //await RenderChart(selectedComponent);
            }

            Console.WriteLine($"⌨️ Resized '{selectedComponent.Title}' to {newWidth}×{newHeight}");
        }
    }

    /// <summary>
    /// Cycles to the next component (Tab key)
    /// </summary>
    [JSInvokable]
    public void OnTabKey(bool shiftKey)
    {
        if (dashboard?.Components == null || !dashboard.Components.Any())
        {
            return;
        }

        if (isPreviewMode)
        {
            return;
        }

        var components = dashboard.Components.OrderBy(c => c.GridY).ThenBy(c => c.GridX).ToList();

        if (selectedComponentId == 0)
        {
            // Select first component
            SelectComponent(components.First().ComponentID);
        }
        else
        {
            int currentIndex = components.FindIndex(c => c.ComponentID == selectedComponentId);
            int nextIndex;

            if (shiftKey)
            {
                // Previous component
                nextIndex = currentIndex <= 0 ? components.Count - 1 : currentIndex - 1;
            }
            else
            {
                // Next component
                nextIndex = (currentIndex + 1) % components.Count;
            }

            SelectComponent(components[nextIndex].ComponentID);
        }

        StateHasChanged();
    }

