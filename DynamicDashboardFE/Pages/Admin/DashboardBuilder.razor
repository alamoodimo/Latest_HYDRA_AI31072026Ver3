                {
                    customChartExplanation = chartExplanation.Explanation;
                    analysisResponse = new AnalysisResponse { Explanation = chartExplanation.Explanation, Success = true };

                    if (string.IsNullOrWhiteSpace(customChartTitle))
                    {
                        customChartTitle = GenerateTitleFromQuestion(customChartQuery);
                    }

                    addChartStep = 2;
                    ToastService.ShowSuccess("Query analyzed!");
                }
                else
                {
                    ToastService.ShowError(chartExplanation?.ErrorMessage ?? "Failed to analyze query");
                }
            }
            else
            {
                ToastService.ShowError("Failed to analyze query");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }

    private async Task GenerateSqlAndAddComponent()
    {
        if (string.IsNullOrWhiteSpace(customChartTitle))
        {
            ToastService.ShowWarning("Please enter a component title");
            return;
        }

        isGeneratingSql = true;
        StateHasChanged();

        try
        {
            var request = new NlQueryConfirmationRequest
            {
                OriginalQuestion = customChartQuery,
                DatabaseId = dashboard.DatabaseID,
                ConfirmedUnderstanding = analysisResponse?.Explanation ?? "",
                ResolvedAmbiguities = new Dictionary<string, string>(),
                AdjustedParameters = new Dictionary<string, string>()
            };

            var response = await Http.PostAsJsonAsync("api/query/generate", request);

            if (response.IsSuccessStatusCode)
            {
                var sqlResponse = await response.Content.ReadFromJsonAsync<SqlGenerationResponse>();

                if (sqlResponse != null && sqlResponse.Success)
                {
                    customChartSql = sqlResponse.GeneratedSql;
                    await AddCustomComponentToDashboard();
                    addChartStep = 3;
                    ToastService.ShowSuccess($"{GetComponentTypeName(selectedComponentTypeForCustom)} added!");
                }
                else
                {
                    ToastService.ShowError("Failed to generate SQL");
                }
            }
            else
            {
                ToastService.ShowError("Failed to generate SQL");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isGeneratingSql = false;
            StateHasChanged();
        }
    }

    private async Task AddCustomComponentToDashboard()
    {
        // Determine default size based on component type
        int width, height;
        switch (selectedComponentTypeForCustom)
        {
            case 1: // Table
                width = 6; height = 4;
                break;
            case 3: // KPI
                width = 3; height = 2;
                break;
            case 4: // Chart
                width = 6; height = 4;
                break;
            default:
                width = 4; height = 3;
                break;
        }

        var (x, y) = FindNextEmptyPosition(width, height);

        var newComponent = new DashboardComponent
        {
            ComponentID = dashboard.Components.Any() ? dashboard.Components.Max(c => c.ComponentID) + 1 : 1,
            Title = customChartTitle,
            Description = customChartExplanation,
            QueryText = customChartSql,
            QueryIntent = customChartQuery,
            DataViewingTypeID = selectedComponentTypeForCustom,
            ChartType = selectedComponentTypeForCustom == 4 ? customChartType : null, // Only set for charts
            GridX = x,
            GridY = y,
            GridWidth = width,
            GridHeight = height,
            VisualizationConfig = BuildVisualizationConfig(), // Build config based on type
            FilterExpression = "",
            IsAIGenerated = true,
            IsVisible = true,
            CreatedAt = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow
        };

        dashboard.Components.Add(newComponent);
        hasUnsavedChanges = true;
        StateHasChanged();

        // Loading the data also queues the chart drawing (see LoadComponentDataAsync).
        if (!string.IsNullOrEmpty(newComponent.QueryText))
        {
            await LoadComponentDataAsync(newComponent);
        }
    }

    // Helper method to build visualization config
    private string BuildVisualizationConfig()
    {
        var config = new Dictionary<string, object>();

        if (selectedComponentTypeForCustom == 3) // KPI
        {
            config["numberFormat"] = kpiNumberFormat;
            config["decimalPlaces"] = kpiDecimalPlaces;
            config["prefix"] = kpiPrefix;
            config["suffix"] = kpiSuffix;
