@page "/dashboard/builder"
@page "/dashboard/builder/{DashboardId:int}"
@using DynamicDashboardCommon.Models
@using DynamicDashboardCommon.Enums

@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IToastService ToastService
@inject IConfiguration Configuration
@using Microsoft.Extensions.Configuration
@using DynamicDashboardCommon.Helper
@implements IAsyncDisposable

<PageTitle>Dashboard Builder</PageTitle>

<div class="dashboard-builder">
    <!-- ============================================ -->
    <!-- HEADER SECTION -->
    <!-- ============================================ -->
    <!-- ============================================ -->
    <!-- HEADER SECTION -->
    <!-- ============================================ -->
     <!-- ================New Header Claude 25 9 2026============================ -->
    <!-- ============================================ -->
    <!-- HEADER: two rows so controls never overlap    -->
    <!-- Row 1: identity + primary actions             -->
    <!-- Row 2: tool strip (data/view, zoom, grid,     -->
    <!--        layout). bh-* classes avoid the global -->
    <!--        .btn padding/margin from app.css.      -->
    <!-- ============================================ -->
    <div class="builder-header bh-header">
        <div class="bh-row bh-row-main">
            <div class="bh-identity">
                <div class="bh-identity-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="bh-identity-text">
                    <div class="bh-title-line">
                        <h5 class="bh-title" title="@(dashboard?.Title ?? "Untitled Dashboard")">@(dashboard?.Title ?? "Untitled Dashboard")</h5>
                        @if (dashboard != null)
                        {
                            @if (dashboard.DashboardID > 0 && !hasUnsavedChanges)
                            {
                                <span class="bh-status bh-status-saved">
                                    <i class="fas fa-check-circle"></i>Saved
                                </span>
                            }
                            else
                            {
                                <span class="bh-status bh-status-unsaved">
                                    <i class="fas fa-circle"></i>Unsaved
                                </span>
                            }
                        }
                    </div>
                    <button type="button"
                            class="bh-db-chip @(dashboard?.DatabaseID > 0 ? "" : "is-missing")"
                            @onclick="ShowDashboardSettings"
                            title="Change dashboard title, description and database">
                        <i class="fas fa-database"></i>
                        <span class="bh-db-chip-text">@GetDashboardDatabaseName()</span>
                        <i class="fas fa-pen bh-db-chip-edit"></i>
                    </button>
                </div>
            </div>

            <div class="bh-primary-actions">
                <button type="button" class="bh-btn bh-btn-ai" @onclick="ShowTemplateModal"
                        title="Generate a complete dashboard from a template">
                    <i class="fas fa-magic bh-sparkle"></i>
                    <span class="bh-btn-text">AI Generate Dashboard</span>
                </button>
                <button type="button" class="bh-btn bh-btn-light" @onclick="ShowAddComponentModal"
                        title="@(dashboard?.DatabaseID > 0 ? "Describe a component and let AI build it" : "Choose a database first")">
                    <i class="fas fa-robot"></i>
                    <span class="bh-btn-text">AI Create Component</span>
                </button>
                <span class="bh-divider" aria-hidden="true"></span>
                <button type="button" class="bh-btn bh-btn-save" @onclick="SaveDashboard" disabled="@(!CanSave())"
                        title="@(CanSave() ? "Save dashboard (Ctrl+S)" : "Add a title and choose a database to save")">
                    <i class="fas fa-save"></i>
                    <span class="bh-btn-text">Save</span>
                </button>
                <button type="button" class="bh-icon-btn bh-icon-btn-danger" @onclick="CloseDashboard" title="Close Dashboard Builder">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        @if (dashboard != null)
        {
            var hasComponents = dashboard.Components != null && dashboard.Components.Any();

            <div class="bh-row bh-row-tools">
                <!-- Data & view -->
                <div class="bh-tool-group" role="group" aria-label="Data and view">
                    @if (hasComponents && dashboard.DatabaseID > 0)
                    {
                        <button type="button" class="bh-tool" @onclick="LoadAllComponentsData" disabled="@isLoadingAllData"
                                title="Load data for all components">
                            @if (isLoadingAllData)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                <span class="bh-btn-text">Loading...</span>
                            }
                            else
                            {
                                <i class="fas fa-play"></i>
                                <span class="bh-btn-text">Load Data</span>
                            }
                        </button>
                    }
                    <button type="button" class="bh-tool @(isPreviewMode ? "is-active" : "")" @onclick="TogglePreviewMode"
                            disabled="@(!hasComponents)"
                            title="@(isPreviewMode ? "Switch to Design Mode" : "Preview Dashboard")">
                        <i class="fas fa-@(isPreviewMode ? "edit" : "eye")"></i>
                        <span class="bh-btn-text">@(isPreviewMode ? "Design" : "Preview")</span>
                    </button>
                </div>

                @if (!isPreviewMode)
                {
                    <!-- Zoom -->
                    <div class="bh-tool-group" role="group" aria-label="Zoom">
                        <button type="button" class="bh-tool bh-tool-icon" @onclick="ZoomOut" disabled="@(zoomLevel <= 0.5)" title="Zoom Out">
                            <i class="fas fa-search-minus"></i>
                        </button>
                        <span class="bh-zoom-value" title="Current Zoom Level">@((int)Math.Round(zoomLevel * 100))%</span>
                        <button type="button" class="bh-tool bh-tool-icon" @onclick="ZoomIn" disabled="@(zoomLevel >= 1.5)" title="Zoom In">
                            <i class="fas fa-search-plus"></i>
                        </button>
                        <button type="button" class="bh-tool bh-tool-icon" @onclick="ResetZoom" title="Reset Zoom to 100%">
                            <i class="fas fa-compress-arrows-alt"></i>
                        </button>
                    </div>

                    <!-- Grid -->
                    <div class="bh-tool-group" role="group" aria-label="Grid">
                        <button type="button" class="bh-tool bh-tool-icon @(showGridLines ? "is-active" : "")" @onclick="ToggleGridLines"
                                title="@(showGridLines ? "Hide Grid Lines" : "Show Grid Lines")">
                            <i class="fas fa-th"></i>
                        </button>
                        <div class="dropdown">
                            <button type="button" class="bh-tool dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Grid Snap Settings">
                                <i class="fas fa-magnet"></i>
                                <span class="bh-btn-text">@(gridSnapSize == 1 ? "No snap" : $"Snap {gridSnapSize}×")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end bh-dropdown">
                                <li><button type="button" class="dropdown-item @(gridSnapSize == 1 ? "active" : "")" @onclick="() => SetGridSnapSize(1)">No Snap</button></li>
                                <li><button type="button" class="dropdown-item @(gridSnapSize == 2 ? "active" : "")" @onclick="() => SetGridSnapSize(2)">2× Grid</button></li>
                                <li><button type="button" class="dropdown-item @(gridSnapSize == 3 ? "active" : "")" @onclick="() => SetGridSnapSize(3)">3× Grid</button></li>
                            </ul>
                        </div>
                    </div>
                }

                <!-- Layout & help (pushed to the right) -->
                <div class="bh-tool-group bh-tool-group-end" role="group" aria-label="Layout and help">
                    @if (!isPreviewMode)
                    {
                        <button type="button" class="bh-tool" @onclick="ToggleSidebar" title="@(showSidebar ? "Hide Components Panel" : "Show Components Panel")">
                            <i class="fas fa-@(showSidebar ? "chevron-left" : "chevron-right")"></i>
                            <span class="bh-btn-text">@(showSidebar ? "Hide Panel" : "Components")</span>
                        </button>
                        @if (hasComponents)
                        {
                            <button type="button" class="bh-tool bh-tool-icon" @onclick="AutoArrangeComponents" title="Auto Arrange Components">
                                <i class="fas fa-border-all"></i>
                            </button>
                        }
                    }
                    <button type="button" class="bh-tool bh-tool-icon" @onclick="ShowDashboardSettings" title="Dashboard Settings">
                        <i class="fas fa-cog"></i>
                    </button>
                    <button type="button" class="bh-tool bh-tool-icon" @onclick="ShowKeyboardShortcuts" title="Keyboard Shortcuts">
                        <i class="fas fa-keyboard"></i>
                    </button>
                </div>
            </div>
        }
    </div>
    <!-- =====================Old header before claude======================= -->
