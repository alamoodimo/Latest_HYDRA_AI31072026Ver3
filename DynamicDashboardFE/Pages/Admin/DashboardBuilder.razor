    private bool showKeyboardShortcutsModal = false;

    private void ShowKeyboardShortcuts()
    {
        showKeyboardShortcutsModal = true;
        StateHasChanged();
    }

    private void CloseKeyboardShortcuts()
    {
        showKeyboardShortcutsModal = false;
        StateHasChanged();
    }


    // ============================================
    // KEYBOARD NAVIGATION STATE
    // ============================================
    private bool isKeyboardMoveMode = false;
    private string lastKeyboardAction = "";
    private DotNetObjectReference<DashboardBuilder> dotNetRef;

    // ============================================
    // LIFECYCLE - Register Keyboard Handler
    // ============================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Keyboard shortcuts live in wwwroot/JS/dashboard-builder.js
                dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("registerKeyboardHandler", dotNetRef);
            }
            catch (JSException ex)
            {
                Console.WriteLine($"Keyboard shortcuts could not be registered: {ex.Message}");
            }
        }

        // A rebuilt canvas or a switch between design and preview replaces every chart area,
        // so every chart that has data must be drawn again.
        if (canvasKey != lastDrawnCanvasKey || isPreviewMode != lastDrawnPreviewMode)
        {
            lastDrawnCanvasKey = canvasKey;
            lastDrawnPreviewMode = isPreviewMode;
            QueueAllChartRenders();
        }

        await ProcessChartQueueAsync();
    }

    /// <summary>
