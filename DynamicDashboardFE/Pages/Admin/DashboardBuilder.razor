    private async Task RegenerateComponent(DashboardComponent component)
    {
        if (component == null || dashboard.DatabaseID <= 0) return;

        isRegenerating[component.ComponentID] = true;
        StateHasChanged();

        try
        {
            var request = new RegenerateComponentRequest
            {
                DatabaseId = dashboard.DatabaseID,
                GridX = component.GridX,
                GridY = component.GridY,
                GridWidth = component.GridWidth,
                GridHeight = component.GridHeight,
                FailedTitle = component.Title,
                FailedSql = component.QueryText,
                ErrorMessage = componentErrors.ContainsKey(component.ComponentID) ? componentErrors[component.ComponentID] : "User requested regeneration",
                ExistingTitles = dashboard.Components.Where(c => c.ComponentID != component.ComponentID).Select(c => c.Title).ToList(),
                DataViewingTypeID = component.DataViewingTypeID,
                ChartType = component.ChartType
            };

            var response = await Http.PostAsJsonAsync("api/assistant/regenerate", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AssistantSuggestionResponse>();

                if (result?.Success == true && result.Suggestions?.Any() == true)
                {
                    var newSuggestion = result.Suggestions.First();
                    component.Title = newSuggestion.Title;
                    component.Description = newSuggestion.Description;
                    component.QueryText = newSuggestion.SqlTemplate;

                    componentErrors.Remove(component.ComponentID);
                    componentData.Remove(component.ComponentID);

                    await LoadComponentDataAsync(component);

                    if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
                    {
                        await Task.Delay(200);
                        await RenderChart(component);
                    }

                    hasUnsavedChanges = true;
                    ToastService.ShowSuccess($"Regenerated: {component.Title}");
                }
                else
                {
                    ToastService.ShowError(result?.Message ?? "Failed to regenerate");
                }
            }
            else
            {
                ToastService.ShowError("Failed to regenerate component");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isRegenerating[component.ComponentID] = false;
            StateHasChanged();
        }
    }

