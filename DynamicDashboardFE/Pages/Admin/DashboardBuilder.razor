    private void AutoArrangeComponents()
    {
        if (dashboard?.Components == null || !dashboard.Components.Any()) return;

        int currentX = 0;
        int currentY = 0;
        int currentRowMaxHeight = 0;
        const int maxColumns = 12;

        var sortedComponents = dashboard.Components.OrderBy(c => c.GridY).ThenBy(c => c.GridX).ToList();

        foreach (var component in sortedComponents)
        {
            if (currentX + component.GridWidth > maxColumns)
            {
                currentX = 0;
                currentY += currentRowMaxHeight;
                currentRowMaxHeight = 0;
            }

            component.GridX = currentX;
            component.GridY = currentY;
            currentRowMaxHeight = Math.Max(currentRowMaxHeight, component.GridHeight);
            currentX += component.GridWidth;
        }

        hasUnsavedChanges = true;
        canvasKey++;
        StateHasChanged();
        ToastService.ShowSuccess("Components auto-arranged!");
    }

