    private async Task OnDropOnCanvas(DragEventArgs e)
    {
        if (!isDragging) return;

        Console.WriteLine("📦 Drop detected on canvas");

        var position = await CalculateGridPosition(e);

        if (draggedExistingComponentId.HasValue)
        {
            await MoveExistingComponent(draggedExistingComponentId.Value, position.X, position.Y);
        }
        else if (!string.IsNullOrEmpty(draggedComponentType))
        {
            await CreateNewComponentAtPosition(draggedComponentType, position.X, position.Y);
        }

        isDragging = false;
        draggedComponentType = null;
        draggedExistingComponentId = null;
        showDropIndicator = false;
        hasUnsavedChanges = true;

        StateHasChanged();
    }

    private async Task<(int X, int Y)> CalculateGridPosition(DragEventArgs e)
    {
        try
        {
            var (gridX, gridY) = await GetGridCellAsync(e.ClientX, e.ClientY);

            gridX = Math.Clamp(gridX, 0, Math.Max(0, GridColumns - dropIndicatorWidth));
            gridY = Math.Max(0, gridY);

            return (gridX, gridY);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error calculating position: {ex.Message}");
            return (0, 0);
        }
    }

    /// <summary>
    /// Canvas position and size. Uses a synchronous call when available (WebAssembly), so
    /// drag-over handlers finish without yielding and can skip unnecessary renders.
    /// </summary>
    private async Task<CanvasBounds> GetCanvasBoundsAsync()
    {
        if (JSRuntime is IJSInProcessRuntime inProcess)
        {
            return inProcess.Invoke<CanvasBounds>("getElementBounds", canvasRef);
        }
        return await JSRuntime.InvokeAsync<CanvasBounds>("getElementBounds", canvasRef);
    }

    /// <summary>
    /// Grid cell under a pointer position (not clamped). Accounts for the 16px grid gap and the
    /// canvas zoom (the canvas is scaled with CSS, so measured sizes are scaled too).
    /// </summary>
    private async Task<(int X, int Y)> GetGridCellAsync(double clientX, double clientY)
    {
        var bounds = await GetCanvasBoundsAsync();
        if (bounds == null || bounds.Width <= 0)
        {
            Console.WriteLine("⚠️ Could not get canvas bounds");
            return (0, 0);
        }

        var scale = zoomLevel > 0 ? zoomLevel : 1.0;
        canvasWidthPx = bounds.Width / scale;

        double relativeX = (clientX - bounds.Left) / scale + bounds.ScrollLeft;
        double relativeY = (clientY - bounds.Top) / scale + bounds.ScrollTop;

        double colPitch = (canvasWidthPx + GridGapPx) / GridColumns;
        double rowPitch = GridRowHeightPx + GridGapPx;

        return ((int)Math.Floor(relativeX / colPitch), (int)Math.Floor(relativeY / rowPitch));
    }

    /// <summary>Drop indicator position and size in px, from its grid cell and span.</summary>
    private string GetDropIndicatorStyle()
    {
        if (canvasWidthPx <= 0) return "display: none;";

        double colPitch = (canvasWidthPx + GridGapPx) / GridColumns;
        double rowPitch = GridRowHeightPx + GridGapPx;

        return string.Format(System.Globalization.CultureInfo.InvariantCulture,
            "left: {0:0.##}px; top: {1:0.##}px; width: {2:0.##}px; height: {3:0.##}px;",
            dropIndicatorX * colPitch,
            dropIndicatorY * rowPitch,
            dropIndicatorWidth * colPitch - GridGapPx,
            dropIndicatorHeight * rowPitch - GridGapPx);
    }

    private async Task CreateNewComponentAtPosition(string componentType, int gridX, int gridY)
    {
        var libraryItem = dragComponentLibrary.FirstOrDefault(c => c.Type == componentType);
        if (libraryItem == null)
        {
            Console.WriteLine($"❌ Unknown component type: {componentType}");
            return;
        }

        int newId = dashboard.Components?.Any() == true
            ? dashboard.Components.Max(c => c.ComponentID) + 1
            : 1;

        var newComponent = new DashboardComponent
        {
            ComponentID = newId,
            DashboardID = dashboard.DashboardID,
            Title = $"New {libraryItem.Title}",
            Description = "",
            DataViewingTypeID = libraryItem.DataViewingTypeID,
            GridX = gridX,
            GridY = gridY,
            GridWidth = libraryItem.DefaultWidth,
            GridHeight = libraryItem.DefaultHeight,
            ChartType = libraryItem.ChartType,
            QueryText = "",
            QueryIntent = "",
            VisualizationConfig = "{}",
            FilterExpression = "",
            IsVisible = true,
            IsAIGenerated = false,
            CreatedAt = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow
        };

        dashboard.Components ??= new List<DashboardComponent>();
        dashboard.Components.Add(newComponent);

        selectedComponentId = newId;
        selectedComponentType = libraryItem.DataViewingTypeID;

        isComponentLoading[newId] = false;

        ToastService.ShowSuccess($"{libraryItem.Title} added at ({gridX}, {gridY})! Configure it in the properties panel.");
        Console.WriteLine($"✅ Created {libraryItem.Title} at position ({gridX}, {gridY})");
    }

    private void QuickAddComponent(DragComponentItem item)
    {
        var (x, y) = FindNextEmptyPosition(item.DefaultWidth, item.DefaultHeight);
        _ = CreateNewComponentAtPosition(item.Type, x, y);
    }

