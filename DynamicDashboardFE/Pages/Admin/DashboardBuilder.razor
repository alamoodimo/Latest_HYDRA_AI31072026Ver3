    private void DuplicateComponent(DashboardComponent component)
    {
        var newComponent = new DashboardComponent
        {
            ComponentID = dashboard.Components.Max(c => c.ComponentID) + 1,
            DashboardID = dashboard.DashboardID,
            Title = component.Title + " (Copy)",
            Description = component.Description,
            DataViewingTypeID = component.DataViewingTypeID,
            QueryText = component.QueryText,
            QueryIntent = component.QueryIntent,
            ChartType = component.ChartType,
            VisualizationConfig = component.VisualizationConfig,
            FilterExpression = component.FilterExpression,
            GridX = component.GridX,
            GridY = component.GridY + component.GridHeight,
            GridWidth = component.GridWidth,
            GridHeight = component.GridHeight,
            IsAIGenerated = component.IsAIGenerated,
            IsVisible = true,
            CreatedAt = DateTime.UtcNow,
            LastUpdated = DateTime.UtcNow
        };

        // Place the copy in the nearest free spot below the original instead of overlapping.
        var (freeX, freeY) = FindNearestAvailablePosition(newComponent.GridX, newComponent.GridY,
            newComponent.GridWidth, newComponent.GridHeight);
        newComponent.GridX = freeX;
        newComponent.GridY = freeY;

        dashboard.Components.Add(newComponent);
        hasUnsavedChanges = true;

        // Same SQL, so reuse the original's rows instead of running the query again.
        if (componentData.TryGetValue(component.ComponentID, out var rows))
        {
            componentData[newComponent.ComponentID] = rows;
            if (serverRowLimits.TryGetValue(component.ComponentID, out var rowLimit))
            {
                serverRowLimits[newComponent.ComponentID] = rowLimit;
            }
            if (newComponent.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
            {
                QueueChartRender(newComponent.ComponentID);
            }
        }

        StateHasChanged();
        ToastService.ShowSuccess("Component duplicated!");
    }

    private void RemoveComponent(int componentId)
    {
        var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == componentId);
        if (component != null)
        {
            dashboard.Components.Remove(component);
            if (selectedComponentId == componentId)
            {
                selectedComponentId = 0;
            }
            componentData.Remove(componentId);
            componentErrors.Remove(componentId);
            serverRowLimits.Remove(componentId);
            isComponentLoading.Remove(componentId);
            isRegenerating.Remove(componentId);
            aiWork.Remove(componentId);
            aiFixMessages.Remove(componentId);
            QueueChartDestroy(componentId);
            hasUnsavedChanges = true;
            StateHasChanged();
            ToastService.ShowInfo("Component removed");
        }
    }

