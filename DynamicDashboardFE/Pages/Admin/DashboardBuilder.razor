    private async Task OnAIComponentAdded()
    {
        hasUnsavedChanges = true;
        StateHasChanged();

        var newComponents = dashboard.Components
            .Where(c => !string.IsNullOrEmpty(c.QueryText) &&
                       !componentData.ContainsKey(c.ComponentID))
            .ToList();

        if (newComponents.Any())
        {
            Console.WriteLine($"Loading data for {newComponents.Count} new AI component(s)...");

            foreach (var component in newComponents)
            {
                if (!isComponentLoading.ContainsKey(component.ComponentID))
                {
                    isComponentLoading[component.ComponentID] = false;
                }
                await LoadComponentDataAsync(component);
            }

            await Task.Delay(200);

            var newCharts = newComponents.Where(c => c.DataViewingTypeID == (int)DataViewingTypeEnum.Chart);
            foreach (var chart in newCharts)
            {
                await RenderChart(chart);
            }

            Console.WriteLine($"✅ Loaded data for {newComponents.Count} AI component(s)");
        }

        ToastService.ShowSuccess("Component added successfully!");
    }

