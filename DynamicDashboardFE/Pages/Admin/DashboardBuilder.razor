    private static readonly IReadOnlyList<ResizeHandle> ResizeHandles = new List<ResizeHandle>
    {
        new ResizeHandle { Direction = "n", Title = "Resize North" },
        new ResizeHandle { Direction = "s", Title = "Resize South" },
        new ResizeHandle { Direction = "e", Title = "Resize East" },
        new ResizeHandle { Direction = "w", Title = "Resize West" },
        new ResizeHandle { Direction = "ne", Title = "Resize North-East" },
        new ResizeHandle { Direction = "nw", Title = "Resize North-West" },
        new ResizeHandle { Direction = "se", Title = "Resize South-East" },
        new ResizeHandle { Direction = "sw", Title = "Resize South-West" }
    };

    /// <summary>
    /// Starts a mouse resize from a card's edge or corner. JavaScript then reports pointer moves
    /// (OnResizeMove) and the release (OnResizeEnd). One .NET reference is reused for all resizes.
    /// </summary>
    private async Task StartResize(MouseEventArgs e, int componentId, string direction)
    {
        var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == componentId);
        if (component == null || isPreviewMode) return;

        isResizing = true;
        resizingComponentId = componentId;
        resizeDirection = direction ?? "";
        resizeStartX = component.GridX;
        resizeStartY = component.GridY;
        resizeStartWidth = component.GridWidth;
        resizeStartHeight = component.GridHeight;

        try
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("addResizeListeners", dotNetRef, resizeDirection);
        }
        catch (JSException ex)
        {
            isResizing = false;
            resizingComponentId = null;
            Console.WriteLine($"Resize could not start: {ex.Message}");
        }
    }

    /// <summary>
    /// Called while the mouse moves during a resize. The dragged edges follow the grid cell
    /// under the pointer and the opposite edges stay fixed, for all eight handles. A new size
    /// is applied only when it does not overlap another component.
    /// </summary>
    [JSInvokable]
    public async Task OnResizeMove(MouseEventArgs e)
    {
        if (!isResizing || !resizingComponentId.HasValue) return;

        var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == resizingComponentId.Value);
        if (component == null) return;

        var (cellX, cellY) = await GetGridCellAsync(e.ClientX, e.ClientY);

        int left = resizeStartX;
        int top = resizeStartY;
        int right = resizeStartX + resizeStartWidth - 1;
        int bottom = resizeStartY + resizeStartHeight - 1;

        if (resizeDirection.Contains('e')) right = Math.Clamp(cellX, left, GridColumns - 1);
        if (resizeDirection.Contains('w')) left = Math.Clamp(cellX, 0, right);
        if (resizeDirection.Contains('s')) bottom = Math.Max(cellY, top);
        if (resizeDirection.Contains('n')) top = Math.Clamp(cellY, 0, bottom);

        int newWidth = right - left + 1;
        int newHeight = bottom - top + 1;

        bool unchanged = left == component.GridX && top == component.GridY &&
                         newWidth == component.GridWidth && newHeight == component.GridHeight;
        if (unchanged || !CanPlaceComponentAtPosition(left, top, newWidth, newHeight, component.ComponentID))
        {
            return;
        }

        component.GridX = left;
        component.GridY = top;
        component.GridWidth = newWidth;
        component.GridHeight = newHeight;
        component.LastUpdated = DateTime.UtcNow;
        lastKeyboardAction = $"Resized to {newWidth}×{newHeight}";

        StateHasChanged();
    }

    [JSInvokable]
    public void OnResizeEnd()
    {
        isResizing = false;
        resizingComponentId = null;
        resizeDirection = "";
        hasUnsavedChanges = true;
        UpdateOccupancyMap();
        StateHasChanged();
    }


    // NEW: Find nearest available position
    private (int X, int Y) FindNearestAvailablePosition(int startX, int startY, int width, int height)
    {
        int maxX = 12 - width;
        int maxY = GetGridHeight() - height;

        // Check immediate position
        if (CanPlaceComponentAtPosition(startX, startY, width, height))
            return (startX, startY);

        // Search in expanding radius
        for (int radius = 1; radius <= 10; radius++)
        {
            for (int dy = -radius; dy <= radius; dy++)
            {
                for (int dx = -radius; dx <= radius; dx++)
                {
                    if (Math.Abs(dx) == radius || Math.Abs(dy) == radius)
                    {
                        int newX = startX + dx;
                        int newY = startY + dy;

                        if (newX >= 0 && newX <= maxX && newY >= 0 && newY <= maxY)
                        {
                            if (CanPlaceComponentAtPosition(newX, newY, width, height))
                                return (newX, newY);
                        }
                    }
                }
            }
        }

        // If no position found, place at the bottom
        return (0, Math.Max(0, GetGridHeight() + 2));
    }



    // Enhanced: Move Existing Component with collision detection
    private async Task MoveExistingComponent(int componentId, int newX, int newY)
    {
        var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == componentId);
        if (component == null)
        {
            Console.WriteLine($"❌ Component not found: {componentId}");
            return;
        }

        // Check if the new position is available (excluding the component being moved)
        if (!CanPlaceComponentAtPosition(newX, newY, component.GridWidth, component.GridHeight, componentId))
        {
            // Find nearest available position
            var nearestPosition = FindNearestAvailablePosition(newX, newY, component.GridWidth, component.GridHeight);
            newX = nearestPosition.X;
            newY = nearestPosition.Y;

            ToastService.ShowInfo($"Component moved to nearest available position ({newX}, {newY})");
        }

        int oldX = component.GridX;
        int oldY = component.GridY;

        component.GridX = newX;
        component.GridY = newY;
        component.LastUpdated = DateTime.UtcNow;

        // Update occupancy map (only the card's position changes; its chart is kept)
        UpdateOccupancyMap();

        Console.WriteLine($"✅ Moved '{component.Title}' from ({oldX}, {oldY}) to ({newX}, {newY})");
    }

    // Enhanced: OnDragOverCanvas with visual feedback
    private async Task OnDragOverCanvas(DragEventArgs e)
    {
        if (!isDragging)
        {
            skipNextRender = true;
            return;
        }

        var position = await CalculateGridPosition(e);

        // Check if position is available
        bool canPlace = true;
        if (draggedExistingComponentId.HasValue)
        {
            var component = dashboard.Components?.FirstOrDefault(c => c.ComponentID == draggedExistingComponentId.Value);
            if (component != null)
            {
                canPlace = CanPlaceComponentAtPosition(position.X, position.Y,
                    component.GridWidth, component.GridHeight, draggedExistingComponentId);
            }
        }
        else if (!string.IsNullOrEmpty(draggedComponentType))
        {
            var libraryItem = dragComponentLibrary.FirstOrDefault(c => c.Type == draggedComponentType);
            if (libraryItem != null)
            {
                canPlace = CanPlaceComponentAtPosition(position.X, position.Y,
                    libraryItem.DefaultWidth, libraryItem.DefaultHeight);
            }
        }

        // Drag-over fires many times per second: re-render only when the indicator changes.
        if (showDropIndicator && position.X == dropIndicatorX && position.Y == dropIndicatorY &&
            canPlace == dropIndicatorCanPlace)
        {
            skipNextRender = true;
            return;
        }

        // The indicator's green/red state is rendered by Blazor (dropIndicatorCanPlace), so no
        // JavaScript call is needed per mouse move.
        dropIndicatorX = position.X;
        dropIndicatorY = position.Y;
        dropIndicatorCanPlace = canPlace;
        showDropIndicator = true;
    }

    // NEW: Toggle Grid Lines
    private void ToggleGridLines()
    {
        showGridLines = !showGridLines;
        StateHasChanged();
        ToastService.ShowInfo($"Grid lines {(showGridLines ? "enabled" : "disabled")}");
    }

    // NEW: Set Grid Snap Size
    private void SetGridSnapSize(int size)
    {
        gridSnapSize = Math.Max(1, Math.Min(3, size));
        StateHasChanged();
        ToastService.ShowInfo($"Grid snap set to {gridSnapSize}");
    }

