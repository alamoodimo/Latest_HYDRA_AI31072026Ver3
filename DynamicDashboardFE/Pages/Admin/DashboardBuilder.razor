    private async Task GenerateWithSelectedTemplate()
    {
        if (selectedDatabaseIdForTemplate == 0)
        {
            ToastService.ShowError("Please select a database");
            return;
        }

        if (string.IsNullOrEmpty(selectedTemplateId))
        {
            ToastService.ShowError("Please select a template");
            return;
        }

        isGeneratingFromTemplate = true;

        try
        {
            var request = new { DatabaseId = selectedDatabaseIdForTemplate, TemplateId = selectedTemplateId };
            var response = await Http.PostAsJsonAsync("api/dashboard/generate-with-template", request);

            if (response.IsSuccessStatusCode)
            {
                var dashboards = await response.Content.ReadFromJsonAsync<List<DashboardModel>>();

                if (dashboards != null && dashboards.Any())
                {
                    // Clear everything from the previous dashboard first: generated components
                    // always use IDs 1..N, so old data and charts would otherwise show on the new cards.
                    await ResetComponentStateAsync();

                    dashboard = dashboards[0];
                    dashboard.DatabaseID = selectedDatabaseIdForTemplate;
                    PrepareDashboardForSave();
                    hasUnsavedChanges = true;

                    ToastService.ShowSuccess($"Dashboard generated with {dashboard.Components.Count} components! Loading data...");
