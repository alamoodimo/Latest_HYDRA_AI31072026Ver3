    /// <summary>
    /// Asks the AI to regenerate one component (api/assistant/regenerate).
    /// Repair ("Fix with AI" on a failed or empty card): keeps the title, description and type; only
    /// the SQL changes, and the API test-runs it before returning it.
    /// Alternative (card header button): a different component of the same type.
    /// On failure the card stays unchanged and the reason from the API is shown.
    /// </summary>
    private async Task RegenerateComponent(DashboardComponent component, ComponentRegenerationMode mode)
    {
        if (component == null || dashboard.DatabaseID <= 0) return;

        var componentId = component.ComponentID;
        var isRepair = mode == ComponentRegenerationMode.Repair;

        isRegenerating[componentId] = true;
        aiFixMessages.Remove(componentId);
        aiWork[componentId] = new AiWorkState { Mode = mode, StartedAt = DateTime.UtcNow };
        EnsureAiWorkTicker();
        StateHasChanged();

        try
        {
            var request = new RegenerateComponentRequest
            {
                DatabaseId = dashboard.DatabaseID,
                GridX = component.GridX,
                GridY = component.GridY,
                GridWidth = component.GridWidth,
                GridHeight = component.GridHeight,
                FailedTitle = component.Title,
                FailedDescription = component.Description,
                FailedSql = component.QueryText,
                ErrorMessage = isRepair ? GetComponentProblem(componentId) : "User requested different component",
                ExistingTitles = dashboard.Components.Where(c => c.ComponentID != componentId).Select(c => c.Title).ToList(),
                DataViewingTypeID = component.DataViewingTypeID,
                ChartType = component.ChartType,
                Mode = mode
            };

            using var response = await Http.PostAsJsonAsync("api/assistant/regenerate", request);
            var result = await ReadAssistantResponseAsync(response);

            var suggestion = result.Success ? result.Suggestions?.FirstOrDefault() : null;
            if (suggestion == null || string.IsNullOrWhiteSpace(suggestion.SqlTemplate))
            {
                var reason = string.IsNullOrWhiteSpace(result.Message)
                    ? "The AI could not produce a working query."
                    : result.Message;

                // Keep the reason on the card too: a toast disappears after a few seconds.
                aiFixMessages[componentId] = reason;

                ToastService.ShowError(isRepair
                    ? $"Could not fix \"{component.Title}\": {reason}"
                    : $"Could not replace \"{component.Title}\": {reason}");
                return;
            }

            // Repair keeps the card's title and description; a replacement brings its own.
            if (!isRepair)
            {
                if (!string.IsNullOrWhiteSpace(suggestion.Title)) component.Title = suggestion.Title;
                if (suggestion.Description != null) component.Description = suggestion.Description;
            }

            component.QueryText = suggestion.SqlTemplate;
            component.LastUpdated = DateTime.UtcNow;

            componentErrors.Remove(componentId);
            componentData.Remove(componentId);
            serverRowLimits.Remove(componentId);
            hasUnsavedChanges = true;

            // Loading the data also queues the chart drawing.
            await LoadComponentDataAsync(component);

            ToastService.ShowSuccess(isRepair
                ? $"\"{component.Title}\": {result.Message}"
                : $"Replaced with \"{component.Title}\"");
        }
        catch (Exception ex)
        {
            aiFixMessages[componentId] = ex.Message;
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isRegenerating[componentId] = false;
            aiWork.Remove(componentId);
            StopAiWorkTickerIfIdle();
            StateHasChanged();
        }
    }

    /// <summary>Starts the once-per-second refresh used for the elapsed time on working cards.</summary>
    private void EnsureAiWorkTicker()
    {
        aiWorkTicker ??= new System.Threading.Timer(
            _ => _ = InvokeAsync(StateHasChanged),
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    /// <summary>Stops the refresh when no component is waiting for the AI any more.</summary>
    private void StopAiWorkTickerIfIdle()
    {
        if (aiWork.Count == 0 && aiWorkTicker != null)
        {
            aiWorkTicker.Dispose();
            aiWorkTicker = null;
        }
    }

    private static string GetAiWorkElapsedText(AiWorkState work)
    {
        var seconds = Math.Max(0, (int)(DateTime.UtcNow - work.StartedAt).TotalSeconds);
        return $"{seconds} s";
    }

    /// <summary>What is wrong with a component, sent to the AI in repair mode.</summary>
    private string GetComponentProblem(int componentId)
    {
        if (componentErrors.TryGetValue(componentId, out var error) && !string.IsNullOrWhiteSpace(error))
        {
            return error;
        }

        return componentData.TryGetValue(componentId, out var rows) && rows?.Count == 0
            ? "The query ran successfully but returned no rows."
            : "The query needs to be checked and fixed.";
    }

    /// <summary>
    /// Reads the api/assistant/regenerate response, success or failure. On failure the API sends
    /// { "message": ... }, which maps to Message, so the real reason can be shown.
    /// </summary>
    private static async Task<AssistantSuggestionResponse> ReadAssistantResponseAsync(HttpResponseMessage response)
    {
        AssistantSuggestionResponse result = null;

        try
        {
            var body = await response.Content.ReadAsStringAsync();
            if (!string.IsNullOrWhiteSpace(body))
            {
                result = JsonSerializer.Deserialize<AssistantSuggestionResponse>(body, QueryJsonOptions);
            }
        }
        catch (JsonException)
        {
            // Not JSON: fall through to the generic message below.
        }

        result ??= new AssistantSuggestionResponse();

        if (!response.IsSuccessStatusCode)
        {
            result.Success = false;
        }

        if (!result.Success && string.IsNullOrWhiteSpace(result.Message))
        {
            result.Message = $"The AI request failed ({(int)response.StatusCode} {response.ReasonPhrase}).";
        }

        return result;
    }

