    /// <summary>Marks a chart to be drawn after the next render.</summary>
    private void QueueChartRender(int componentId)
    {
        pendingChartDestroys.Remove(componentId);
        pendingChartRenders.Add(componentId);
    }

    /// <summary>Marks every chart that has data to be drawn after the next render.</summary>
    private void QueueAllChartRenders()
    {
        if (dashboard?.Components == null) return;

        foreach (var component in dashboard.Components.Where(c => c.DataViewingTypeID == (int)DataViewingTypeEnum.Chart))
        {
            if (componentData.TryGetValue(component.ComponentID, out var rows) && rows?.Count > 0)
            {
                QueueChartRender(component.ComponentID);
            }
        }
    }

    /// <summary>Marks a removed component's chart to be released after the next render.</summary>
    private void QueueChartDestroy(int componentId)
    {
        pendingChartRenders.Remove(componentId);
        pendingChartDestroys.Add(componentId);
    }

    /// <summary>
    /// Releases and draws the queued charts. Runs after a render, so each chart area is on the
    /// page; the JavaScript side also waits briefly in case Blazor is still updating it.
    /// </summary>
    private async Task ProcessChartQueueAsync()
    {
        if (pendingChartDestroys.Count > 0)
        {
            var destroyIds = pendingChartDestroys.ToList();
            pendingChartDestroys.Clear();

            foreach (var id in destroyIds)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("DashboardCharts.destroy", id);
                }
                catch (JSException ex)
                {
                    Console.WriteLine($"Chart {id} could not be released: {ex.Message}");
                }
            }
        }

        if (pendingChartRenders.Count == 0 || dashboard?.Components == null) return;

        var renderIds = pendingChartRenders.ToList();
        pendingChartRenders.Clear();

        var drawTasks = new List<Task>();
        foreach (var id in renderIds)
        {
            var component = dashboard.Components.FirstOrDefault(c => c.ComponentID == id);
            if (component == null || component.DataViewingTypeID != (int)DataViewingTypeEnum.Chart) continue;
            if (isPreviewMode && !component.IsVisible) continue;
            if (IsComponentLoading(id) || componentErrors.ContainsKey(id)) continue;
            if (!componentData.TryGetValue(id, out var rows) || rows == null || rows.Count == 0) continue;

            drawTasks.Add(DrawChartAsync(component, rows));
        }

        await Task.WhenAll(drawTasks);
    }

    /// <summary>Draws one chart; failures are reported in the browser console.</summary>
    private async Task DrawChartAsync(DashboardComponent component, List<Dictionary<string, object>> rows)
    {
        try
        {
            var chartType = string.IsNullOrWhiteSpace(component.ChartType)
                ? GetChartType(component.VisualizationConfig)
                : component.ChartType;

            await JSRuntime.InvokeAsync<bool>("DashboardCharts.render",
                component.ComponentID, chartType, rows, component.Title);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Chart {component.ComponentID} could not be drawn: {ex.Message}");
        }
    }

