    <!-- ============================================ -->
    <!-- MAIN CONTENT -->
    <!-- ============================================ -->
    <div class="builder-content @(isPreviewMode ? "preview-mode" : "")
     @(selectedComponentId > 0 ? "with-properties" : "full-width")
     @(!showSidebar ? "sidebar-hidden" : "")">
        @if (isPreviewMode)
        {
            <!-- ============================================ -->
            <!-- PREVIEW MODE -->
            <!-- ============================================ -->
            <div class="preview-fullscreen">
                <div class="preview-header">
                    <div>
                        <h4 class="mb-1">@dashboard.Title</h4>
                        @if (!string.IsNullOrEmpty(dashboard.Description))
                        {
                            <p class="text-muted mb-0 small">@dashboard.Description</p>
                        }
                    </div>
                    <button class="btn btn-secondary" @onclick="TogglePreviewMode">
                        <i class="fas fa-edit me-2"></i>Exit Preview
                    </button>
                </div>

                <div class="preview-grid" style="grid-template-rows: repeat(@GetGridHeight(), 100px);">
                    @foreach (var component in dashboard.Components.Where(c => c.IsVisible))
                    {
                        <div class="dashboard-component" @key="component.ComponentID"
                             style="grid-column: @(component.GridX + 1) / span @component.GridWidth;
                                            grid-row: @(component.GridY + 1) / span @component.GridHeight;">
                            <div class="component-header">
                                <span class="component-title" title="@component.Title">@component.Title</span>
                            </div>
                            @RenderComponentBody(component)
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ============================================ -->
            <!-- DESIGN MODE WITH DRAG & DROP -->
            <!-- ============================================ -->
            <!-- LEFT SIDEBAR - COMPONENT LIBRARY -->
            <!-- LEFT SIDEBAR - COMPONENT LIBRARY -->
            <div class="builder-sidebar builder-sidebar-left @(!showSidebar ? "collapsed" : "")">
                @if (showSidebar)
                {
                    <div class="sidebar-header">
                        <h6 class="mb-0">
                            <i class="fas fa-puzzle-piece me-2"></i>Components
                        </h6>
                        <button class="btn-close-panel" @onclick="ToggleSidebar" title="Hide Sidebar">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                    </div>

                    <div class="sidebar-body">
                        <div class="drag-instructions mb-3">
                            <small class="text-muted">
                                <i class="fas fa-hand-pointer me-1"></i>
                                Drag components to canvas or click to add
                            </small>
                        </div>

                        <!-- Charts Category -->
                        <div class="component-category mb-3">
                            <div class="category-title">
                                <i class="fas fa-chart-bar me-1"></i>Charts
                            </div>
                            @foreach (var item in dragComponentLibrary.Where(c => c.DataViewingTypeID == 4))
                            {
                                <div class="drag-component-item"
                                     draggable="true"
                                     @ondragstart="(e) => OnDragStartFromLibrary(e, item)"
                                     @ondragend="OnDragEnd"
                                     @onclick="() => QuickAddComponent(item)"
                                     style="--item-color: @item.Color">
                                    <div class="drag-item-icon">
                                        <i class="fas @item.Icon"></i>
                                    </div>
                                    <div class="drag-item-info">
                                        <span class="drag-item-title">@item.Title</span>
                                        <span class="drag-item-size">@item.DefaultWidth × @item.DefaultHeight</span>
                                    </div>
                                    <div class="drag-item-handle">
                                        <i class="fas fa-grip-vertical"></i>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Data Display Category -->
                        <div class="component-category mb-3">
                            <div class="category-title">
                                <i class="fas fa-table me-1"></i>Data Display
                            </div>
                            @foreach (var item in dragComponentLibrary.Where(c => c.DataViewingTypeID == 1))
                            {
                                <div class="drag-component-item"
                                     draggable="true"
                                     @ondragstart="(e) => OnDragStartFromLibrary(e, item)"
                                     @ondragend="OnDragEnd"
                                     @onclick="() => QuickAddComponent(item)"
                                     style="--item-color: @item.Color">
                                    <div class="drag-item-icon">
                                        <i class="fas @item.Icon"></i>
                                    </div>
                                    <div class="drag-item-info">
                                        <span class="drag-item-title">@item.Title</span>
                                        <span class="drag-item-size">@item.DefaultWidth × @item.DefaultHeight</span>
                                    </div>
                                    <div class="drag-item-handle">
                                        <i class="fas fa-grip-vertical"></i>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Metrics & Text Category -->
                        <div class="component-category mb-3">
                            <div class="category-title">
                                <i class="fas fa-tachometer-alt me-1"></i>Metrics & Text
                            </div>
                            @foreach (var item in dragComponentLibrary.Where(c => c.DataViewingTypeID == 3 || c.DataViewingTypeID == 5))
                            {
                                <div class="drag-component-item"
                                     draggable="true"
                                     @ondragstart="(e) => OnDragStartFromLibrary(e, item)"
                                     @ondragend="OnDragEnd"
                                     @onclick="() => QuickAddComponent(item)"
                                     style="--item-color: @item.Color">
                                    <div class="drag-item-icon">
                                        <i class="fas @item.Icon"></i>
                                    </div>
                                    <div class="drag-item-info">
                                        <span class="drag-item-title">@item.Title</span>
                                        <span class="drag-item-size">@item.DefaultWidth × @item.DefaultHeight</span>
                                    </div>
                                    <div class="drag-item-handle">
                                        <i class="fas fa-grip-vertical"></i>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- Collapsed Sidebar State -->
                    <div class="sidebar-collapsed">
                        <button class="btn btn-sm btn-outline-secondary w-100 mb-2" @onclick="ToggleSidebar" title="Show Components">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        <div class="sidebar-collapsed-hint">
                            <small class="text-muted">Components</small>
                        </div>
                    </div>
                }
            </div>

            <!-- CANVAS AREA -->


            <div class="builder-design">
                <div class="builder-canvas" style="transform: scale(@zoomLevel);">
                    <!-- DROP ZONE WRAPPER -->
                    <div class="canvas-drop-zone @(isDragging ? "is-drag-active" : "")"
                         @ref="canvasRef"
                         @ondragover="OnDragOverCanvas"
                         @ondragover:preventDefault
                         @ondragleave="OnDragLeaveCanvas"
                         @ondrop="OnDropOnCanvas"
                         @ondrop:preventDefault>

                        <!-- Drop Indicator -->
                        @if (showDropIndicator && isDragging)
                        {
                            <!-- Positioned in px from the grid cell (the indicator sits outside the grid,
                                 so grid-column/grid-row had no effect and it always showed at the top-left). -->
                            <div class="drop-indicator @(dropIndicatorCanPlace ? "can-drop" : "cannot-drop")"
                                 style="@GetDropIndicatorStyle()">
                                <div class="drop-indicator-inner @(dropIndicatorCanPlace ? "can-drop" : "cannot-drop")">
                                    <i class="fas @(dropIndicatorCanPlace ? "fa-plus-circle" : "fa-ban")"></i>
                                    <span>@(dropIndicatorCanPlace ? "Drop Here" : "Space occupied")</span>
                                </div>
                            </div>
                        }

                        <!-- Dashboard Grid -->
                        <div class="dashboard-grid @(showGridLines ? "show-grid" : "" )" @key="canvasKey" style="grid-template-rows: repeat(@GetGridHeight(), 100px);">
                            @if (showGridLines)
                            {
                                <div class="grid-lines">
                                    @for (int i = 0; i < 12; i++)
                                    {
                                        <div class="grid-column" style="grid-column: @(i + 1);"></div>
                                    }
                                    @for (int i = 0; i < GetGridHeight(); i++)
                                    {
                                        <div class="grid-row" style="grid-row: @(i + 1);"></div>
                                    }
                                </div>
                            }
                            @if (dashboard.Components != null && dashboard.Components.Any())
                            {
                                @foreach (var component in dashboard.Components)
                                {
                                    <div class="dashboard-component @(selectedComponentId == component.ComponentID ? "selected" : "") @(draggedExistingComponentId == component.ComponentID ? "is-dragging" : "")"
                                         @key="component.ComponentID"
                                         style="grid-column: @(component.GridX + 1) / span @component.GridWidth;
                                                            grid-row: @(component.GridY + 1) / span @component.GridHeight;"
                                         draggable="@(isResizing ? "false" : "true")"
                                         @ondragstart="(e) => OnDragStartExisting(e, component)"
                                         @ondragstart:preventDefault="isResizing"
                                         @ondragend="OnDragEnd"
                                         @onclick="() => SelectComponent(component.ComponentID)"
                                         @onclick:stopPropagation="true">

                                        <div class="component-header">
                                            <div class="component-drag-handle" title="Drag to move">
                                                <i class="fas fa-grip-vertical"></i>
                                            </div>
                                            <span class="component-title" title="@component.Title">@component.Title</span>
                                            <div class="component-actions">
                                                @if (isRegenerating.ContainsKey(component.ComponentID) && isRegenerating[component.ComponentID])
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" disabled>
                                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-link" title="Replace with a different AI-generated component"
                                                            @onclick="() => RegenerateComponent(component, ComponentRegenerationMode.Alternative)"
                                                            @onclick:stopPropagation="true"
                                                            disabled="@(dashboard.DatabaseID <= 0)">
                                                        <i class="fas fa-random"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-link" @onclick="() => LoadComponentDataAsync(component)" @onclick:stopPropagation="true" title="Refresh Data">
                                                    <i class="fas fa-sync-alt"></i>
                                                </button>
                                                <button class="btn btn-sm btn-link" @onclick="() => DuplicateComponent(component)" @onclick:stopPropagation="true" title="Duplicate">
                                                    <i class="fas fa-clone"></i>
                                                </button>
                                                <button class="btn btn-sm btn-link text-danger" @onclick="() => RemoveComponent(component.ComponentID)" @onclick:stopPropagation="true" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>

                                        @RenderComponentBody(component)

                                        @if (selectedComponentId == component.ComponentID)
                                        {
                                            @* preventDefault stops the browser from starting a component drag
                                               (the card is draggable) when a resize handle is pressed. *@
                                            @foreach (var handle in ResizeHandles)
                                            {
                                                <div class="resize-handle resize-handle-@handle.Direction"
                                                     @onmousedown="(e) => StartResize(e, component.ComponentID, handle.Direction)"
                                                     @onmousedown:preventDefault="true"
                                                     @onmousedown:stopPropagation="true"
                                                     title="@handle.Title"></div>
                                            }
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Empty Canvas State -->
                                <div class="empty-canvas-overlay">
                                    <div class="empty-canvas">
                                        <i class="fas fa-arrows-alt fa-3x mb-3 text-muted"></i>
                                        <h5>Drag Components Here</h5>
                                        <p class="text-muted">Drag components from the left panel or use AI to generate a dashboard</p>
                                        <div class="d-flex gap-2 justify-content-center mt-3">
    <button class="btn btn-success" @onclick="ShowTemplateModal">
        <i class="fas fa-magic me-2"></i>AI Generate
    </button>
    @if (dashboard.DatabaseID <= 0)
    {
        <button class="btn btn-outline-primary" @onclick="ShowDashboardSettings">
            <i class="fas fa-database me-2"></i>Choose Database
        </button>
    }
</div>
@*            Old before claude 25 9 2026                             <div class="d-flex gap-2 justify-content-center mt-3">
                                            <button class="btn btn-success" @onclick="ShowTemplateModal" disabled="@(dashboard.DatabaseID <= 0)">
                                                <i class="fas fa-magic me-2"></i>AI Generate
                                            </button>
                                        </div> *@
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Keyboard Mode Indicator - Show when component is selected -->
            @if (selectedComponentId != 0 && !isPreviewMode)
            {
                <div class="keyboard-indicator @(isKeyboardMoveMode ? "active" : "")">
                    <div class="keyboard-indicator-content">
                        <i class="fas fa-keyboard me-2"></i>
                        <span class="indicator-text">
                            @if (!string.IsNullOrEmpty(lastKeyboardAction))
                            {
                                @lastKeyboardAction
                            }
                            else
                            {
                                <text>Use Arrow keys to move • Shift+Arrow to resize</text>
                            }
                        </span>
                        <span class="position-info">
                            Position: (@selectedComponent?.GridX, @selectedComponent?.GridY) •
                            Size: @selectedComponent?.GridWidth×@selectedComponent?.GridHeight
                        </span>
                    </div>
                </div>
            }

            <!-- RIGHT SIDEBAR - PROPERTIES PANEL -->
            <div class="builder-sidebar builder-sidebar-right @(selectedComponentId == 0 ? "collapsed" : "")">
                @if (selectedComponentId != 0 && selectedComponent != null)
                {
                    <div class="properties-panel">
                        <div class="properties-header">
                            <h5>
                                <i class="fas fa-cog me-2"></i>Properties
                            </h5>
                            <button class="btn-close-panel" @onclick="ClosePropertiesPanel">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div class="properties-body">
                            <!-- Component Title -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-heading me-2"></i>Title
                                </label>
                                <input type="text" class="form-control" @bind="selectedComponent.Title" placeholder="Enter component title" />
                            </div>

                            <!-- Component Description -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-align-left me-2"></i>Description
                                </label>
                                <textarea class="form-control" @bind="selectedComponent.Description" placeholder="Enter description (optional)" rows="2"></textarea>
                            </div>

                            <!-- SQL Query -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-code me-2"></i>SQL Query
                                </label>
                                @if (!string.IsNullOrEmpty(selectedComponent.QueryText))
                                {
                                    @if (!isEditingSql)
                                    {
                                        <div class="sql-viewer-large">
                                            <div class="sql-header">
                                                <span>SQL Statement</span>
                                                <div class="sql-actions">
                                                    <button class="btn-sql-action" @onclick="() => CopyToClipboard(selectedComponent.QueryText)" title="Copy">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                    <button class="btn-sql-action" @onclick="EnableSqlEdit" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <pre class="sql-code-large">@selectedComponent.QueryText</pre>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="sql-editor-large">
                                            <div class="sql-header">
                                                <span>Edit SQL Query</span>
                                                <div class="sql-actions">
                                                    <button class="btn-sql-action text-success" @onclick="SaveSqlEdit" title="Save">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button class="btn-sql-action text-danger" @onclick="CancelSqlEdit" title="Cancel">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <textarea class="sql-textarea" @bind="editingSqlText" rows="8" spellcheck="false"></textarea>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0 py-2">
                                        <small><i class="fas fa-exclamation-triangle me-1"></i>No SQL query defined</small>
                                    </div>
                                    <button class="btn btn-sm btn-primary mt-2 w-100" @onclick="AddComponentSQL">
                                        <i class="fas fa-plus me-1"></i>Add SQL Query
                                    </button>
                                }
                            </div>

                            <!-- Component Type -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-shapes me-2"></i>Component Type
                                </label>
                                <select class="form-select" @bind="selectedComponentType" @bind:after="OnComponentTypeChanged">
                                    <option value="1">📊 Table</option>
                                    <option value="2">🏷️ Label</option>
                                    <option value="3">📈 KPI / Metric</option>
                                    <option value="4">📊 Chart</option>
                                </select>
                            </div>

                            <!-- Chart Type (Only if Chart) -->
                            @if (selectedComponent.DataViewingTypeID == 4)
                            {
                                <div class="property-section">
                                    <label class="property-label">
                                        <i class="fas fa-chart-bar me-2"></i>Chart Type
                                    </label>
                                    <div class="chart-type-grid">
                                        @foreach (var ct in new[] { ("bar", "fa-chart-bar", "Bar"), ("line", "fa-chart-line", "Line"), ("pie", "fa-chart-pie", "Pie"), ("donut", "fa-ring", "Donut"), ("area", "fa-chart-area", "Area") })
                                        {
                                            <div class="chart-type-option @(GetComponentChartType() == ct.Item1 ? "selected" : "")"
                                                 @onclick="() => UpdateChartType(ct.Item1)">
                                                <i class="fas @ct.Item2"></i>
                                                <span>@ct.Item3</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Component Size -->
                            <div class="property-section">
                                <label class="property-label">
                                    <i class="fas fa-expand me-2"></i>Size
                                </label>
                                <div class="size-selector">
                                    @foreach (var size in new[] { (3, 2), (6, 2), (6, 3), (12, 3), (12, 4) })
                                    {
                                        <div class="size-option @(selectedComponent.GridWidth == size.Item1 && selectedComponent.GridHeight == size.Item2 ? "active" : "")"
                                             @onclick="() => UpdateComponentSize(size.Item1, size.Item2)">
                                            <div class="size-preview" style="width: @(size.Item1 * 6)px; height: @(size.Item2 * 12)px;"></div>
                                            <span>@size.Item1×@size.Item2</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="property-actions">
                                <button class="btn btn-primary w-100 mb-2" @onclick="ApplyComponentChanges">
                                    <i class="fas fa-check me-2"></i>Apply Changes
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- AI Assistant -->
    <FloatingAIAssistant DashboardId="@dashboard.DashboardID"
                         Dashboard="@dashboard"
                         FindEmptyPosition="FindNextEmptyPosition"
                         OnComponentAdded="@OnAIComponentAdded" />
</div>

<!-- Template Selection Modal -->
@* Keep existing template modal code - no changes needed *@
<div class="modal fade @(showTemplateModal ? "show" : "")" tabindex="-1" style="display: @(showTemplateModal ? "block" : "none")">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden; width: 850px !important">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 2rem;">
                <div class="d-flex align-items-center text-white">
                    <i class="fas fa-layer-group me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Choose a Template</h3>
                        <p class="mb-0 opacity-75" style="font-size: 0.95rem;">Select a layout template to start building your dashboard</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseTemplateModal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <div class="mb-4 p-3" style="background: #f8f9fa; border-radius: 12px;">
                    <label class="form-label fw-bold d-flex align-items-center mb-2" style="font-size: 1.1rem;">
                        <i class="fas fa-database me-2 text-primary"></i>Select Database
                    </label>
                    <select class="form-select form-select-lg" @bind="selectedDatabaseIdForTemplate" style="border-radius: 8px; border: 2px solid #dee2e6;">
                        <option value="0">-- Select a Database --</option>
                        @foreach (var ds in availableDataSources)
                        {
                            <option value="@ds.Id">@ds.Name</option>
                        }
                    </select>
                </div>

                <div class="row g-4">
                    @foreach (var tmpl in availableTemplates)
                    {
                        <div class="col-lg-4">
                            <div class="template-card-enhanced @(selectedTemplateId == tmpl.Id ? "selected" : "")"
                                 @onclick="() => selectedTemplateId = tmpl.Id">
                                <div class="template-preview-enhanced">
                                    <i class="@GetTemplateIcon(tmpl.Category) template-icon"></i>
                                </div>
                                <div class="template-info">
                                    <h5 class="template-title">@tmpl.Name</h5>
                                    <p class="template-description">@tmpl.Description</p>
                                    <div class="template-meta">
                                        <span class="badge bg-light text-dark">
                                            <i class="fas fa-th me-1"></i>@tmpl.Components.Count components
                                        </span>
                                    </div>
                                    @if (selectedTemplateId == tmpl.Id)
                                    {
                                        <div class="selected-badge">
                                            <i class="fas fa-check-circle me-2"></i>Selected
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer" style="padding: 1.5rem 2rem; border-top: 2px solid #f0f0f0;">
                <button type="button" class="btn btn-secondary btn-lg" @onclick="CloseTemplateModal" style="border-radius: 8px; padding: 0.75rem 2rem;">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-success btn-lg"
                        @onclick="GenerateWithSelectedTemplate"
                        disabled="@(selectedDatabaseIdForTemplate == 0 || string.IsNullOrEmpty(selectedTemplateId) || isGeneratingFromTemplate)"
                        style="border-radius: 8px; padding: 0.75rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none;">
                    @if (isGeneratingFromTemplate)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <text>Generating...</text>
                    }
                    else
                    {
                        <i class="fas fa-magic me-2"></i>
                        <text>Generate with AI</text>
                    }
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade @(showTemplateModal ? "show" : "")" style="display: @(showTemplateModal ? "block" : "none")"></div>

<!-- Add Chart Modal -->
@* Keep existing add chart modal code - no changes needed *@
<div class="modal fade @(showAddChartModal ? "show" : "")" tabindex="-1" style="display: @(showAddChartModal ? "block" : "none")">
    <div class="modal-dialog modal-xl" style="max-width: 1000px;">
        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; padding: 2rem;">
                <div class="d-flex align-items-center text-white">
                    <i class="fas fa-magic me-3" style="font-size: 2rem;"></i>
                    <div>
                        <h3 class="mb-0 fw-bold">Create Component with AI</h3>
                        <p class="mb-0 opacity-75" style="font-size: 0.95rem;">Describe what you want to visualize and select the type</p>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseAddChartModal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <!-- Step Indicator -->
                <div class="steps-indicator mb-4">
                    <div class="step @(addChartStep >= 1 ? "active" : "") @(addChartStep > 1 ? "completed" : "")">
                        <div class="step-number">1</div>
                        <div class="step-label">Describe</div>
                    </div>
                    <div class="step-line @(addChartStep > 1 ? "active" : "")"></div>
                    <div class="step @(addChartStep >= 2 ? "active" : "") @(addChartStep > 2 ? "completed" : "")">
                        <div class="step-number">2</div>
                        <div class="step-label">Configure</div>
                    </div>
                    <div class="step-line @(addChartStep > 2 ? "active" : "")"></div>
                    <div class="step @(addChartStep >= 3 ? "active" : "")">
                        <div class="step-number">3</div>
                        <div class="step-label">Preview</div>
                    </div>
                </div>

                @if (addChartStep == 1)
                {
                    <div class="step-content">
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold mb-0">
                                    <i class="fas fa-comment-dots me-2 text-primary"></i>What would you like to visualize?
                                </label>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="LoadSuggestedQuestions" disabled="@isLoadingSuggestions">
                                    @if (isLoadingSuggestions)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-lightbulb me-1"></i>
                                    }
                                    Suggest
                                </button>
                            </div>

                            @if (suggestedQuestions?.Any() == true)
                            {
                                <div class="suggestions-panel mb-3">
                                    <div class="suggestions-header">
                                        <i class="fas fa-lightbulb text-warning me-2"></i>
                                        <span>Click a question to use it:</span>
                                        <button type="button" class="btn-close btn-sm ms-auto" @onclick="ClearSuggestions"></button>
                                    </div>
                                    <div class="suggestions-list">
                                        @foreach (var question in suggestedQuestions)
                                        {
                                            <div class="suggestion-item" @onclick="() => UseSuggestion(question)">
                                                <i class="fas fa-chevron-right me-2 text-muted"></i>@question
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <textarea class="form-control" rows="4" @bind="customChartQuery"
                                      placeholder="Example: Show top 10 customers by revenue
    Example: Display total sales this month
    Example: Show violations by category"></textarea>
                        </div>
                    </div>
                }
                else if (addChartStep == 2)
                {
                    <div class="step-content">
                        <div class="alert alert-info d-flex align-items-start mb-4">
                            <i class="fas fa-check-circle me-2 mt-1"></i>
                            <div>
                                <strong>Query Analyzed!</strong>
                                <p class="mb-0 mt-1">@customChartExplanation</p>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="fas fa-heading me-2"></i>Component Title</label>
                            <input type="text" class="form-control" @bind="customChartTitle" placeholder="Enter component title" />
                        </div>

                        <!-- NEW: Component Type Selection -->
                        <div class="mb-4">
                            <label class="form-label fw-bold"><i class="fas fa-shapes me-2"></i>Component Type</label>
                            <div class="component-type-grid">
                                @foreach (var ct in new[] {
                                                        (1, "fa-table", "Table", "Display data in a table format"),
                                                        (3, "fa-tachometer-alt", "KPI", "Show key metrics and numbers"),
                                                        (4, "fa-chart-bar", "Chart", "Visualize data with charts")
                                                        })
                                {
                                    <div class="component-type-option @(selectedComponentTypeForCustom == ct.Item1 ? "selected" : "")"
                                         @onclick="() => selectedComponentTypeForCustom = ct.Item1">
                                        <i class="fas @ct.Item2 fa-2x mb-2"></i>
                                        <span class="component-type-name">@ct.Item3</span>
                                        <small class="component-type-desc">@ct.Item4</small>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Chart Type Selection (Only show if Chart is selected) -->
                        @if (selectedComponentTypeForCustom == 4)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold"><i class="fas fa-chart-bar me-2"></i>Chart Type</label>
                                <div class="chart-type-grid">
                                    @foreach (var ct in new[] {
                                                        ("bar", "fa-chart-bar", "Bar"),
                                                        ("line", "fa-chart-line", "Line"),
                                                        ("pie", "fa-chart-pie", "Pie"),
                                                        ("donut", "fa-ring", "Donut"),
                                                        ("area", "fa-chart-area", "Area"),
                                                        ("scatter", "fa-chart-scatter", "Scatter")
                                                        })
                                    {
                                        <div class="chart-type-option @(customChartType == ct.Item1 ? "selected" : "")"
                                             @onclick="() => customChartType = ct.Item1">
                                            <i class="fas @ct.Item2 fa-2x mb-2"></i>
                                            <span>@ct.Item3</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- KPI Settings (Only show if KPI is selected) -->
                        @if (selectedComponentTypeForCustom == 3)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-bold"><i class="fas fa-cogs me-2"></i>KPI Settings</label>
                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="form-label">Number Format</label>
                                        <select class="form-select" @bind="kpiNumberFormat">
                                            <option value="number">Number (1,234.56)</option>
                                            <option value="currency">Currency ($1,234.56)</option>
                                            <option value="percent">Percentage (12.34%)</option>
                                            <option value="compact">Compact (1.2K)</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Decimal Places</label>
                                        <input type="number" class="form-control" @bind="kpiDecimalPlaces" min="0" max="4" />
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-6">
                                        <label class="form-label">Prefix</label>
                                        <input type="text" class="form-control" @bind="kpiPrefix" placeholder="e.g., $" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Suffix</label>
                                        <input type="text" class="form-control" @bind="kpiSuffix" placeholder="e.g., units" />
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(customChartSql))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold"><i class="fas fa-code me-2"></i>Generated SQL</label>
                                <div class="sql-preview"><pre><code>@customChartSql</code></pre></div>
                            </div>
                        }
                    </div>
                }
                else if (addChartStep == 3)
                {
                    <div class="step-content text-center py-5">
                        <i class="fas fa-check-circle text-success mb-3" style="font-size: 4rem;"></i>
                        <h4 class="mb-3">Component Added Successfully!</h4>
                        <p class="text-muted mb-4">Your @(GetComponentTypeName(selectedComponentTypeForCustom)) has been added to the dashboard</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-lg" @onclick="CloseAddChartModal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>

                @if (addChartStep == 1)
                {
                    <button type="button" class="btn btn-primary btn-lg" @onclick="AnalyzeChartQuery"
                            disabled="@(string.IsNullOrWhiteSpace(customChartQuery) || isAnalyzing)">
                        @if (isAnalyzing)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>Analyzing...</text>
                        }
                        else
                        {
                            <i class="fas fa-arrow-right me-2"></i>
                            <text>Next</text>
                        }
                    </button>
                }
                else if (addChartStep == 2)
                {
                    <button type="button" class="btn btn-outline-secondary btn-lg" @onclick='() => addChartStep = 1'>
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </button>
                    <button type="button" class="btn btn-success btn-lg" @onclick="GenerateSqlAndAddComponent"
                            disabled="@(string.IsNullOrWhiteSpace(customChartTitle) || isGeneratingSql)">
                        @if (isGeneratingSql)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <text>Creating...</text>
                        }
                        else
                        {
                            <i class="fas fa-plus me-2"></i>
                            <text>Add @(GetComponentTypeName(selectedComponentTypeForCustom))</text>
                        }
                    </button>
                }
                else if (addChartStep == 3)
                {
                    <button type="button" class="btn btn-success btn-lg" @onclick="CloseAddChartModal">
                        <i class="fas fa-check me-2"></i>Done
                    </button>
                }
            </div>
        </div>
    </div>
</div>
<!-- Keyboard Shortcuts Modal -->
<div class="modal fade @(showKeyboardShortcutsModal ? "show" : "")" tabindex="-1"
     style="display: @(showKeyboardShortcutsModal ? "block" : "none")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px;">
            <div class="modal-header" style="background: linear-gradient(135deg, #475569 0%, #334155 100%); border: none;">
                <h5 class="modal-title text-white">
                    <i class="fas fa-keyboard me-2"></i>Keyboard Shortcuts
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseKeyboardShortcuts"></button>
            </div>
            <div class="modal-body p-4">
                <div class="shortcuts-grid">
                    <div class="shortcut-category">
                        <h6 class="category-title">
                            <i class="fas fa-arrows-alt me-2 text-primary"></i>Movement
                        </h6>
                        <div class="shortcut-item">
                            <kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd>
                            <span>Move component</span>
                        </div>
                        <div class="shortcut-item">
                            <kbd>Ctrl</kbd> + <kbd>Arrow</kbd>
                            <span>Fast move (3 units)</span>
                        </div>
                        <div class="shortcut-item">
                            <kbd>Shift</kbd> + <kbd>Arrow</kbd>
