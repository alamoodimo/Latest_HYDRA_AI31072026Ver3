<div class="modal fade @(showSettingsModal ? "show" : "")" tabindex="-1"
     style="display: @(showSettingsModal ? "block" : "none")">
    <div class="modal-dialog modal-dialog-centered bh-settings-dialog">
        <div class="modal-content bh-settings">
            <div class="modal-header bh-settings-header">
                <div class="d-flex align-items-center">
                    <div class="bh-settings-icon"><i class="fas fa-sliders-h"></i></div>
                    <div>
                        <h5 class="mb-0 fw-bold text-white">Dashboard Settings</h5>
                        <small class="bh-settings-subtitle">Name your dashboard and choose its data source</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseSettingsModal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold" for="settingsTitle">
                        <i class="fas fa-heading me-2 text-primary"></i>Title <span class="text-danger">*</span>
                    </label>
                    <input id="settingsTitle" type="text" class="form-control" maxlength="200"
                           @bind="settingsTitle" @bind:event="oninput" placeholder="e.g. Sales Overview" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" for="settingsDescription">
                        <i class="fas fa-align-left me-2 text-primary"></i>Description
                    </label>
                    <textarea id="settingsDescription" class="form-control" rows="2"
                              @bind="settingsDescription" placeholder="What is this dashboard about? (optional)"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" for="settingsDatabase">
                        <i class="fas fa-database me-2 text-primary"></i>Database <span class="text-danger">*</span>
                    </label>
                    <select id="settingsDatabase" class="form-select" @bind="settingsDatabaseId">
                        <option value="0">-- Select a Database --</option>
                        @foreach (var ds in availableDataSources)
                        {
                            <option value="@ds.Id">@ds.Name</option>
                        }
                    </select>
                    @if (IsDatabaseChangeWithComponents)
                    {
                        <div class="bh-settings-warning mt-2">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>The existing components were built for another database. Their loaded data will be cleared; regenerate or edit their SQL after applying.</span>
                        </div>
                    }
                </div>

                @if (availableCategories.Any())
                {
                    <div class="mb-1">
                        <label class="form-label fw-bold" for="settingsCategory">
                            <i class="fas fa-folder me-2 text-primary"></i>Category
                        </label>
                        <select id="settingsCategory" class="form-select" @bind="settingsCategoryId">
                            @foreach (var category in availableCategories)
                            {
                                <option value="@category.CategoryID">@category.Name</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseSettingsModal">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="ApplyDashboardSettings" disabled="@(!CanApplySettings)">
                    <i class="fas fa-check me-2"></i>Apply Settings
                </button>
            </div>
        </div>
    </div>
</div>
