    /// <summary>
    /// A component's body. States, in order: label (no data needed), loading, query failed
    /// (message + Retry + Fix with AI), no SQL yet, not loaded yet, no rows, then the content.
    /// </summary>
    private RenderFragment RenderComponentBody(DashboardComponent component) => @<div class="component-body">
        @if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Label)
        {
            <div class="label-display text-center p-3">
                <h5>@component.Title</h5>
                @if (!string.IsNullOrEmpty(component.Description))
                {
                    <p class="text-muted mb-0">@component.Description</p>
                }
            </div>
        }
        else if (IsComponentLoading(component.ComponentID))
        {
            <div class="component-state component-state-loading">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="component-state-title">Loading data...</p>
            </div>
        }
        else if (aiWork.TryGetValue(component.ComponentID, out var work))
        {
            <div class="component-state component-state-working">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="component-state-title">@(work.Mode == ComponentRegenerationMode.Repair ? "Fixing with AI..." : "Generating a replacement...")</p>
                <small class="component-state-message">
                    @GetAiWorkElapsedText(work) - this can take up to @aiFixExpectedSeconds s
                </small>
            </div>
        }
        else if (componentErrors.ContainsKey(component.ComponentID))
        {
            <div class="component-state component-state-error">
                <i class="fas fa-exclamation-triangle"></i>
                <p class="component-state-title">Query failed</p>
                <small class="component-state-message" title="@componentErrors[component.ComponentID]">@componentErrors[component.ComponentID]</small>
                @RenderAiFixNote(component.ComponentID)
                <div class="component-state-actions">
                    <button type="button" class="state-btn" title="Run the query again"
                            @onclick="() => LoadComponentDataAsync(component)"
                            @onclick:stopPropagation="true">
                        <i class="fas fa-redo"></i> Retry
                    </button>
                    @if (!isPreviewMode)
                    {
                        @RenderFixWithAiButton(component, "Ask AI to fix this query using the error above (same title and purpose)")
                    }
                </div>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(component.QueryText))
        {
            <div class="component-state component-state-setup">
                <i class="fas @GetComponentIcon(component.DataViewingTypeID)"></i>
                <p class="component-state-title">@GetComponentTypeName(component.DataViewingTypeID)</p>
                <small class="component-state-message">@(isPreviewMode ? "No query configured." : "Add a SQL query in the properties panel.")</small>
            </div>
        }
        else if (!componentData.ContainsKey(component.ComponentID))
        {
            <div class="component-state component-state-idle">
                <i class="fas @GetComponentIcon(component.DataViewingTypeID)"></i>
                <p class="component-state-title">@GetComponentTypeName(component.DataViewingTypeID)</p>
                <small class="component-state-message">Data not loaded yet.</small>
                <div class="component-state-actions">
                    <button type="button" class="state-btn state-btn-primary" title="Run this component's query"
                            disabled="@(dashboard.DatabaseID <= 0)"
                            @onclick="() => LoadComponentDataAsync(component)"
                            @onclick:stopPropagation="true">
                        <i class="fas fa-play"></i> Load data
                    </button>
                </div>
            </div>
        }
        else if (GetComponentData(component.ComponentID).Count == 0)
        {
            <div class="component-state component-state-empty">
                <i class="fas fa-inbox"></i>
                <p class="component-state-title">No rows returned</p>
                <small class="component-state-message">The query ran successfully but returned no data.</small>
                @RenderAiFixNote(component.ComponentID)
                <div class="component-state-actions">
                    <button type="button" class="state-btn" title="Run the query again"
                            @onclick="() => LoadComponentDataAsync(component)"
                            @onclick:stopPropagation="true">
                        <i class="fas fa-redo"></i> Retry
                    </button>
                    @if (!isPreviewMode)
                    {
                        @RenderFixWithAiButton(component, "Ask AI to adjust this query so it returns data (same title and purpose)")
                    }
                </div>
            </div>
        }
        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Table)
        {
            @RenderTable(component)
        }
        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Number)
        {
            <div class="kpi-display">
                <div class="kpi-value">@FormatNumber(QueryResultHelper.GetKpiValue(GetComponentData(component.ComponentID)))</div>
                @if (!string.IsNullOrEmpty(component.Description))
                {
                    <div class="kpi-description" title="@component.Description">@component.Description</div>
                }
            </div>
        }
        else if (component.DataViewingTypeID == (int)DataViewingTypeEnum.Chart)
        {
            <div id="chart-@component.ComponentID" class="component-chart" style="height: 100%; min-height: 200px;"></div>
        }
        else
        {
            <div class="text-center text-muted p-3">
                <i class="fas fa-cube fa-2x mb-2"></i>
                <p class="mb-0">Component</p>
            </div>
        }
    </div>;

