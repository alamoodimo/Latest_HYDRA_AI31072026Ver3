+    /// <summary>What is wrong with a component, sent to the AI in repair mode.</summary>
+    private string GetComponentProblem(int componentId)
+    {
+        if (componentErrors.TryGetValue(componentId, out var error) && !string.IsNullOrWhiteSpace(error))
+        {
+            return error;
+        }
+
+        return componentData.TryGetValue(componentId, out var rows) && rows?.Count == 0
+            ? "The query ran successfully but returned no rows."
+            : "The query needs to be checked and fixed.";
+    }
+
+    /// <summary>
+    /// Reads the api/assistant/regenerate response, success or failure. On failure the API sends
+    /// { "message": ... }, which maps to Message, so the real reason can be shown.
+    /// </summary>
+    private static async Task<AssistantSuggestionResponse> ReadAssistantResponseAsync(HttpResponseMessage response)
+    {
+        AssistantSuggestionResponse result = null;
+
+        try
+        {
+            var body = await response.Content.ReadAsStringAsync();
+            if (!string.IsNullOrWhiteSpace(body))
+            {
+                result = JsonSerializer.Deserialize<AssistantSuggestionResponse>(body, QueryJsonOptions);
+            }
+        }
+        catch (JsonException)
+        {
+            // Not JSON: fall through to the generic message below.
+        }
+
+        result ??= new AssistantSuggestionResponse();
+
+        if (!response.IsSuccessStatusCode)
+        {
+            result.Success = false;
+        }
+
+        if (!result.Success && string.IsNullOrWhiteSpace(result.Message))
+        {
+            result.Message = $"The AI request failed ({(int)response.StatusCode} {response.ReasonPhrase}).";
+        }
+
+        return result;
+    }
