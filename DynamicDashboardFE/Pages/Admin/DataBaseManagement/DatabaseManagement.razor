	// ✅ Load databases from server
	private async Task LoadDatabasesFromServer()
	{
		if (string.IsNullOrEmpty(databaseModel.ServerAddress) || databaseModel.TypeID <= 0)
		{
			toastService.ShowWarning("Please enter server address and select database type first");
			return;
		}

		isLoadingDatabases = true;
		StateHasChanged();

		try
		{
			var serverInfo = new Database
			{
				ServerAddress = databaseModel.ServerAddress,
				Port = databaseModel.Port,
				TypeID = databaseModel.TypeID,
				Username = databaseModel.Username,
				EncryptedCredentials = databaseModel.EncryptedCredentials,
				SslMode = databaseModel.SslMode,
				AllowPublicKeyRetrieval = databaseModel.AllowPublicKeyRetrieval,
				TrustServerCertificate = databaseModel.TrustServerCertificate
			};

			var response = await Http.PostAsJsonAsync("api/databases/list-databases", serverInfo);

			if (response.IsSuccessStatusCode)
			{
				availableDatabases = await response.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();

				if (availableDatabases.Any())
				{
					toastService.ShowSuccess($"Found {availableDatabases.Count} databases");
				}
				else
				{
					toastService.ShowWarning("No databases found on this server");
				}
			}
			else
			{
				var error = await response.Content.ReadAsStringAsync();
				toastService.ShowError($"Failed to fetch databases: {error}");
				availableDatabases = new List<string>();
			}
		}
		catch (Exception ex)
		{
			toastService.ShowError($"Error: {ex.Message}");
			availableDatabases = new List<string>();
		}
		finally
		{
			isLoadingDatabases = false;
			StateHasChanged();
		}
	}

	// ✅ Toggle password visibility
	private void TogglePasswordVisibility()
	{
		showPassword = !showPassword;
	}

	// ✅ Toggle advanced settings
	private void ToggleAdvancedSettings()
	{
		showAdvancedSettings = !showAdvancedSettings;
	}

	// ✅ Get default port based on database type
	private string GetDefaultPort()
	{
		return databaseModel.TypeID switch
		{
			1 => "1433",  // SQL Server
			2 => "3306",  // MySQL
			3 => "1521",  // Oracle
			4 => "5432",  //PostgreSQL
			_ => "1433"
		};
	}

	// ✅ Get SSL mode hint text
	private string GetSslModeHint()
	{
		return databaseModel.SslMode switch
		{
			"None" => "No encryption (not recommended for production)",
			"Preferred" => "Use SSL if server supports it",
			"Prefer" => "Prefer (For Postgresql)",
			"Required" => "SSL required (recommended for cloud databases)",
			"VerifyCA" => "Verify server certificate authority",
			"VerifyFull" => "Full certificate verification",
			_ => "Select SSL mode for secure connections"
		};
	}

	// ✅ Handle database type change - reset SSL defaults
	private void OnDatabaseTypeChanged(ChangeEventArgs e)
	{
		// Set sensible defaults based on database type
		switch (databaseModel.TypeID)
		{
			case 1: // SQL Server
				databaseModel.SslMode = "Preferred";
				databaseModel.TrustServerCertificate = true;
				databaseModel.Port = databaseModel.Port == 0 ? 1433 : databaseModel.Port;
				break;
			case 2: // MySQL
				databaseModel.SslMode = "Required";
				databaseModel.AllowPublicKeyRetrieval = true;
				databaseModel.Port = databaseModel.Port == 0 ? 3306 : databaseModel.Port;
				break;
			case 3: // Oracle
				databaseModel.SslMode = "Preferred";
				databaseModel.Port = databaseModel.Port == 0 ? 1521 : databaseModel.Port;
				break;
			case 4: // PostgreSQL - ADD THIS CASE
				databaseModel.SslMode = "Prefer";  // PostgreSQL uses "Prefer" not "Preferred"
				databaseModel.Port = databaseModel.Port == 0 ? 5432 : databaseModel.Port;
				break;
		}

		// Clear available databases when type changes
		availableDatabases.Clear();
	}
}