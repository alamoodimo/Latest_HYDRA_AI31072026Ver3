                                                        <div class="col-md-6">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Suggestion:</label>
                                                                <p>@element.Suggestion</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <button class="btn btn-primary green"
                                                            @onclick="() => ApplyUnclearElementSuggestion(element)">
                                                        <i class="fas fa-check me-2"></i> Apply Suggestion
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-success">
                                            <i class="fas fa-check-circle me-2"></i> No unclear elements detected
                                        </div>
                                    }
                                }
                                else if (ActiveAnalysisTab == "relationships")
                                {
                                    <h5>Suggested Relationships</h5>
                                    @if (AnalysisResult.AnalysisData.SuggestedRelationships?.Count > 0)
                                    {
                                        @foreach (var relationship in AnalysisResult.AnalysisData.SuggestedRelationships)
                                        {
                                            <div class="card mb-3 border-success">
                                                <div class="card-header bg-success bg-opacity-25">
