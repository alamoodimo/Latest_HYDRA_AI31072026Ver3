                                            <i class="fas fa-info-circle me-2"></i> No relationship suggestions available
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (SelectedDatabaseId > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-center py-5">
                    <i class="fas fa-database fs-1 text-muted mb-3"></i>
                    <h4>No Schema Available</h4>
                    <p class="text-muted">Click "Refresh Schema" to load the database schema</p>
                    <button class="btn btn-primary green" @onclick="RefreshSchema">
                        <i class="fas fa-sync-alt me-2"></i> Refresh Schema
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-center py-5">
                    <i class="fas fa-database fs-1 text-muted mb-3"></i>
                    <h4>No Database Selected</h4>
                    <p class="text-muted">Please select a database from the dropdown above to begin</p>
                </div>
            </div>
        </div>
    }
</div>
@code
{
    [Parameter] public int? DatabaseId { get; set; }



    private List<Database> Databases = new List<Database>();
    private DatabaseSchema SchemaDetails;
    private SchemaAnalysisResult AnalysisResult;
    private Database CurrentDatabase;
    private int SelectedDatabaseId;

    private bool IsLoading;
    private bool IsAnalyzing;
    private bool IsApplying;
    private bool IsRefreshing;
    private string LoadingMessage = "Loading database metadata...";
    private string ActiveTab = "tables";
    private string ActiveAnalysisTab = "tableNaming";
    private string SearchFilter = "";
    private string TableFilter = "";
    private string ColumnFilter = "";

    private HashSet<string> ExpandedTables = new HashSet<string>();
    private Dictionary<string, bool> SelectedTables = new Dictionary<string, bool>();
    private Dictionary<string, bool> SelectedColumns = new Dictionary<string, bool>();
    private Dictionary<string, bool> SelectedRelationships = new Dictionary<string, bool>();

    private TableSchema SelectedTable;
    private ColumnSchema SelectedColumn;
    private RelationshipSchema SelectedRelationship;

    private bool AnalyzeOnlyEmptyFields = true;

    private List<TableSchema> FilteredTables => GetFilteredTables();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load all databases
            Databases = await Http.GetFromJsonAsync<List<Database>>("api/databases");

            // Set selected database if provided in route
            if (DatabaseId.HasValue && DatabaseId.Value > 0)
            {
                SelectedDatabaseId = DatabaseId.Value;
                await LoadDatabaseSchema();
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error loading databases: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task OnDatabaseChange(ChangeEventArgs e)
    {
        try
        {
            if (int.TryParse(e.Value.ToString(), out int dbId) && dbId != SelectedDatabaseId)
            {
                SelectedDatabaseId = dbId;
                AnalysisResult = null;
                SchemaDetails = null;

                // Update the URL
                NavigationManager.NavigateTo($"/admin/database-metadata-json-analysis/{dbId}");

                if (dbId > 0)
                {
                    await LoadDatabaseSchema();
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error changing database: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task LoadDatabaseSchema()
    {
        if (SelectedDatabaseId <= 0)
            return;

        try
        {
            IsLoading = true;
            LoadingMessage = "Loading database schema...";

            // Get the selected database details
            CurrentDatabase = Databases.FirstOrDefault(d => d.DatabaseID == SelectedDatabaseId);

            // Get database schema
            var response = await Http.GetAsync($"api/DatabaseSchema/GetSchema/{SelectedDatabaseId}");

            if (response.IsSuccessStatusCode)
            {
                var jsonSchema = await response.Content.ReadFromJsonAsync<DatabaseSchema>();

                if (jsonSchema != null && !string.IsNullOrWhiteSpace(jsonSchema.SchemaData))
                {
                    // The schema exists - deserialize it
                    SchemaDetails = await Http.GetFromJsonAsync<DatabaseSchema>($"api/DatabaseSchema/parsed/{SelectedDatabaseId}");
                    InitializeSelectedItems();
                }
                else
                {
                    // No schema exists yet - create a minimal one
                    toastService.ShowWarning("No schema found for this database. Please refresh the schema.");
                }
            }
            else
            {
                toastService.ShowError("Failed to load database schema.");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error loading schema: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task RefreshSchema()
    {
        if (SelectedDatabaseId <= 0)
            return;

        try
        {
            IsRefreshing = true;
            toastService.ShowInfo("Refreshing schema from database...");

            // Force refresh of schema from database (using our new endpoint)
            var response = await Http.PostAsync($"api/DatabaseSchema/refresh/{SelectedDatabaseId}", null);

            if (response.IsSuccessStatusCode)
            {
                // Reload the schema
                SchemaDetails = await response.Content.ReadFromJsonAsync<DatabaseSchema>();
                toastService.ShowSuccess("Schema refreshed successfully");
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                toastService.ShowError("Error refreshing schema: " + errorMessage);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error refreshing schema: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
        finally
        {
            IsRefreshing = false;
        }
    }

    private async Task RunSchemaAnalysis()
    {
        if (SelectedDatabaseId <= 0 || SchemaDetails == null)
            return;

        try
        {
            IsAnalyzing = true;
            toastService.ShowInfo("Analyzing schema with AI...");

            // Call schema analysis API
            var response = await Http.GetAsync($"api/SchemaAnalysis/analyze/{SelectedDatabaseId}");

            if (response.IsSuccessStatusCode)
            {
                AnalysisResult = await response.Content.ReadFromJsonAsync<SchemaAnalysisResult>();

                if (AnalysisResult?.Success == true)
                {
                    toastService.ShowSuccess("Schema analysis completed successfully");

                    // Pre-select all items
                    PreSelectAllItems();

                    // Set active tab based on what has suggestions
                    SetInitialActiveTab();
                }
                else
                {
                    toastService.ShowError("Schema analysis failed: " + AnalysisResult?.ErrorMessage);
                }
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                toastService.ShowError("Error analyzing schema: " + errorMessage);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error during schema analysis: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
        finally
        {
            IsAnalyzing = false;
        }
    }

    private async Task ApplyAnalysisResults()
    {
        if (AnalysisResult?.Success != true || SelectedDatabaseId <= 0)
            return;

        try
        {
            IsApplying = true;

            // Prepare data for API
            var filteredData = new SchemaAnalysisData
                {
                    TableDescriptions = FilterSelectedTableDescriptions(),
                    ColumnDescriptions = FilterSelectedColumnDescriptions(),
                    PotentialConflicts = AnalysisResult.AnalysisData.PotentialConflicts,
                    SuggestedRelationships = AnalysisResult.AnalysisData.SuggestedRelationships,
                    UnclearElements = AnalysisResult.AnalysisData.UnclearElements
                };

            // Call API to apply changes
            var response = await Http.PostAsJsonAsync($"api/SchemaAnalysis/apply/{SelectedDatabaseId}", filteredData);

            if (response.IsSuccessStatusCode)
            {
                var success = await response.Content.ReadFromJsonAsync<bool>();

                if (success)
                {
                    toastService.ShowSuccess("Successfully applied schema changes");

                    // Reload schema to show changes
                    await LoadDatabaseSchema();

                    // Clear analysis results
                    AnalysisResult = null;
                }
                else
                {
                    toastService.ShowError("Failed to apply schema changes");
                }
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                toastService.ShowError("Error applying changes: " + errorMessage);
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error applying changes: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
        finally
        {
            IsApplying = false;
        }
    }

    private void SetActiveTab(string tabName)
    {
        ActiveTab = tabName;
    }

    private void SetActiveAnalysisTab(string tabName)
    {
        ActiveAnalysisTab = tabName;
    }

    private void ToggleTableExpansion(string tableId)
    {
        if (ExpandedTables.Contains(tableId))
        {
            ExpandedTables.Remove(tableId);
        }
        else
        {
            ExpandedTables.Add(tableId);
        }
    }

    private void SelectTable(TableSchema table)
    {
        SelectedTable = table;
        SelectedColumn = null;
        SelectedRelationship = null;
    }

    private void SelectColumn(ColumnSchema column)
    {
        SelectedColumn = column;
        SelectedRelationship = null;
    }

    private void SelectRelationship(RelationshipSchema relationship)
    {
        SelectedRelationship = relationship;
        SelectedColumn = null;
    }

    private List<TableSchema> GetFilteredTables()
    {
        if (SchemaDetails?.Tables == null)
            return new List<TableSchema>();

        var filteredTables = SchemaDetails.Tables.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchFilter))
        {
            filteredTables = filteredTables.Where(t =>
                t.DBName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                (t.FriendlyName?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) == true) ||
                (t.Description?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) == true) ||
                t.Columns.Any(c =>
                    c.DBName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                    (c.FriendlyName?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) == true) ||
                    (c.Description?.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) == true)
                )
            );
        }

        return filteredTables.ToList();
    }

    private List<ColumnSchema> GetFilteredColumns(TableSchema table)
    {
        if (table?.Columns == null)
            return new List<ColumnSchema>();

        var filteredColumns = table.Columns.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(ColumnFilter))
        {
            filteredColumns = filteredColumns.Where(c =>
                c.DBName.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase) ||
                (c.FriendlyName?.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase) == true) ||
                (c.Description?.Contains(ColumnFilter, StringComparison.OrdinalIgnoreCase) == true)
            );
        }

        return filteredColumns.ToList();
    }

    private List<RelationshipSchema> GetFilteredRelationships()
    {
        if (SchemaDetails?.Relationships == null)
            return new List<RelationshipSchema>();

        var filteredRelationships = SchemaDetails.Relationships.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchFilter))
        {
            filteredRelationships = filteredRelationships.Where(r =>
                r.Name.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                r.Source.TableName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                r.Source.ColumnName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                r.Target.TableName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase) ||
                r.Target.ColumnName.Contains(SearchFilter, StringComparison.OrdinalIgnoreCase)
            );
        }

        return filteredRelationships.ToList();
    }

    private TableDescription GetTableAnalysis(TableSchema table)
    {
        if (table == null || AnalysisResult?.AnalysisData?.TableDescriptions == null)
            return null;

        return AnalysisResult.AnalysisData.TableDescriptions
            .FirstOrDefault(t => t.TableName.Equals(table.DBName, StringComparison.OrdinalIgnoreCase));
    }

    private ColumnDescription GetColumnAnalysis(ColumnSchema column, TableSchema table)
    {
        if (column == null || table == null || AnalysisResult?.AnalysisData?.ColumnDescriptions == null)
            return null;

        return AnalysisResult.AnalysisData.ColumnDescriptions
            .FirstOrDefault(c =>
                c.TableName.Equals(table.DBName, StringComparison.OrdinalIgnoreCase) &&
                c.ColumnName.Equals(column.DBName, StringComparison.OrdinalIgnoreCase));
    }

    private bool ShouldApplySuggestion(TableSchema table, TableDescription suggestion)
    {
        if (!AnalyzeOnlyEmptyFields)
            return true;

        return string.IsNullOrWhiteSpace(table.FriendlyName) ||
               string.IsNullOrWhiteSpace(table.Description);
    }

    private bool ShouldApplySuggestion(ColumnSchema column, ColumnDescription suggestion)
    {
        if (!AnalyzeOnlyEmptyFields)
            return true;

        return string.IsNullOrWhiteSpace(column.FriendlyName) ||
               string.IsNullOrWhiteSpace(column.Description);
    }

    private async Task ApplyTableSuggestion(TableSchema table, TableDescription suggestion)
    {
        if (table == null || suggestion == null)
            return;

        try
        {
            if (string.IsNullOrWhiteSpace(table.FriendlyName) || !AnalyzeOnlyEmptyFields)
                table.FriendlyName = suggestion.SuggestedName;

            if (string.IsNullOrWhiteSpace(table.Description) || !AnalyzeOnlyEmptyFields)
                table.Description = suggestion.SuggestedDescription;

            // Save the changes
            await SaveTableChanges(table);

            toastService.ShowSuccess("Applied suggestions to table " + table.DBName);
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error applying table suggestion: " + ex.Message);
        }
    }

    private async Task ApplyColumnSuggestion(ColumnSchema column, ColumnDescription suggestion)
    {
        if (column == null || suggestion == null)
            return;

        try
        {
            if (string.IsNullOrWhiteSpace(column.FriendlyName) || !AnalyzeOnlyEmptyFields)
                column.FriendlyName = suggestion.SuggestedName;

            if (string.IsNullOrWhiteSpace(column.Description) || !AnalyzeOnlyEmptyFields)
                column.Description = suggestion.SuggestedDescription;

            column.IsLookup = suggestion.IsLookupColumn;

            // Save the changes
            await SaveColumnChanges(column);

            toastService.ShowSuccess("Applied suggestions to column " + column.DBName);
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error applying column suggestion: " + ex.Message);
        }
    }

    private async Task SaveTableChanges(TableSchema table)
    {
        if (table == null)
            return;

        try
        {
            // In a real implementation, we would save the changes to the backend
            // For now, we'll just update our local model and simulate a save
            toastService.ShowSuccess("Table changes saved successfully");
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error saving table changes: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task SaveColumnChanges(ColumnSchema column)
    {
        if (column == null)
            return;

        try
        {
            // In a real implementation, we would save the changes to the backend
            // For now, we'll just update our local model and simulate a save
            toastService.ShowSuccess("Column changes saved successfully");
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error saving column changes: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task ApplyConflictResolution(string type, ConflictItem item)
    {
        try
        {
            if (type == "Table")
            {
                var table = SchemaDetails.Tables
                    .FirstOrDefault(t => t.DBName.Equals(item.Name, StringComparison.OrdinalIgnoreCase));

                if (table != null)
                {
                    table.FriendlyName = item.SuggestedResolution;
                    await SaveTableChanges(table);
                    toastService.ShowSuccess("Applied table conflict resolution");
                }
            }
            else if (type == "Column")
            {
                var table = SchemaDetails.Tables
                    .FirstOrDefault(t => t.DBName.Equals(item.TableName, StringComparison.OrdinalIgnoreCase));

                if (table != null)
                {
                    var column = table.Columns
                        .FirstOrDefault(c => c.DBName.Equals(item.Name, StringComparison.OrdinalIgnoreCase));

                    if (column != null)
                    {
                        column.FriendlyName = item.SuggestedResolution;
                        await SaveColumnChanges(column);
                        toastService.ShowSuccess("Applied column conflict resolution");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error applying conflict resolution: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task ApplyUnclearElementSuggestion(UnclearElement element)
    {
        try
        {
            if (element.Type == "Table")
            {
                var table = SchemaDetails.Tables
                    .FirstOrDefault(t => t.DBName.Equals(element.Name, StringComparison.OrdinalIgnoreCase));

                if (table != null)
                {
                    table.Description = element.Suggestion;
                    await SaveTableChanges(table);
                    toastService.ShowSuccess("Applied table suggestion");
                }
            }
            else if (element.Type == "Column")
            {
                var table = SchemaDetails.Tables
                    .FirstOrDefault(t => t.DBName.Equals(element.TableName, StringComparison.OrdinalIgnoreCase));

                if (table != null)
                {
                    var column = table.Columns
                        .FirstOrDefault(c => c.DBName.Equals(element.Name, StringComparison.OrdinalIgnoreCase));

                    if (column != null)
                    {
                        column.Description = element.Suggestion;
                        await SaveColumnChanges(column);
                        toastService.ShowSuccess("Applied column suggestion");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error applying suggestion: " + ex.Message);
            await LogToConsole("Error: " + ex.Message);
        }
    }

    private async Task ToggleTableActive(TableSchema table)
    {
        if (table == null)
            return;

        try
        {
            // Toggle the active status
            table.IsActive = !table.IsActive;

            // Call API to update status
            var response = await Http.PutAsJsonAsync($"api/DatabaseSchema/tables/{SelectedDatabaseId}/{table.ID}/active", table.IsActive);

            if (response.IsSuccessStatusCode)
            {
                var status = table.IsActive ? "active" : "inactive";
                toastService.ShowSuccess($"Table {table.DBName} marked as {status}");
            }
            else
            {
                toastService.ShowError("Failed to update table status");
                // Revert the change
                table.IsActive = !table.IsActive;
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error updating table status: " + ex.Message);
            // Revert the change
            table.IsActive = !table.IsActive;
        }
    }

    private async Task ToggleColumnActive(ColumnSchema column, TableSchema table)
    {
        if (column == null || table == null)
            return;

        try
        {
            // Toggle the active status
            column.IsActive = !column.IsActive;

            // Call API to update status
            var response = await Http.PutAsJsonAsync(
                $"api/DatabaseSchema/columns/{SelectedDatabaseId}/{table.ID}/{column.ID}/active",
                column.IsActive);

            if (response.IsSuccessStatusCode)
            {
                var status = column.IsActive ? "active" : "inactive";
                toastService.ShowSuccess($"Column {column.DBName} marked as {status}");
            }
            else
            {
                toastService.ShowError("Failed to update column status");
                // Revert the change
                column.IsActive = !column.IsActive;
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error updating column status: " + ex.Message);
            // Revert the change
            column.IsActive = !column.IsActive;
        }
    }

    private async Task ToggleRelationshipActive(RelationshipSchema relationship)
    {
        if (relationship == null)
            return;

        try
        {
            // Toggle the active status
            relationship.IsActive = !relationship.IsActive;

            // Call API to update status
            var response = await Http.PutAsJsonAsync(
                $"api/DatabaseSchema/relationships/{SelectedDatabaseId}/{relationship.ID}/active",
                relationship.IsActive);

            if (response.IsSuccessStatusCode)
            {
                var status = relationship.IsActive ? "active" : "inactive";
                toastService.ShowSuccess($"Relationship marked as {status}");
            }
            else
            {
                toastService.ShowError("Failed to update relationship status");
                // Revert the change
                relationship.IsActive = !relationship.IsActive;
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError("Error updating relationship status: " + ex.Message);
            // Revert the change
            relationship.IsActive = !relationship.IsActive;
        }
    }

    private void InitializeSelectedItems()
    {
        SelectedTables.Clear();
        SelectedColumns.Clear();
        SelectedRelationships.Clear();
    }

    private void PreSelectAllItems()
    {
        if (AnalysisResult?.AnalysisData == null)
            return;

        // Pre-select all tables
        if (AnalysisResult.AnalysisData.TableDescriptions != null)
        {
            foreach (var table in AnalysisResult.AnalysisData.TableDescriptions)
            {
                SelectedTables[table.TableName] = true;
            }
        }

        // Pre-select all columns
        if (AnalysisResult.AnalysisData.ColumnDescriptions != null)
        {
            foreach (var column in AnalysisResult.AnalysisData.ColumnDescriptions)
            {
                var key = $"{column.TableName}_{column.ColumnName}";
                SelectedColumns[key] = true;
            }
        }

        // Pre-select all relationships
        if (AnalysisResult.AnalysisData.SuggestedRelationships != null)
        {
            foreach (var relationship in AnalysisResult.AnalysisData.SuggestedRelationships)
            {
                var key = $"{relationship.SourceTable}_{relationship.TargetTable}";
                SelectedRelationships[key] = true;
            }
        }
    }

    private List<TableDescription> FilterSelectedTableDescriptions()
    {
        if (AnalysisResult?.AnalysisData?.TableDescriptions == null)
            return new List<TableDescription>();

        return AnalysisResult.AnalysisData.TableDescriptions
            .Where(t => SelectedTables.ContainsKey(t.TableName) && SelectedTables[t.TableName])
            .ToList();
    }

    private List<ColumnDescription> FilterSelectedColumnDescriptions()
    {
        if (AnalysisResult?.AnalysisData?.ColumnDescriptions == null)
            return new List<ColumnDescription>();

        return AnalysisResult.AnalysisData.ColumnDescriptions
            .Where(c =>
            {
                var key = $"{c.TableName}_{c.ColumnName}";
                return SelectedColumns.ContainsKey(key) && SelectedColumns[key];
            })
            .ToList();
    }

    private void SetInitialActiveTab()
    {
        ActiveTab = "analysis";

        if (AnalysisResult?.AnalysisData == null)
            return;

        if (AnalysisResult.AnalysisData.TableDescriptions?.Count > 0 ||
            AnalysisResult.AnalysisData.ColumnDescriptions?.Count > 0)
        {
            ActiveAnalysisTab = "tableNaming";
        }
        else if (AnalysisResult.AnalysisData.PotentialConflicts?.Count > 0)
        {
            ActiveAnalysisTab = "conflicts";
        }
        else if (AnalysisResult.AnalysisData.UnclearElements?.Count > 0)
        {
            ActiveAnalysisTab = "unclearElements";
        }
        else if (AnalysisResult.AnalysisData.SuggestedRelationships?.Count > 0)
        {
            ActiveAnalysisTab = "relationships";
        }
    }

    private async Task LogToConsole(string message)
    {
        await JSRuntime.InvokeVoidAsync("console.log", message);
    }

}