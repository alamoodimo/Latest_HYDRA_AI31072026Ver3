                                                <div class="card-body">
                                                    <div class="row mb-3">
                                                        <div class="col-md-6">
                                                            <div class="card">
                                                                <div class="card-header bg-light">
                                                                    <h6 class="mb-0">Source</h6>
                                                                </div>
                                                                <div class="card-body">
                                                                    <div><strong>Table:</strong> @relationship.SourceTable.TableName</div>
                                                                    <div><strong>Column:</strong> @relationship.SourceTable.ColumnName</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="card">
                                                                <div class="card-header bg-light">
                                                                    <h6 class="mb-0">Target</h6>
                                                                </div>
                                                                <div class="card-body">
                                                                    <div><strong>Table:</strong> @relationship.TargetTable.TableName</div>
                                                                    <div><strong>Column:</strong> @relationship.TargetTable.ColumnName</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(relationship.Reasoning))
                                                    {
                                                        <div class="mb-3">
                                                            <label class="form-label fw-bold">Reasoning:</label>
                                                            <p>@relationship.Reasoning</p>
