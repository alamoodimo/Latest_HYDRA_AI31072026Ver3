@page "/admin/database-metadata-json-analysis/{DatabaseId:int?}"
@using DynamicDashboardCommon.Models
@using System.Text.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IToastService toastService

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>
                <i class="fas fa-database me-2"></i>Database Schema Analysis
                @if (CurrentDatabase != null)
                {
                    <span class="text-muted fs-5">- @(CurrentDatabase.FriendlyName ?? CurrentDatabase.Name)</span>
                }
            </h2>
            <p class="text-muted">Analyze, improve, and manage your database schema metadata</p>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="SelectedDatabaseId" @bind:event="oninput" @onchange="OnDatabaseChange">
                <option value="0">-- Select Database --</option>
                @foreach (var db in Databases)
                {
                    <option value="@db.DatabaseID">@(db.FriendlyName ?? db.Name)</option>
                }
            </select>
        </div>
    </div>

    @if (IsLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <div class="ms-3">@LoadingMessage</div>
        </div>
    }
    else if (SelectedDatabaseId > 0 && SchemaDetails != null)
    {
        <div class="row">
            <!-- Left Panel: Options and Navigation -->
            <div class="col-md-3">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary bg-opacity-75 text-white">
                        <h5 class="mb-0">Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-secondary" @onclick="RefreshSchema" disabled="@IsRefreshing">
                                @if (IsRefreshing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Refreshing...</span>
                                }
                                else
                                {
                                    <i class="fas fa-sync-alt me-2"></i>
                                    <span>Refresh Schema</span>
                                }
                            </button>

                            <button class="btn btn-primary green" @onclick="RunSchemaAnalysis" disabled="@IsAnalyzing">
                                @if (IsAnalyzing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Analyzing...</span>
                                }
                                else
                                {
                                    <i class="fas fa-magic me-2"></i>
                                    <span>Analyze with AI</span>
                                }
                            </button>

                            <div class="dropdown mt-2">
                                <button class="btn btn-outline-primary dropdown-toggle w-100" type="button" id="viewDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-eye me-2"></i> View
                                </button>
                                <ul class="dropdown-menu w-100" aria-labelledby="viewDropdown">
                                    <li>
                                        <button class="dropdown-item @(ActiveTab == "tables" ? "active" : "")" @onclick='() => SetActiveTab("tables")'>
                                            <i class="fas fa-table me-2"></i> Tables & Columns
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item @(ActiveTab == "relationships" ? "active" : "")" @onclick='() => SetActiveTab(" relationships")'>
                                            <i class="fas fa-link me-2"></i> Relationships
                                        </button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item @(ActiveTab == "analysis" ? "active" : "")" @onclick='() => SetActiveTab(" analysis")'>
                                            <i class="fas fa-chart-bar me-2"></i> Analysis Results
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary bg-opacity-75 text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Search</h5>
                            <button class="btn btn-sm btn-light" @onclick='() => SearchFilter = ""'>
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <input type="text" class="form-control mb-3" placeholder="Search schema..."
                               @bind="SearchFilter" @bind:event="oninput" />

                        <div class="mb-3">
                            <div class="fw-bold mb-2">Statistics</div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Tables:</span>
                                <span class="badge bg-primary">@(SchemaDetails?.Tables?.Count ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span>Columns:</span>
                                <span class="badge bg-primary">
                                    @(SchemaDetails?.Tables?.Sum(t => t.Columns?.Count ?? 0) ?? 0)
                                </span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Relationships:</span>
                                <span class="badge bg-primary">@(SchemaDetails?.Relationships?.Count ?? 0)</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (ActiveTab == "tables")
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary bg-opacity-75 text-white">
                            <h5 class="mb-0">Table List</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            @foreach (var table in FilteredTables)
                            {
                                <button type="button"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(SelectedTable == table ? "active" : "")"
                                        @onclick="() => SelectTable(table)">
                                    <div>
                                        <i class="@(table.IsActive ? "fas" : "far") fa-table me-2"></i>
                                        <span class="@(!table.IsActive ? "text-muted text-decoration-line-through" : "")">
                                            @(string.IsNullOrWhiteSpace(table.FriendlyName) ? table.DBName : table.FriendlyName)
                                        </span>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@(table.Columns?.Count ?? 0)</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Panel: Main Content Area -->
            <div class="col-md-9">
                @if (ActiveTab == "tables")
                {
                    <!-- Tables & Columns View -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary bg-opacity-75 text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    @if (SelectedTable != null)
                                    {
                                        <span>Table: @SelectedTable.DBName</span>
                                    }
                                    else
                                    {
                                        <span>Select a Table</span>
                                    }
                                </h5>

                                @if (SelectedTable != null)
                                {
                                    <div>
                                        <button class="btn btn-sm btn-outline-light me-2" @onclick="() => ToggleTableActive(SelectedTable)">
                                            @if (SelectedTable.IsActive)
                                            {
                                                <i class="fas fa-eye-slash me-1">Mark Inactive</i>
                                                
                                                    }
                                            else
                                            {
                                                <i class="fas fa-eye me-1">Mark Active</i>
                                               
                                                    }
                                        </button>
                                        <button class="btn btn-sm btn-light" @onclick="() => SaveTableChanges(SelectedTable)">
                                            <i class="fas fa-save me-1"></i> Save
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (SelectedTable != null)
                        {
                            <div class="card-body">
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label">Technical Name</label>
                                        <input type="text" class="form-control" value="@SelectedTable.DBName" disabled />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Friendly Name</label>
                                        <input type="text" class="form-control" @bind="SelectedTable.FriendlyName"
                                               placeholder="Enter user-friendly name" />
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label">Description</label>
                                    <textarea class="form-control" rows="3" @bind="SelectedTable.Description"
                                              placeholder="Enter description"></textarea>
                                </div>

                                @{
                                    var tableAnalysis = GetTableAnalysis(SelectedTable);
                                    if (tableAnalysis != null && ShouldApplySuggestion(SelectedTable, tableAnalysis))
                                    {
                                        <div class="alert alert-info">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0">
                                                    <i class="fas fa-lightbulb fs-4 me-3 text-warning"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold mb-2">AI Suggestion:</div>
                                                    <div class="mb-2">
                                                        <strong>Friendly Name:</strong> @tableAnalysis.SuggestedName
                                                    </div>
                                                    <div class="mb-2">
                                                        <strong>Description:</strong> @tableAnalysis.SuggestedDescription
                                                    </div>
                                                    <button class="btn btn-sm btn-primary"
                                                            @onclick="() => ApplyTableSuggestion(SelectedTable, tableAnalysis)">
                                                        <i class="fas fa-magic me-1"></i> Apply Suggestion
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }

                                <div class="mt-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0">Columns</h5>
                                        <div class="input-group input-group-sm" style="max-width: 300px;">
                                            <span class="input-group-text">
                                                <i class="fas fa-search"></i>
                                            </span>
                                            <input type="text" class="form-control" placeholder="Search columns..."
                                                   @bind="ColumnFilter" @bind:event="oninput" />
                                        </div>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-hover table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th style="width: 20%">Technical Name</th>
                                                    <th style="width: 15%">Data Type</th>
                                                    <th style="width: 20%">Friendly Name</th>
                                                    <th style="width: 30%">Description</th>
                                                    <th style="width: 15%">Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var column in GetFilteredColumns(SelectedTable))
                                                {
                                                    <tr class="@(!column.IsActive ? "table-secondary" : "")">
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                @if (column.IsPrimaryKey)
                                                                {
                                                                    <span class="badge bg-warning me-1" title="Primary Key">PK</span>
                                                                }
                                                                @if (column.IsLookup)
                                                                {
                                                                    <span class="badge bg-info me-1" title="Foreign Key">FK</span>
                                                                }
                                                                <span class="@(!column.IsActive ? "text-decoration-line-through" : "")">
                                                                    @column.DBName
                                                                </span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <small>@column.DataType</small>
                                                            @if (column.IsNullable)
                                                            {
                                                                <span class="badge bg-secondary ms-1">Nullable</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <input type="text" class="form-control form-control-sm"
                                                                   @bind="column.FriendlyName"
                                                                   placeholder="Enter friendly name" />
                                                        </td>
                                                        <td>
                                                            <textarea class="form-control form-control-sm" rows="1"
                                                                      @bind="column.Description"
                                                                      placeholder="Enter description"></textarea>
                                                        </td>
                                                        <td>
                                                            <div class="btn-group btn-group-sm">
                                                                <button class="btn btn-outline-primary"
                                                                        @onclick="() => ToggleColumnActive(column, SelectedTable)"
                                                                        title="@(column.IsActive ? "Mark as inactive" : "Mark as active")">
                                                                    <i class="@(column.IsActive ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                                                </button>

                                                                @{
                                                                    var columnAnalysis = GetColumnAnalysis(column, SelectedTable);
                                                                    if (columnAnalysis != null && ShouldApplySuggestion(column, columnAnalysis))
                                                                    {
                                                                        <button class="btn btn-outline-warning"
                                                                                @onclick="() => ApplyColumnSuggestion(column, columnAnalysis)"
                                                                                title="Apply AI suggestion">
                                                                            <i class="fas fa-magic"></i>
                                                                        </button>
                                                                    }
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="d-flex justify-content-end mt-3">
                                        <button class="btn btn-primary green" @onclick="() => SaveColumnChanges(null)">
                                            <i class="fas fa-save me-1"></i> Save All Columns
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-body">
                                <div class="text-center py-5">
                                    <i class="fas fa-table fs-1 text-muted mb-3"></i>
                                    <h5>Select a table to view and edit its details</h5>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (ActiveTab == "relationships")
                {
                    <!-- Relationships View -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary bg-opacity-75 text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Relationships</h5>
                                <button class="btn btn-sm btn-light">
                                    <i class="fas fa-plus me-1"></i> Add Relationship
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Source Table</th>
                                            <th>Source Column</th>
                                            <th>Relationship</th>
                                            <th>Target Table</th>
                                            <th>Target Column</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var relationship in GetFilteredRelationships())
                                        {
                                            <tr class="@(!relationship.IsActive ? "table-secondary" : "")">
                                                <td>@relationship.Source.TableName</td>
                                                <td>@relationship.Source.ColumnName</td>
                                                <td>
                                                    <span class="badge bg-info">@relationship.Type</span>
                                                </td>
                                                <td>@relationship.Target.TableName</td>
                                                <td>@relationship.Target.ColumnName</td>
                                                <td>
                                                    @if (relationship.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm">
                                                        <button class="btn btn-outline-primary"
                                                                @onclick="() => ToggleRelationshipActive(relationship)"
                                                                title="@(relationship.IsActive ? "Mark as inactive" : "Mark as active")">
                                                            <i class="@(relationship.IsActive ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                                        </button>
                                                        <button class="btn btn-outline-danger" title="Delete relationship">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (ActiveTab == "analysis")
                {
                    <!-- Analysis Results View -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-primary bg-opacity-75 text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">Analysis Results</h5>
                                <div>
                                    @if (AnalysisResult == null)
                                    {
                                        <button class="btn btn-sm btn-light" @onclick="RunSchemaAnalysis">
                                            <i class="fas fa-magic me-1"></i> Run Analysis
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success me-2" @onclick="ApplyAnalysisResults">
                                            <i class="fas fa-check me-1"></i> Apply All
                                        </button>
                                        <button class="btn btn-sm btn-light" @onclick="RunSchemaAnalysis">
                                            <i class="fas fa-redo me-1"></i> Re-Analyze
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (AnalysisResult == null)
                        {
                            <div class="card-body">
                                <div class="text-center py-5">
                                    <i class="fas fa-chart-bar fs-1 text-muted mb-3"></i>
                                    <h5>No analysis results available</h5>
                                    <p class="text-muted">Click "Run Analysis" to analyze your schema with AI</p>
                                    <button class="btn btn-primary green" @onclick="RunSchemaAnalysis">
                                        <i class="fas fa-magic me-1"></i> Run Analysis
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <ul class="nav nav-tabs mt-2 px-3">
                                <li class="nav-item">
                                    <button class="nav-link @(ActiveAnalysisTab == "tableNaming" ? "active" : "")"
                                            @onclick='() => SetActiveAnalysisTab(" tableNaming")'>
                                        <i class="fas fa-tags me-1"></i> Table & Column Naming
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(ActiveAnalysisTab == "conflicts" ? "active" : "")"
                                            @onclick='() => SetActiveAnalysisTab(" conflicts")'>
                                        <i class="fas fa-exclamation-triangle me-1"></i> Conflicts
                                        @if (AnalysisResult.AnalysisData.PotentialConflicts?.Count > 0)
                                        {
                                            <span class="badge bg-danger ms-1">@AnalysisResult.AnalysisData.PotentialConflicts.Count</span>
                                        }
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(ActiveAnalysisTab == "unclearElements" ? "active" : "")"
                                            @onclick='() => SetActiveAnalysisTab(" unclearElements")'>
                                        <i class="fas fa-question-circle me-1"></i> Unclear Elements
                                        @if (AnalysisResult.AnalysisData.UnclearElements?.Count > 0)
                                        {
                                            <span class="badge bg-warning ms-1">@AnalysisResult.AnalysisData.UnclearElements.Count</span>
                                        }
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(ActiveAnalysisTab == "relationships" ? "active" : "")"
                                            @onclick='() => SetActiveAnalysisTab(" relationships")'>
                                        <i class="fas fa-link me-1"></i> Suggested Relationships
                                        @if (AnalysisResult.AnalysisData.SuggestedRelationships?.Count > 0)
                                        {
                                            <span class="badge bg-success ms-1">@AnalysisResult.AnalysisData.SuggestedRelationships.Count</span>
                                        }
                                    </button>
                                </li>
                            </ul>

                            <div class="card-body">
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" id="onlyEmptyFields"
                                           @bind="AnalyzeOnlyEmptyFields" />
                                    <label class="form-check-label" for="onlyEmptyFields">
                                        Only suggest changes for empty fields
                                    </label>
                                </div>

                                @if (ActiveAnalysisTab == "tableNaming")
                                {
                                    <div class="mb-4">
                                        <h5>Table Naming Suggestions</h5>
                                        @if (AnalysisResult.AnalysisData.TableDescriptions?.Count > 0)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-hover table-bordered">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 20%">Technical Name</th>
                                                            <th style="width: 25%">Suggested Name</th>
                                                            <th style="width: 40%">Suggested Description</th>
                                                            <th style="width: 15%">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var tableDesc in AnalysisResult.AnalysisData.TableDescriptions)
                                                        {
                                                            var table = SchemaDetails.Tables.FirstOrDefault(
                                                            t => t.DBName.Equals(tableDesc.TableName, StringComparison.OrdinalIgnoreCase));

                                                            if (table != null && ShouldApplySuggestion(table, tableDesc))
                                                            {
                                                                <tr>
                                                                    <td>@tableDesc.TableName</td>
                                                                    <td>@tableDesc.SuggestedName</td>
                                                                    <td>@tableDesc.SuggestedDescription</td>
                                                                    <td>
                                                                        <button class="btn btn-sm btn-primary"
                                                                                @onclick="() => ApplyTableSuggestion(table, tableDesc)">
                                                                            <i class="fas fa-magic me-1"></i> Apply
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i> No table naming suggestions available
                                            </div>
                                        }
                                    </div>

                                    <div>
                                        <h5>Column Naming Suggestions</h5>
                                        @if (AnalysisResult.AnalysisData.ColumnDescriptions?.Count > 0)
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-hover table-bordered">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th style="width: 15%">Table</th>
                                                            <th style="width: 15%">Column</th>
                                                            <th style="width: 20%">Suggested Name</th>
                                                            <th style="width: 35%">Suggested Description</th>
                                                            <th style="width: 15%">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var columnDesc in AnalysisResult.AnalysisData.ColumnDescriptions)
                                                        {
                                                            var table = SchemaDetails.Tables.FirstOrDefault(
                                                            t => t.DBName.Equals(columnDesc.TableName, StringComparison.OrdinalIgnoreCase));

                                                            if (table != null)
                                                            {
                                                                var column = table.Columns.FirstOrDefault(
                                                                c => c.DBName.Equals(columnDesc.ColumnName, StringComparison.OrdinalIgnoreCase));

                                                                if (column != null && ShouldApplySuggestion(column, columnDesc))
                                                                {
                                                                    <tr>
                                                                        <td>@columnDesc.TableName</td>
                                                                        <td>@columnDesc.ColumnName</td>
                                                                        <td>@columnDesc.SuggestedName</td>
                                                                        <td>@columnDesc.SuggestedDescription</td>
                                                                        <td>
                                                                            <button class="btn btn-sm btn-primary"
                                                                                    @onclick="() => ApplyColumnSuggestion(column, columnDesc)">
                                                                                <i class="fas fa-magic me-1"></i> Apply
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i> No column naming suggestions available
                                            </div>
                                        }
                                    </div>
                                }
                                else if (ActiveAnalysisTab == "conflicts")
                                {
                                    <h5>Potential Naming Conflicts</h5>
                                    @if (AnalysisResult.AnalysisData.PotentialConflicts?.Count > 0)
                                    {
                                        @foreach (var conflict in AnalysisResult.AnalysisData.PotentialConflicts)
                                        {
                                            <div class="card mb-3 border-warning">
                                                <div class="card-header bg-warning bg-opacity-25">
                                                    <div class="d-flex align-items-center">
                                                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                                                        <h6 class="mb-0">@conflict.Type Naming Conflict</h6>
                                                    </div>
                                                </div>
                                                <div class="card-body">
                                                    <p>@conflict.ConflictDescription</p>
                                                    <div class="table-responsive">
                                                        <table class="table table-sm">
                                                            <thead>
                                                                <tr>
                                                                    <th>Name</th>
                                                                    @if (conflict.Type == "Column")
                                                                    {
                                                                        <th>Table</th>
                                                                    }
                                                                    <th>Suggested Resolution</th>
                                                                    <th>Actions</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var item in conflict.Items)
                                                                {
                                                                    <tr>
