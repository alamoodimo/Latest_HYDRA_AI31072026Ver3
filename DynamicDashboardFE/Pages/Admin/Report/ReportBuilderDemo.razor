@code {
    // UI State
    bool showGenerationCard = true;
    bool showAssistant = false;
    bool showExportModal = false;
    bool showAddModal = false;
    bool showAIModal = false;
    bool showToastMsg = false;

    // Section States
    bool section1Open = true;
    bool section2Open = true;
    bool section3Open = false;

    // Form Data
    string reportTitle = "Q4 Sales Performance Report";
    string selectedDb = "sales";
    string prompt = "";
    string chatInput = "";
    string aiPrompt = "";
    string exportFormat = "pdf";
    string toastText = "Action completed!";

    // Chat Messages (mock)
    List<ChatMsg> chatMessages = new();

    void GenerateReport()
    {
        showGenerationCard = false;
    }

    void ShowToast()
    {
        toastText = "Action completed successfully!";
        showToastMsg = true;
        Task.Delay(3000).ContinueWith(_ => { showToastMsg = false; InvokeAsync(StateHasChanged); });
    }

    void AddChat(string text)
    {
        chatMessages.Add(new ChatMsg { Type = "user", Text = text });
        Task.Delay(500).ContinueWith(_ =>
        {
            chatMessages.Add(new ChatMsg { Type = "assistant", Text = "I'll help you with that! This is a demo response." });
            InvokeAsync(StateHasChanged);
        });
    }

    void SendChat()
    {
        if (!string.IsNullOrWhiteSpace(chatInput))
        {
            AddChat(chatInput);
            chatInput = "";
        }
    }

    class ChatMsg { public string Type; public string Text; }
}