@page "/testautomation"
@using DynamicDashboardCommon.Models;
@using DynamicDashboardFE.Components
@using DynamicDashboardFE.Components.TestDashboard
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject IToastService toastService
@inject NavigationManager NavigationManager


<div class="test-dashboard-container">
	<div class="comparison-toggle @(showComparisonModal || showComparisonView ? "visible" : "")">
		<button class="btn btn-toggle" @onclick="ToggleComparisonView">
			<i class="fas @(showComparisonModal ? "fa-expand-alt" : "fa-compress-alt")"></i>
			<span>@(showComparisonModal ? "Enhanced View" : "Simple View")</span>
		</button>
	</div>
	<div class="dashboard-header">
		<h1>
			<i class="fas fa-vial me-2"></i>
			NL Query Test Automation
		</h1>

		<div class="header-actions">
			<button class="btn btn-outline-primary me-2" @onclick="DownloadTemplate">
				<i class="fas fa-file-download me-1"></i> Get Template
			</button>
			<button class="btn btn-outline-primary" @onclick="DownloadSampleQuestions">
				<i class="fas fa-lightbulb me-1"></i> Sample Questions
			</button>
		</div>
	</div>

	<div class="comparison-toggle @(showComparisonModal || showComparisonView ? "visible" : "")">
		<button class="btn btn-toggle" @onclick="ToggleComparisonView">
			<i class="fas @(showComparisonModal ? "fa-expand-alt" : "fa-compress-alt")"></i>
			<span>@(showComparisonModal ? "Enhanced View" : "Simple View")</span>
		</button>
	</div>

	<div class="dashboard-tabs">
		<div class="tab @(activeTab == "upload" ? "active" : "")" @onclick='() => SetActiveTab("upload")'>
			<i class="fas fa-upload me-2"></i> Upload Tests
		</div>
		<div class="tab @(activeTab == "history" ? "active" : "")" @onclick='() => SetActiveTab("history")'>
			<i class="fas fa-history me-2"></i> Test History
		</div>
		@if (selectedJob != null)
		{
			<div class="tab @(activeTab == "results" ? "active" : "")" @onclick='() => SetActiveTab("results")'>
				<i class="fas fa-chart-bar me-2"></i> Test Results
			</div>
		}
		<div class="tab @(activeTab == "import" ? "active" : "")" @onclick='() => SetActiveTab("import")'>
			<i class="fas fa-history me-2"></i> Import Excel From JSON
		</div>
	</div>

	<div class="dashboard-content">
		@if (activeTab == "upload")
		{
			<div class="upload-section animate__animated animate__fadeIn">
				<div class="upload-card">
					<div class="upload-header">
						<h3><i class="fas fa-cogs me-2"></i>Configure Test Run</h3>
					</div>
					<div class="upload-form">
						<div class="form-group">
							<label for="database-select">Select Database Schema:</label>
							<select id="database-select" class="form-select" @bind="selectedDatabaseId">
								<option value="0">-- Select Database --</option>
								@foreach (var db in databases)
								{
									<option value="@db.DatabaseID">@(db.FriendlyName ?? db.Name)</option>
								}
							</select>
							<button class="btn btn-outline-info ms-2" @onclick='CopyOptimizedSchema' disabled="@(selectedDatabaseId <= 0)">
								<i class="fas fa-copy me-1"></i> Copy Schema
							</button>
						</div>

						<div class="form-group">
							<label for="llm-select">Select LLM Provider:</label>
							<select id="llm-select" class="form-select" @bind="selectedLlmProvider">
								<option value="">-- Select LLM Provider --</option>
								<option value="claude">Claude</option>
								<option value="deepseek">DeepSeek</option>
								<option value="sqlcoder">SQLCoder</option>
								<option value="databricks">Databricks</option>
							</select>
						</div>

						<div class="form-group">
							<label>Upload Test File:</label>
							<div class="file-upload-container">
								<InputFile OnChange="OnFileSelected" class="file-input" accept=".xlsx" />
								<div class="file-upload-button">
									<i class="fas fa-file-excel me-2"></i>
									<span>@(selectedFile?.Name ?? "Choose Excel File")</span>
								</div>
							</div>
							@if (selectedFile != null)
							{
								<small class="text-muted">Size: @(FormatFileSize(selectedFile.Size))</small>
							}
						</div>

						<div class="form-actions">
							<button class="btn btn-primary green" @onclick="RunTests" disabled="@(isUploading || !CanRunTests())">
								@if (isUploading)
								{
									<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
									<span>Processing...</span>
								}
								else
								{
									<span><i class="fas fa-play me-2"></i>Run Tests</span>
								}
							</button>
						</div>
					</div>
				</div>

				@if (isUploading)
				{
					<div class="progress-container animate__animated animate__fadeIn">
						<div class="progress-card">
							<h4>Processing Test Cases</h4>
							<div class="progress" style="height: 10px;">
								<div class="progress-bar progress-bar-striped progress-bar-animated"
									 role="progressbar"
									 style="width: 100%"></div>
							</div>
							<p class="mt-3">
								<i class="fas fa-info-circle me-2"></i>
								This may take several minutes depending on the number of test cases.
							</p>
						</div>
					</div>
				}
			</div>
		}
		else if (activeTab == "history")
		{
			<div class="history-section animate__animated animate__fadeIn">
				<div class="history-header">
					<h3><i class="fas fa-history me-2"></i>Test Run History</h3>
					<button class="btn btn-sm btn-outline-primary" @onclick="RefreshJobs">
						<i class="fas fa-sync-alt me-1"></i> Refresh
					</button>
				</div>

				@if (isLoading)
				{
					<div class="loading-container">
						<div class="spinner-border text-primary" role="status">
							<span class="visually-hidden">Loading...</span>
						</div>
						<p>Loading history...</p>
					</div>
				}
				else if (testJobs == null || !testJobs.Any())
				{
					<div class="empty-state">
						<i class="fas fa-file-excel fa-4x mb-3"></i>
						<h4>No test runs found</h4>
						<p>Upload a test file to get started.</p>
					</div>
				}
				else
				{
					<div class="job-cards">
						@foreach (var job in testJobs)
						{
							<div class="job-card @(selectedJob?.JobID == job.JobID ? "active" : "")"
								 @onclick="() => SelectJob(job)">
								<div class="job-header">
									<h4 class="job-title"><i class="fas fa-tasks me-2"></i>@job.FileName</h4>
									<div class="job-date">@job.ExecutedAt.ToString("MMM dd, yyyy HH:mm")</div>
								</div>
								<div class="job-stats">
									<div class="stat-item">
										<div class="stat-value">@job.TotalQuestions</div>
										<div class="stat-label">Total</div>
									</div>
									<div class="stat-item">
										<div class="stat-value">@job.SuccessCount</div>
										<div class="stat-label">Success</div>
									</div>
									<div class="stat-item">
										<div class="stat-value">@(job.TotalQuestions - job.SuccessCount)</div>
										<div class="stat-label">Failed</div>
									</div>
									<div class="stat-item">
										<div class="stat-value">@GetSuccessRate(job)%</div>
										<div class="stat-label">Success Rate</div>
									</div>
								</div>
								<div class="job-details">
									<div class="detail-item">
										<i class="fas fa-database me-1"></i>
										<span>DB ID: @job.DatabaseSchemaID</span>
									</div>
									<div class="detail-item">
										<i class="fas fa-robot me-1"></i>
										<span>LLM: @job.LLMUsed</span>
									</div>
								</div>
								<div class="job-scores">
									@*                                     <div class="score-item" title="SQL Match Score">
                                        <div class="score-label">SQL</div>
                                        <div class="score-bar">
                                            <div class="score-progress" style="width: @(job.AverageQueryMatchScore * 100)%"></div>
                                        </div>
                                        <div class="score-value">@FormatPercent(job.AverageQueryMatchScore)</div>
                                    </div>
                                    <div class="score-item" title="Explanation Match Score">
                                        <div class="score-label">Expl</div>
                                        <div class="score-bar">
                                            <div class="score-progress" style="width: @(job.AverageExplanationMatchScore * 100)%"></div>
                                        </div>
                                        <div class="score-value">@FormatPercent(job.AverageExplanationMatchScore)</div>
                                    </div> *@
									<div class="score-item" title="Data Match Score">
										<div class="score-label">Data</div>
										<div class="score-bar">
											<div class="score-progress" style="width: @(job.AverageDataMatchScore * 100)%"></div>
										</div>
										<div class="score-value">@FormatPercent(job.AverageDataMatchScore)</div>
									</div>
								</div>
								<div class="job-actions">
									<button class="btn btn-sm btn-outline-primary"
											@onclick:stopPropagation="true" @onclick="() => ViewJobDetails(job)">
										<i class="fas fa-chart-bar me-1"></i> View Details
									</button>
								</div>
							</div>
						}
					</div>
				}
			</div>
		}
		else if (activeTab == "results" && selectedJob != null)
		{
			<div class="results-section animate__animated animate__fadeIn">
				<div class="results-header">
					<h3>
						<i class="fas fa-chart-bar me-2"></i>
						Results for @selectedJob.FileName
					</h3>
					<div class="header-actions">
						<button class="btn btn-sm btn-outline-secondary" @onclick="DownloadResults">
							<i class="fas fa-file-download me-1"></i> Download Results
						</button>
					</div>
				</div>

				<div class="results-summary">
					<div class="summary-card">
						<div class="summary-header">
							<h4>Test Summary</h4>
						</div>
						<div class="summary-body">
							<div class="summary-stats">
								<div class="stat-item">
									<div class="stat-value">@selectedJob.TotalQuestions</div>
									<div class="stat-label">Total Questions</div>
								</div>
								<div class="stat-item">
									<div class="stat-value success">@selectedJob.SuccessCount</div>
									<div class="stat-label">Successful</div>
								</div>
								<div class="stat-item">
									<div class="stat-value error">@(selectedJob.TotalQuestions - selectedJob.SuccessCount)</div>
									<div class="stat-label">Failed</div>
								</div>
								<div class="stat-item">
									<div class="stat-value">@GetSuccessRate(selectedJob)%</div>
									<div class="stat-label">Success Rate</div>
								</div>
							</div>

							<div class="donut-chart-container">
								<div id="successRateChart" class="donut-chart"></div>
							</div>
						</div>
					</div>

					<div class="score-cards">
						@*                         <div class="score-card">
                            <div class="score-card-header">
                                <h5>SQL Match Score</h5>
                            </div>
                            <div class="score-card-value @GetScoreClass(selectedJob.AverageQueryMatchScore)">
                                @FormatPercent(selectedJob.AverageQueryMatchScore)
                            </div>
                            <div class="score-card-gauge">
                                <div class="gauge-background"></div>
                                <div class="gauge-fill @GetScoreClass(selectedJob.AverageQueryMatchScore)" 
                                     style="width: @(selectedJob.AverageQueryMatchScore * 100)%"></div>
                            </div>
                        </div>

                        <div class="score-card">
                            <div class="score-card-header">
                                <h5>Explanation Match</h5>
                            </div>
                            <div class="score-card-value @GetScoreClass(selectedJob.AverageExplanationMatchScore)">
                                @FormatPercent(selectedJob.AverageExplanationMatchScore)
                            </div>
                            <div class="score-card-gauge">
                                <div class="gauge-background"></div>
                                <div class="gauge-fill @GetScoreClass(selectedJob.AverageExplanationMatchScore)" 
                                     style="width: @(selectedJob.AverageExplanationMatchScore * 100)%"></div>
                            </div>
                        </div> *@

						<div class="score-card">
							<div class="score-card-header">
								<h5>Data Match Score</h5>
							</div>
							<div class="score-card-value @GetScoreClass(selectedJob.AverageDataMatchScore)">
								@FormatPercent(selectedJob.AverageDataMatchScore)
							</div>
							<div class="score-card-gauge">
								<div class="gauge-background"></div>
								<div class="gauge-fill @GetScoreClass(selectedJob.AverageDataMatchScore)"
									 style="width: @(selectedJob.AverageDataMatchScore * 100)%"></div>
							</div>
						</div>
					</div>
				</div>

				<div class="results-details">
					<div class="details-header">
						<h4><i class="fas fa-list me-2"></i>Test Case Details</h4>
						<div class="filter-controls">
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="filter-all"
									   checked="@(detailsFilter == "all")"
									   @onchange="@(e => SetDetailsFilter("all"))" />
								<label class="form-check-label" for="filter-all">All</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="filter-success"
									   checked="@(detailsFilter == "success")"
									   @onchange="@(e => SetDetailsFilter("success"))" />
								<label class="form-check-label" for="filter-success">Success</label>
							</div>
							<div class="form-check form-check-inline">
								<input class="form-check-input" type="checkbox" id="filter-failed"
									   checked="@(detailsFilter == "failed")"
									   @onchange="@(e => SetDetailsFilter("failed"))" />
								<label class="form-check-label" for="filter-failed">Failed</label>
							</div>
						</div>
					</div>

					@if (isLoadingDetails)
					{
						<div class="loading-container">
							<div class="spinner-border text-primary" role="status">
								<span class="visually-hidden">Loading...</span>
							</div>
							<p>Loading test details...</p>
						</div>
					}
					else if (testDetails == null || !testDetails.Any())
					{
						<div class="empty-state">
							<i class="fas fa-clipboard-list fa-4x mb-3"></i>
							<h4>No test details available</h4>
							<p>Test details could not be loaded.</p>
						</div>
					}
					else
					{
						<div class="details-table-container">
							<table class="details-table">
								<thead>
									<tr>
										<th style="width: 50px">#</th>
										<th>Question</th>
										<th style="width: 120px">Category</th>
										<th style="width: 100px">Complexity</th>
										@*                                         <th style="width: 100px">SQL Match</th>
                                        <th style="width: 100px">Explanation</th> *@
										<th style="width: 100px">Data Match</th>
										<th style="width: 80px">Status</th>
										<th style="width: 100px">Actions</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var detail in filteredDetails)
									{
										<tr class="@(detail.Success ? "" : "error-row")">
											<td>@detail.DetailID</td>
											<td>@detail.Question</td>
											<td>@detail.QueryCategory</td>
											<td>@detail.ComplexityLevel</td>
											@*                                             <td>
                                                <div class="score-pill @GetScoreClass(detail.SQLMatchScore)">
                                                    @FormatPercent(detail.SQLMatchScore)
                                                </div>
                                            </td>
                                            <td>
                                                <div class="score-pill @GetScoreClass(detail.ExplanationMatchScore)">
                                                    @FormatPercent(detail.ExplanationMatchScore)
                                                </div>
                                            </td> *@
											<td>
												<div class="score-pill @GetScoreClass(detail.DataMatchScore)">
													@FormatPercent(detail.DataMatchScore)
												</div>
											</td>
											<td>
												@if (detail.Success)
												{
													<div class="status-badge success">Success</div>
												}
												else
												{
													<div class="status-badge error">Failed</div>
												}
											</td>
											<td>
												<button class="btn btn-sm btn-outline-primary"
														@onclick='() => ViewDetailComparison(detail)'>
													View
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<div class="pagination-controls">
							<div class="page-info">
								Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, totalDetailsCount) of @totalDetailsCount items
							</div>
							<div class="pagination">
								<button class="btn btn-sm btn-outline-secondary @(currentPage == 1 ? "disabled" : "")"
										@onclick="PreviousPage" disabled="@(currentPage == 1)">
									<i class="fas fa-chevron-left"></i>
								</button>

								@for (int i = startPage; i <= endPage; i++)
								{
									var pageNumber = i;
									<button class="btn btn-sm @(currentPage == pageNumber ? "btn-primary" : "btn-outline-secondary")"
											@onclick="() => GoToPage(pageNumber)">
										@pageNumber
									</button>
								}

								<button class="btn btn-sm btn-outline-secondary @(currentPage == totalPages ? "disabled" : "")"
										@onclick="NextPage" disabled="@(currentPage == totalPages)">
									<i class="fas fa-chevron-right"></i>
								</button>
							</div>
						</div>
					}
				</div>
			</div>
		}


		else if (activeTab == "import")
		{
			<div class="import-json-section">
				<div class="card">
					<div class="card-header bg-primary text-white">
						<h4><i class="fas fa-file-import me-2"></i>Import JSON Test Cases</h4>
					</div>
					<div class="card-body">
						<div class="form-group mb-3">
							<label>Paste JSON Test Cases:</label>
							<textarea class="form-control" rows="8" @bind="jsonTestCases"  placeholder="Paste your JSON test cases here..."></textarea>
							<small class="form-text text-muted">
								Format: {"databaseId":5,"testCases":[{"question":"Show me all customers from the database","expectedSql":"SELECT * FROM customers","expectedExplanation":"This query retrieves all customer records from the customers table.","complexityLevel":"Simple","queryCategory":"Filter"}]}
							</small>
						</div>
						<div class="form-group d-flex justify-content-between">
							<button class="btn btn-outline-secondary" @onclick="ClearJsonInput">
								<i class="fas fa-eraser me-2"></i>Clear
							</button>
							<button class="btn btn-primary green" @onclick="ImportJsonTestCases" disabled="@string.IsNullOrWhiteSpace(jsonTestCases)">
								<i class="fas fa-file-excel me-2"></i>Generate Excel Template
							</button>
						</div>
					</div>
				</div>
			</div>
		}
	</div>

	@if (showComparisonModal && selectedDetail != null)
{
    <div class="modal-backdrop animate__animated animate__fadeIn" @onclick="CloseComparisonView"></div>
    <div class="comparison-modal animate__animated animate__fadeInUp">
        <div class="modal-header">
            <h3>Test Case Comparison</h3>
            <div class="header-actions">
                <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick='() => ViewDetailComparisonEnhanced(selectedDetail)'>
                    <i class="fas fa-expand-alt me-1"></i> Enhanced View
                </button>
                <button type="button" class="btn-close" @onclick="CloseComparisonView"></button>
            </div>
        </div>
        <div class="modal-body">
            <div class="detail-section">
                <h4>Question</h4>
                <div class="question-box">@selectedDetail.Question</div>

                <div class="detail-meta">
                    <div class="meta-item">
                        <span class="meta-label">Category:</span>
                        <span class="meta-value">@selectedDetail.QueryCategory</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Complexity:</span>
                        <span class="meta-value">@selectedDetail.ComplexityLevel</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Status:</span>
                        <span class="meta-value @(selectedDetail.Success ? "success" : "error")">
                            @(selectedDetail.Success ? "Success" : "Failed")
                        </span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Execution Time:</span>
                        <span class="meta-value">@(selectedDetail.ExecutionTimeMs) ms</span>
                    </div>
                </div>
            </div>

            <div class="comparison-tabs">
                <div class="tab @(activeComparisonTab == "sql" ? "active" : "")"
                     @onclick='() => SetActiveComparisonTab("sql")'>
                    SQL Comparison
                </div>
                <div class="tab @(activeComparisonTab == "explanation" ? "active" : "")"
                     @onclick='() => SetActiveComparisonTab("explanation")'>
                    Explanation
                </div>
                <div class="tab @(activeComparisonTab == "data" ? "active" : "")"
                     @onclick='() => SetActiveComparisonTab("data")'>
                    Data Results
                </div>
            </div>

            @if (activeComparisonTab == "sql")
            {
                <div class="comparison-content animate__animated animate__fadeIn">
                    <div class="comparison-header">
                        <h5>
                            SQL Comparison
@*                             <span class="score-badge @GetScoreClass(selectedDetail.SQLMatchScore)">
                                Match Score: @FormatPercent(selectedDetail.SQLMatchScore)
                            </span> *@
                        </h5>
                    </div>

                    <div class="code-comparison">
                        <div class="code-column">
                            <div class="code-header">
                                <h6>Expected SQL</h6>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyToClipboard(selectedDetail.ExpectedSQL)">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <pre class="code-block expected">@selectedDetail.ExpectedSQL</pre>
                        </div>

                        <div class="code-column">
                            <div class="code-header">
                                <h6>Generated SQL</h6>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyToClipboard(selectedDetail.GeneratedSQL)">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <pre class="code-block generated">@selectedDetail.GeneratedSQL</pre>
                        </div>
                    </div>
                </div>
            }
            else if (activeComparisonTab == "explanation")
            {
                <div class="comparison-content animate__animated animate__fadeIn">
                    <div class="comparison-header">
                        <h5>
                            Explanation Comparison
                            <span class="score-badge @GetScoreClass(selectedDetail.ExplanationMatchScore)">
                                Match Score: @FormatPercent(selectedDetail.ExplanationMatchScore)
                            </span>
                        </h5>
                    </div>

                    <div class="text-comparison">
                        <div class="text-column">
                            <div class="text-header">
                                <h6>Expected Explanation</h6>
                            </div>
                            <div class="text-block expected">@selectedDetail.ExpectedExplanation</div>
                        </div>

                        <div class="text-column">
                            <div class="text-header">
                                <h6>Generated Explanation</h6>
                            </div>
                            <div class="text-block generated">@selectedDetail.GeneratedExplanation</div>
                        </div>
                    </div>
                </div>
            }
            else if (activeComparisonTab == "data")
            {
                <div class="comparison-content animate__animated animate__fadeIn">
                    <div class="comparison-header">
                        <h5>
                            Data Results Comparison
                            <span class="score-badge @GetScoreClass(selectedDetail.DataMatchScore)">
                                Match Score: @FormatPercent(selectedDetail.DataMatchScore)
                            </span>
                        </h5>
                    </div>

                    <div class="dataset-meta">
                        <div class="meta-item">
                            <span class="meta-label">Expected Rows:</span>
                            <span class="meta-value">@selectedDetail.ExpectedRowCount</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Actual Rows:</span>
                            <span class="meta-value">@selectedDetail.ActualRowCount</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Result Status:</span>
                            <span class="meta-value">@selectedDetail.ResultMatchStatus</span>
                        </div>
                    </div>

                    @if (isLoadingDatasets)
                    {
                        <div class="loading-container">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Loading datasets...</p>
                        </div>
                    }
                    else if ((comparisonData?.Expected == null || !comparisonData.Expected.Any()) &&
                            (comparisonData?.Actual == null || !comparisonData.Actual.Any()))
                    {
                        <div class="empty-state">
                            <i class="fas fa-database fa-3x mb-3"></i>
                            <h4>No dataset comparison available</h4>
                            <p>The datasets could not be loaded or may be empty.</p>
                            <button class="btn btn-outline-primary mt-3" @onclick="() => LoadDatasetComparison(selectedDetail.DetailID)">
                                <i class="fas fa-sync-alt me-2"></i> Retry Loading
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="dataset-tabs">
                            <div class="tab @(activeDatasetTab == "expected" ? "active" : "")"
                                 @onclick='() => SetActiveDatasetTab("expected")'>
                                Expected Dataset
                            </div>
                            <div class="tab @(activeDatasetTab == "actual" ? "active" : "")"
                                 @onclick='() => SetActiveDatasetTab("actual")'>
                                Actual Dataset
                            </div>
                            <div class="tab @(activeDatasetTab == "diff" ? "active" : "")"
                                 @onclick='() => SetActiveDatasetTab("diff")'>
                                Differences
                            </div>
                        </div>

                        <div class="dataset-content">
                            @if (activeDatasetTab == "expected" && comparisonData.Expected != null)
                            {
                                <Components.TestDashboard.DatasetView Dataset="comparisonData.Expected" />
                            }
                            else if (activeDatasetTab == "actual" && comparisonData.Actual != null)
                            {
                                <Components.TestDashboard.DatasetView Dataset="comparisonData.Actual" />
                            }
                            else if (activeDatasetTab == "diff")
                            {
                                <Components.TestDashboard.DatasetDiffView Expected="comparisonData.Expected" Actual="comparisonData.Actual" />
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="fas fa-table fa-3x mb-3"></i>
                                    <h4>No data available</h4>
                                    <p>The selected dataset is not available.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-primary green" @onclick="CloseComparisonView">
                <i class="fas fa-check me-2"></i>Close
            </button>
        </div>
    </div>
}


