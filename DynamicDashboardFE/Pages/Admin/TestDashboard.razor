								OnClosed="CloseComparisonView" />
	} *@
	@if (showComparisonView && selectedDetail != null)
	{
		<DatasetComparisonView ComparisonResult="comparisonData"
							   IsVisible="showComparisonView"
							   IsLoading="isLoadingDatasets"
							   OnRefresh="() => LoadDatasetComparison(selectedDetail.DetailID)"
							   OnClose="CloseComparisonView" />
	}
</div>

@code {
	// Add this to the @code block to handle the clear button
	private void ClearJsonInput()
	{
		jsonTestCases = string.Empty;
	}

	// Note: Make sure the CopyToClipboard method is implemented in the codebehind
	private async Task CopyToClipboard(string text)
	{
		if (string.IsNullOrEmpty(text))
		{
			toastService.ShowWarning("No text available to copy.");
			return;
		}

		await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
		toastService.ShowSuccess("Copied to clipboard!");
	}
}