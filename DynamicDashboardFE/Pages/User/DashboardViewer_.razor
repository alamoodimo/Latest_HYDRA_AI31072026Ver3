@page "/dashboard/view/{DashboardId:int}"
@page "/dashboard/view"
@using DynamicDashboardCommon.Models
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>@dashboardTitle - Dashboard Viewer</PageTitle>

<div class="dashboard-viewer @themeClass">
    <!-- Top Navigation Bar -->
    <div class="viewer-header">
        <div class="header-left">
            <button class="btn-back" @onclick='() => NavigationManager.NavigateTo("/marketplace")'>
                <i class="fas fa-chevron-left"></i>
            </button>
            <div class="header-title-section">
                <h1 class="dashboard-title">@dashboardTitle</h1>
                <span class="dashboard-subtitle">@dashboardDescription</span>
            </div>
        </div>

        <div class="header-center">
            <div class="last-updated">
                <i class="fas fa-sync-alt @(isRefreshing ? "fa-spin" : "")"></i>
                <span>Last updated: @lastUpdated.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
        </div>

        <div class="header-right">
            <!-- Date Range Filter -->
            <div class="filter-group">
                <div class="date-range-picker">
                    <i class="fas fa-calendar-alt"></i>
                    <select @bind="selectedDateRange" class="date-select">
                        <option value="7d">Last 7 Days</option>
                        <option value="30d">Last 30 Days</option>
                        <option value="90d">Last 90 Days</option>
                        <option value="1y">This Year</option>
                        <option value="custom">Custom Range</option>
                    </select>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="btn-action" @onclick="RefreshDashboard" title="Refresh">
                    <i class="fas fa-sync-alt @(isRefreshing ? "fa-spin" : "")"></i>
                </button>
                <button class="btn-action" @onclick="ToggleFullscreen" title="Fullscreen">
                    <i class="fas @(isFullscreen ? "fa-compress" : "fa-expand")"></i>
                </button>
                <button class="btn-action" @onclick="ExportDashboard" title="Export">
                    <i class="fas fa-download"></i>
                </button>
                <button class="btn-action primary" @onclick="ShareDashboard">
                    <i class="fas fa-share-alt me-1"></i>
                    Share
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <div class="filter-chips">
            <div class="filter-chip active">
                <i class="fas fa-building"></i>
                <span>All Emirates</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-chip">
                <i class="fas fa-concierge-bell"></i>
                <span>All Services</span>
                <i class="fas fa-chevron-down"></i>
            </div>
            <div class="filter-chip">
                <i class="fas fa-user-check"></i>
                <span>All Status</span>
                <i class="fas fa-chevron-down"></i>
            </div>
        </div>
        <div class="filter-actions">
            <button class="btn-filter-action">
                <i class="fas fa-filter"></i>
                More Filters
            </button>
            <button class="btn-filter-action">
                <i class="fas fa-redo"></i>
                Reset
            </button>
        </div>
    </div>

    <!-- Dashboard Grid -->
    <div class="dashboard-grid">
        <!-- Row 1: KPI Cards -->
        <div class="grid-row kpi-row">
            @foreach (var kpi in kpiCards)
            {
                <div class="kpi-card @kpi.ColorClass animate-in" style="animation-delay: @(kpiCards.IndexOf(kpi) * 0.1)s">
                    <div class="kpi-icon-wrapper">
                        <div class="kpi-icon @kpi.ColorClass">
                            <i class="@kpi.Icon"></i>
                        </div>
                    </div>
                    <div class="kpi-content">
                        <span class="kpi-label">@kpi.Label</span>
                        <div class="kpi-value-row">
                            <span class="kpi-value">@kpi.Value</span>
                            <span class="kpi-trend @(kpi.TrendUp ? "trend-up" : "trend-down")">
                                <i class="fas @(kpi.TrendUp ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                @kpi.TrendValue
                            </span>
                        </div>
                        <span class="kpi-comparison">vs last period</span>
                    </div>
                    <div class="kpi-sparkline">
                        <svg viewBox="0 0 100 40" class="sparkline-svg">
                            <polyline fill="none" stroke="currentColor" stroke-width="2"
                                      points="@kpi.SparklinePoints" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        <!-- Row 2: Main Charts -->
        <div class="grid-row charts-row">
            <!-- Revenue Trend Chart -->
            <div class="chart-card large animate-in" style="animation-delay: 0.4s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Application Processing Trends</h3>
                        <span class="card-subtitle">Monthly application volume and processing rates</span>
                    </div>
                    <div class="card-actions">
                        <div class="chart-type-toggle">
                            <button class="toggle-btn @(revenueChartType == "area" ? "active" : "")"
                                    @onclick='() => revenueChartType = "area"'>
                                <i class="fas fa-chart-area"></i>
                            </button>
                            <button class="toggle-btn @(revenueChartType == "bar" ? "active" : "")"
                                    @onclick='() => revenueChartType = "bar"'>
                                <i class="fas fa-chart-bar"></i>
                            </button>
                            <button class="toggle-btn @(revenueChartType == "line" ? "active" : "")"
                                    @onclick='() => revenueChartType = "line"'>
                                <i class="fas fa-chart-line"></i>
                            </button>
                        </div>
                        <button class="btn-card-menu">
                            <i class="fas fa-ellipsis-v"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-container" id="revenueChart">
                        <!-- Chart Legend -->
                        <div class="chart-legend">
                            <div class="legend-item">
                                <span class="legend-color" style="background: #3B82F6"></span>
                                <span>Applications</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color" style="background: #10B981"></span>
                                <span>Processed</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-color" style="background: #F59E0B"></span>
                                <span>Last Year</span>
                            </div>
                        </div>
                        <!-- Mock Chart Visualization -->
                        <div class="mock-chart area-chart">
                            <div class="chart-grid">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <div class="grid-line"></div>
                                }
                            </div>
                            <svg class="chart-svg" viewBox="0 0 800 300" preserveAspectRatio="none">
                                <!-- Area fill -->
                                <defs>
                                    <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:0.3" />
                                        <stop offset="100%" style="stop-color:#3B82F6;stop-opacity:0.05" />
                                    </linearGradient>
                                    <linearGradient id="areaGradient2" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" style="stop-color:#10B981;stop-opacity:0.2" />
                                        <stop offset="100%" style="stop-color:#10B981;stop-opacity:0.02" />
                                    </linearGradient>
                                </defs>
                                <!-- Target Area -->
                                <path class="area-path" fill="url(#areaGradient2)"
                                      d="M0,180 L67,160 L133,150 L200,140 L267,130 L333,125 L400,120 L467,115 L533,110 L600,100 L667,95 L733,90 L800,85 L800,300 L0,300 Z" />
                                <!-- Revenue Area -->
                                <path class="area-path animated" fill="url(#areaGradient)"
                                      d="M0,200 L67,180 L133,190 L200,150 L267,140 L333,160 L400,120 L467,100 L533,110 L600,80 L667,60 L733,70 L800,40 L800,300 L0,300 Z" />
                                <!-- Revenue Line -->
                                <polyline class="chart-line animated" fill="none" stroke="#3B82F6" stroke-width="3"
                                          points="0,200 67,180 133,190 200,150 267,140 333,160 400,120 467,100 533,110 600,80 667,60 733,70 800,40" />
                                <!-- Target Line -->
                                <polyline class="chart-line" fill="none" stroke="#10B981" stroke-width="2" stroke-dasharray="5,5"
                                          points="0,180 67,160 133,150 200,140 267,130 333,125 400,120 467,115 533,110 600,100 667,95 733,90 800,85" />
                                <!-- Data Points -->
                                @{
                                    var points = new[] { 200, 180, 190, 150, 140, 160, 120, 100, 110, 80, 60, 70, 40 };
                                    var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                                }
                                @for (int i = 0; i < points.Length; i++)
                                {
                                    <circle class="data-point" cx="@(i * 67)" cy="@points[i]" r="5" fill="#3B82F6" />
                                }
                            </svg>
                            <div class="chart-x-axis">
                                @foreach (var month in months)
                                {
                                    <span>@month</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sales by Category -->
            <div class="chart-card medium animate-in" style="animation-delay: 0.5s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Applications by Service Type</h3>
                        <span class="card-subtitle">Service category distribution</span>
                    </div>
                    <button class="btn-card-menu">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="donut-chart-container">
                        <div class="donut-chart">
                            <svg viewBox="0 0 200 200" class="donut-svg">
                                <circle class="donut-ring" cx="100" cy="100" r="80" />
                                <circle class="donut-segment seg-1" cx="100" cy="100" r="80"
                                        stroke-dasharray="@(502.4 * 0.35) @(502.4 * 0.65)"
                                        stroke-dashoffset="125.6" />
                                <circle class="donut-segment seg-2" cx="100" cy="100" r="80"
                                        stroke-dasharray="@(502.4 * 0.25) @(502.4 * 0.75)"
                                        stroke-dashoffset="@(125.6 - 502.4 * 0.35)" />
                                <circle class="donut-segment seg-3" cx="100" cy="100" r="80"
                                        stroke-dasharray="@(502.4 * 0.20) @(502.4 * 0.80)"
                                        stroke-dashoffset="@(125.6 - 502.4 * 0.60)" />
                                <circle class="donut-segment seg-4" cx="100" cy="100" r="80"
                                        stroke-dasharray="@(502.4 * 0.12) @(502.4 * 0.88)"
                                        stroke-dashoffset="@(125.6 - 502.4 * 0.80)" />
                                <circle class="donut-segment seg-5" cx="100" cy="100" r="80"
                                        stroke-dasharray="@(502.4 * 0.08) @(502.4 * 0.92)"
                                        stroke-dashoffset="@(125.6 - 502.4 * 0.92)" />
                            </svg>
                            <div class="donut-center">
                                <span class="donut-total">284.7K</span>
                                <span class="donut-label">Total Applications</span>
                            </div>
                        </div>
                        <div class="donut-legend">
                            @foreach (var cat in categoryData)
                            {
                                <div class="legend-row">
                                    <div class="legend-info">
                                        <span class="legend-dot" style="background: @cat.Color"></span>
                                        <span class="legend-name">@cat.Name</span>
                                    </div>
                                    <div class="legend-values">
                                        <span class="legend-amount">@cat.Amount</span>
                                        <span class="legend-percent">@cat.Percent</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 3: Bar Chart + Table -->
        <div class="grid-row mixed-row">
            <!-- Top Products Bar Chart -->
            <div class="chart-card medium animate-in" style="animation-delay: 0.6s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Top Services by Volume</h3>
                        <span class="card-subtitle">Most requested services this period</span>
                    </div>
                    <button class="btn-card-menu">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="horizontal-bar-chart">
                        @foreach (var product in topProducts)
                        {
                            <div class="bar-row">
                                <div class="bar-label">
                                    <span class="product-rank">#@product.Rank</span>
                                    <span class="product-name">@product.Name</span>
                                </div>
                                <div class="bar-container">
                                    <div class="bar-fill" style="width: @product.Percentage%; background: @product.Color">
                                        <span class="bar-value">@product.Value</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Transactions Table -->
            <div class="chart-card large animate-in" style="animation-delay: 0.7s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Recent Applications</h3>
                        <span class="card-subtitle">Latest citizen service requests</span>
                    </div>
                    <div class="card-actions">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Search..." />
                        </div>
                        <button class="btn-card-action">
                            <i class="fas fa-download"></i>
                            Export
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="data-table-container">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="th-content">
                                            Order ID
                                            <i class="fas fa-sort"></i>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            Customer
                                            <i class="fas fa-sort"></i>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            Product
                                            <i class="fas fa-sort"></i>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            Amount
                                            <i class="fas fa-sort-down"></i>
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            Status
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            Date
                                            <i class="fas fa-sort"></i>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in recentTransactions)
                                {
                                    <tr>
                                        <td>
                                            <span class="order-id">@tx.OrderId</span>
                                        </td>
                                        <td>
                                            <div class="customer-cell">
                                                <div class="customer-avatar" style="background: @tx.AvatarColor">
                                                    @tx.CustomerInitials
                                                </div>
                                                <div class="customer-info">
                                                    <span class="customer-name">@tx.CustomerName</span>
                                                    <span class="customer-email">@tx.CustomerEmail</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@tx.Product</td>
                                        <td>
                                            <span class="amount">@tx.Amount</span>
                                        </td>
                                        <td>
                                            <span class="status-badge @tx.StatusClass">
                                                <i class="@tx.StatusIcon"></i>
                                                @tx.Status
                                            </span>
                                        </td>
                                        <td>
                                            <span class="date">@tx.Date</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="table-footer">
                        <span class="showing-text">Showing 1-10 of 284,739 applications</span>
                        <div class="pagination">
                            <button class="page-btn" disabled><i class="fas fa-chevron-left"></i></button>
                            <button class="page-btn active">1</button>
                            <button class="page-btn">2</button>
                            <button class="page-btn">3</button>
                            <span class="page-ellipsis">...</span>
                            <button class="page-btn">285</button>
                            <button class="page-btn"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: Regional Performance + Activity -->
        <div class="grid-row bottom-row">
            <!-- Regional Performance -->
            <div class="chart-card medium animate-in" style="animation-delay: 0.8s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Applications by Emirate</h3>
                        <span class="card-subtitle">Geographic distribution of requests</span>
                    </div>
                    <button class="btn-card-menu">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="regional-chart">
                        @foreach (var region in regionalData)
                        {
                            <div class="region-row">
                                <div class="region-info">
                                    <span class="region-flag">@region.Flag</span>
                                    <span class="region-name">@region.Name</span>
                                </div>
                                <div class="region-bar-container">
                                    <div class="region-bar">
                                        <div class="region-bar-fill" style="width: @region.Percentage%">
                                        </div>
                                    </div>
                                    <span class="region-value">@region.Value</span>
                                </div>
                                <span class="region-change @(region.ChangePositive ? "positive" : "negative")">
                                    <i class="fas @(region.ChangePositive ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                    @region.Change
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Sales Activity Timeline -->
            <div class="chart-card medium animate-in" style="animation-delay: 0.9s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">Staff Activity</h3>
                        <span class="card-subtitle">Recent officer activities</span>
                    </div>
                    <button class="btn-card-menu">
                        <i class="fas fa-ellipsis-v"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div class="activity-timeline">
                        @foreach (var activity in activityFeed)
                        {
                            <div class="activity-item">
                                <div class="activity-icon @activity.IconClass">
                                    <i class="@activity.Icon"></i>
                                </div>
                                <div class="activity-content">
                                    <p class="activity-text">
                                        <strong>@activity.User</strong> @activity.Action
                                    </p>
                                    <span class="activity-time">@activity.Time</span>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="btn-view-all">
                        View All Activity
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Performance Gauge -->
            <div class="chart-card small animate-in" style="animation-delay: 1.0s">
                <div class="card-header">
                    <div class="card-title-section">
                        <h3 class="card-title">SLA Compliance</h3>
                        <span class="card-subtitle">Q4 2024 Processing Goals</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="gauge-container">
                        <svg viewBox="0 0 200 120" class="gauge-svg">
                            <defs>
                                <linearGradient id="gaugeGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" style="stop-color:#EF4444" />
                                    <stop offset="50%" style="stop-color:#F59E0B" />
                                    <stop offset="100%" style="stop-color:#10B981" />
                                </linearGradient>
                            </defs>
                            <path class="gauge-bg" d="M20,100 A80,80 0 0,1 180,100" fill="none"
                                  stroke="#E5E7EB" stroke-width="20" stroke-linecap="round" />
                            <path class="gauge-fill" d="M20,100 A80,80 0 0,1 180,100" fill="none"
                                  stroke="url(#gaugeGradient)" stroke-width="20" stroke-linecap="round"
                                  stroke-dasharray="251.2" stroke-dashoffset="@(251.2 * (1 - 0.94))" />
                            <text x="100" y="95" text-anchor="middle" class="gauge-value">94%</text>
                            <text x="100" y="115" text-anchor="middle" class="gauge-label">SLA met this quarter</text>
                        </svg>
                        <div class="gauge-stats">
                            <div class="gauge-stat">
                                <span class="stat-value">267K</span>
                                <span class="stat-label">On-Time</span>
                            </div>
                            <div class="gauge-stat">
                                <span class="stat-value">284K</span>
                                <span class="stat-label">Total</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int DashboardId { get; set; }

    // Dashboard metadata
    private string dashboardTitle = "MOI Services Performance Dashboard";
    private string dashboardDescription = "Real-time insights into public services and citizen requests";
    private DateTime lastUpdated = DateTime.Now;
    private string themeClass = "";
    private string selectedDateRange = "30d";
    private string revenueChartType = "area";
    private bool isRefreshing = false;
    private bool isFullscreen = false;

    // KPI Cards Data
    private List<KpiCardData> kpiCards = new();

    // Category Data for Donut Chart
    private List<CategoryData> categoryData = new();

    // Top Products Data (Services)
    private List<ProductData> topProducts = new();

    // Recent Transactions (Applications)
    private List<TransactionData> recentTransactions = new();

    // Regional Data (Emirate Data)
    private List<RegionalData> regionalData = new();

    // Activity Feed
    private List<ActivityData> activityFeed = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadMockData();
    }

    private Task LoadMockData()
    {
        // KPI Cards - MOI Service Metrics
        kpiCards = new List<KpiCardData>
        {
            new KpiCardData
            {
                Label = "Total Applications",
                Value = "284,739",
                TrendValue = "+12.5%",
                TrendUp = true,
                Icon = "fas fa-file-alt",
                ColorClass = "kpi-blue",
                SparklinePoints = "0,35 15,30 30,32 45,25 60,20 75,22 90,15 100,10"
            },
            new KpiCardData
            {
                Label = "Processed Today",
                Value = "18,472",
                TrendValue = "+8.2%",
                TrendUp = true,
                Icon = "fas fa-check-double",
                ColorClass = "kpi-green",
                SparklinePoints = "0,30 15,28 30,35 45,25 60,30 75,20 90,18 100,12"
            },
            new KpiCardData
            {
                Label = "Avg Processing Time",
                Value = "2.4 hrs",
                TrendValue = "-15.3%",
                TrendUp = true,
                Icon = "fas fa-clock",
                ColorClass = "kpi-purple",
                SparklinePoints = "0,25 15,30 30,28 45,35 60,30 75,25 90,20 100,15"
            },
            new KpiCardData
            {
                Label = "Pending Approval",
                Value = "3,847",
                TrendValue = "-2.1%",
                TrendUp = true,
                Icon = "fas fa-hourglass-half",
                ColorClass = "kpi-amber",
                SparklinePoints = "0,20 15,18 30,22 45,25 60,28 75,30 90,32 100,35"
            },
            new KpiCardData
            {
                Label = "Satisfaction Rate",
                Value = "94.8%",
                TrendValue = "+3.2%",
                TrendUp = true,
                Icon = "fas fa-smile",
                ColorClass = "kpi-teal",
                SparklinePoints = "0,35 15,32 30,28 45,25 60,22 75,18 90,12 100,8"
            }
        };

        // Category Data for Donut Chart - Service Types
        categoryData = new List<CategoryData>
