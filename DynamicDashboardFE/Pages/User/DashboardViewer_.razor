    private async Task RefreshDashboard()
    {
        isRefreshing = true;
        StateHasChanged();

        await Task.Delay(1500); // Simulate refresh
        lastUpdated = DateTime.Now;

        isRefreshing = false;
        ToastService.ShowSuccess("Dashboard refreshed successfully!");
    }

    private async Task ToggleFullscreen()
    {
        isFullscreen = !isFullscreen;
        await JSRuntime.InvokeVoidAsync("dashboardViewer.toggleFullscreen", isFullscreen);
    }

